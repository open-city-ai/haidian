{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/haidian-ai/source_registry.schema.json",
  "title": "Public Data Source Registry",
  "type": "object",
  "required": [
    "schema_version",
    "updated_date",
    "sources"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "0.1.0"
    },
    "updated_date": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "source_id",
          "title",
          "publisher",
          "source_kind",
          "url",
          "published_date",
          "accessed_date",
          "file_type",
          "authority_level",
          "timeliness_level",
          "public_access_status",
          "license_summary",
          "review_status",
          "usable_for_formal",
          "allowed_uses",
          "prohibited_uses",
          "topics"
        ],
        "additionalProperties": false,
        "properties": {
          "source_id": {
            "type": "string",
            "pattern": "^[A-Z0-9][A-Z0-9_-]+$"
          },
          "title": {
            "type": "string",
            "minLength": 2
          },
          "publisher": {
            "type": "string",
            "minLength": 2
          },
          "source_kind": {
            "enum": [
              "official_announcement",
              "official_standard",
              "official_open_data",
              "official_news",
              "media_report",
              "cleared_user_document",
              "provisional_repository_data",
              "open_license_reference",
              "international_reference"
            ]
          },
          "url": {
            "type": "string",
            "minLength": 1
          },
          "published_date": {
            "type": [
              "string",
              "null"
            ]
          },
          "accessed_date": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
          },
          "file_type": {
            "enum": [
              "html",
              "markdown",
              "json",
              "geojson",
              "pdf",
              "docx",
              "csv",
              "webpage",
              "mixed"
            ]
          },
          "authority_level": {
            "enum": [
              "A0",
              "A1",
              "A2",
              "A3",
              "CLEARED_USER_DOCUMENT",
              "PROVISIONAL_REPOSITORY",
              "OPEN_LICENSE_REFERENCE"
            ]
          },
          "timeliness_level": {
            "enum": [
              "T0",
              "T1",
              "T2",
              "T3",
              "T4",
              "NA"
            ]
          },
          "public_access_status": {
            "enum": [
              "public_url",
              "public_local_snapshot",
              "cleared_for_repo",
              "provisional_repository",
              "restricted_or_unknown"
            ]
          },
          "license_summary": {
            "type": "string",
            "minLength": 5
          },
          "review_status": {
            "enum": [
              "approved",
              "provisional",
              "needs_review",
              "rejected"
            ]
          },
          "usable_for_formal": {
            "enum": [
              "yes",
              "background_only",
              "provisional_only",
              "no"
            ]
          },
          "allowed_uses": {
            "$ref": "#/$defs/nonEmptyStringArray"
          },
          "prohibited_uses": {
            "$ref": "#/$defs/nonEmptyStringArray"
          },
          "topics": {
            "$ref": "#/$defs/nonEmptyStringArray"
          },
          "local_paths": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "notes_zh": {
            "type": "string"
          }
        }
      }
    }
  },
  "$defs": {
    "nonEmptyStringArray": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  }
}
