{
  "schema_version": "0.1.0",
  "site_package_version": "0.1.0",
  "project_id": "centennial-jingzhang-ai-belt",
  "data_policy": {
    "must_use_real_public_or_user_provided_data": true,
    "must_trace_all_sources": true,
    "may_use_osm_for_bootstrap_base_layers": true,
    "osm_requires_odbl_attribution": true,
    "commercial_map_tiles_forbidden_as_submission_data": true,
    "internal_or_non_public_spatial_data_forbidden_unless_explicitly_provided_and_cleared": true
  },
  "geometry_policy": {
    "bootstrap_bbox_is_official_boundary": false,
    "bootstrap_bbox_usage": [
      "map_viewport",
      "public_data_discovery_extent",
      "rough context extraction"
    ],
    "final_design_accepts_provisional_boundary_until_official_available": true,
    "final_design_requires_exact_official_boundary_for_professional_scoring": true,
    "provisional_boundary_usage": [
      "temporary AI generation",
      "human-readable visualization",
      "non-statutory design discussion",
      "local self-check pass with formal-readiness warning"
    ],
    "provisional_boundary_forbidden_uses": [
      "official redline",
      "approval basis",
      "precise area calculation",
      "statutory planning control",
      "land ownership or engineering boundary"
    ],
    "generated_features_must_be_inside_official_boundary_when_available": true,
    "generated_features_must_be_inside_provisional_boundary_when_official_missing": true,
    "do_not_modify_locked_layers": true
  },
  "editable_layers": [
    "LAND_USE",
    "PARCEL",
    "BUILDING_FOOTPRINT",
    "ROAD_CENTERLINE",
    "ROAD_AREA",
    "GREEN_SPACE",
    "PUBLIC_SPACE",
    "PHASE",
    "AI_SERVICE_ZONE",
    "SCENARIO_NODE"
  ],
  "locked_layers": [
    "SITE_BOUNDARY",
    "EXISTING_PRIMARY_ROAD",
    "EXISTING_RAIL",
    "EXISTING_WATER",
    "HERITAGE_PROTECTION",
    "REGULATORY_CONTROL"
  ],
  "required_submission_layers": [
    "SITE_BOUNDARY",
    "KEY_AREA",
    "LAND_USE",
    "BUILDING_FOOTPRINT",
    "ROAD_CENTERLINE",
    "GREEN_SPACE",
    "PUBLIC_SPACE",
    "PHASE"
  ],
  "forbidden_claims": [
    "official approval",
    "approved regulatory plan",
    "final land ownership",
    "confirmed construction scale",
    "guaranteed implementation",
    "exact heritage control without source",
    "exact road redline without source"
  ]
}
