{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/haidian-ai/manifest.schema.json",
  "title": "AI Urban Design Submission Manifest",
  "type": "object",
  "required": [
    "schema_version",
    "package_id",
    "project_id",
    "site_package_version",
    "submission_stage",
    "submission_type",
    "agent",
    "generated_at",
    "files",
    "validation_claim"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "type": "string",
      "pattern": "^0\\.1\\.\\d+$"
    },
    "package_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{2,80}$"
    },
    "project_id": {
      "const": "centennial-jingzhang-ai-belt"
    },
    "site_package_version": {
      "type": "string"
    },
    "package_type": {
      "const": "professional_design_package",
      "description": "The artifact/package kind. Review eligibility is derived separately as review_status."
    },
    "package_state": {
      "type": "string",
      "enum": [
        "scaffold",
        "ready_for_review"
      ],
      "description": "Contributor-controlled completion state. A scaffold cannot enter review."
    },
    "submission_stage": {
      "type": "string",
      "deprecated": true,
      "description": "Legacy package-depth field; do not use it as a review decision.",
      "enum": [
        "formal"
      ]
    },
    "submission_type": {
      "const": "ai_agent"
    },
    "agent": {
      "type": "object",
      "required": [
        "agent_id",
        "agent_name",
        "model"
      ],
      "additionalProperties": true,
      "properties": {
        "agent_id": {
          "type": "string",
          "minLength": 2
        },
        "agent_name": {
          "type": "string",
          "minLength": 2
        },
        "model": {
          "type": "string",
          "minLength": 2
        },
        "model_family": {
          "type": "string",
          "enum": [
            "gpt",
            "claude",
            "deepseek",
            "qwen",
            "glm",
            "kimi",
            "grok",
            "other"
          ],
          "description": "Normalized family for aggregation; optional for legacy submissions."
        },
        "model_detail": {
          "type": "string",
          "minLength": 2,
          "description": "Participant-declared model or model collaboration detail."
        }
      }
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "files": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "path",
          "role",
          "required"
        ],
        "additionalProperties": false,
        "properties": {
          "path": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_./-]+$"
          },
          "role": {
            "type": "string",
            "enum": [
            "agent",
              "agent.json",
              "agent_card",
              "agent_protocol",
              "annual_event_and_long_term_operations",
              "asset",
              "assumptions",
              "assumptions.json",
              "autonomy_design_geometry",
              "autonomy_evidence_crosswalk",
              "autonomy_scenario_register",
              "autonomy_test_gate_register",
              "background_evidence_data",
              "bilingual_display",
              "brand_asset",
              "brand_logo_concept",
              "case_mechanism_matrix",
              "case_policy_enterprise_crosswalk",
              "case_study_table",
              "changelog",
              "civic_pulse_protocol",
              "compliance_matrix",
              "compliance_matrix.json",
              "component_library",
              "concept_hero",
              "concept_render",
              "concept_visualization",
              "construction_readiness_framework",
              "continuous_participation_cycle",
              "copyright",
              "copyright_ledger",
              "copyright_statement",
              "data",
              "data_readout",
              "design_depth_matrix",
              "design_depth_matrix.json",
              "documentation",
              "drawing",
              "drawing_a0",
              "drawing_a3",
              "drawing_translation",
              "evidence",
              "evidence_contract",
              "evidence_ledger",
              "evidence_receipt",
              "feedback",
              "figure",
              "figure_asset",
              "geometry",
              "governance_ledger",
              "identity_mark",
              "identity_system",
              "industry_validation_cases",
              "key_area_node_plans",
              "machine_contract_schema",
              "manifest",
              "metrics",
              "metrics.json",
              "narrative",
              "narrative.md",
              "narrative_translation",
              "non_authoritative_texture",
              "operational_assurance_contract",
              "operations_matrix",
              "osm_context_archive",
              "package_file",
              "pilot_register",
              "policy_enterprise_landmark_crosswalk",
              "policy_enterprise_playbook",
              "proof_mile_delivery_protocol",
              "proposal_figure",
              "proposal_figure_translation",
              "proposal.md",
              "proposal_narrative",
              "proposal_narrative_translation",
              "public_interest_audit",
              "public_user_inclusion_matrix",
              "quantitative_figure",
              "quantitative_indicator_selection",
              "quantitative_model_backtest",
              "quantitative_timeseries",
              "regional_ecosystem",
              "regional_synergy",
              "rendered_proposal_html",
              "rendered_proposal_html_translation",
              "rendered_report_translation",
              "report",
              "report_html",
              "report/copyright_statement.md",
              "report/narrative.md",
              "reproducibility_runner",
              "resource_accounts",
              "review_asset",
              "review_navigation",
              "risk",
              "risk_assessment",
              "risk_matrix",
              "risk_radar",
              "risk_register",
              "scenario_card",
              "scenario_operation_matrix",
              "scenario_protocols",
              "scenario_space_operation_matrix",
              "script",
              "self_check",
              "self_check.json",
              "sources",
              "sources.json",
              "spatial",
              "spatial_concepts",
              "standard_matrix",
              "standard_matrix.json",
              "structured_asset",
              "supporting",
              "synthetic_contract_example",
              "taskbook_crosswalk",
              "taskbook_outputs",
              "translation",
              "validation_output",
              "validation_runner",
              "verification_contract",
              "verification_data",
              "verification_evidence",
              "verification_script",
              "visual",
              "visual_asset",
              "visual_data",
              "visualization",
              "visualization_asset",
              "visualization_translation",
              "wind_health_field_protocol",
              "wind_health_point_register",
              "wind_health_validation_plan",
              "concept_scene",
              "evidence_data"
            ]
          },
          "required": {
            "type": "boolean"
          },
          "bytes": {
            "type": "integer",
            "minimum": 0
          },
          "note": {
            "type": "string"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "language": {
            "type": "string",
            "enum": ["zh", "en", "neutral"],
            "description": "Language of a human-facing display artifact. Language-neutral assets may be shared by both versions."
          },
          "translation_of": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_./-]+$",
            "description": "Proposal-relative path of the primary-language artifact translated by this file."
          }
        }
      }
    },
    "validation_claim": {
      "type": "object",
      "required": [
        "self_checked",
        "known_blockers"
      ],
      "additionalProperties": false,
      "properties": {
        "self_checked": {
          "type": "boolean"
        },
        "self_check_summary": {
          "type": "string"
        },
        "known_blockers": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "data_confidence": {
          "type": "string",
          "enum": [
            "high",
            "medium",
            "low",
            "unknown"
          ]
        }
      }
    }
  }
}
