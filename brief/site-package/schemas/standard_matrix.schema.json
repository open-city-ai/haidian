{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/haidian-ai/standard_matrix.schema.json",
  "title": "Professional Standard Response Matrix",
  "type": "object",
  "required": [
    "schema_version",
    "standards"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "type": "string"
    },
    "standards": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "standard_id",
          "requirement_zh",
          "professional_dimension",
          "mandatory",
          "review_status",
          "proposal_sections",
          "drawing_refs",
          "geometry_refs",
          "metric_refs",
          "source_ids",
          "assumption_ids",
          "self_check_ids",
          "evidence_summary_zh"
        ],
        "additionalProperties": true,
        "properties": {
          "standard_id": {
            "type": "string",
            "minLength": 2
          },
          "requirement_zh": {
            "type": "string",
            "minLength": 2
          },
          "professional_dimension": {
            "type": "string",
            "minLength": 2
          },
          "mandatory": {
            "type": "boolean"
          },
          "review_status": {
            "enum": [
              "addressed",
              "data_gap",
              "not_applicable"
            ]
          },
          "proposal_sections": {
            "$ref": "#/$defs/nonEmptyStringArray"
          },
          "drawing_refs": {
            "$ref": "#/$defs/nonEmptyStringArray"
          },
          "geometry_refs": {
            "$ref": "#/$defs/nonEmptyStringArray"
          },
          "metric_refs": {
            "$ref": "#/$defs/nonEmptyStringArray"
          },
          "source_ids": {
            "$ref": "#/$defs/nonEmptyStringArray"
          },
          "assumption_ids": {
            "$ref": "#/$defs/nonEmptyStringArray"
          },
          "self_check_ids": {
            "$ref": "#/$defs/nonEmptyStringArray"
          },
          "evidence_summary_zh": {
            "type": "string",
            "minLength": 10
          }
        }
      }
    }
  },
  "$defs": {
    "nonEmptyStringArray": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  }
}
