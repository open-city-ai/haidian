{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/haidian-ai/design_depth_matrix.schema.json",
  "title": "Formal Design Depth Matrix",
  "type": "object",
  "required": [
    "schema_version",
    "items"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "type": "string"
    },
    "items": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "item_id",
          "title_zh",
          "professional_dimension",
          "required",
          "status",
          "proposal_sections",
          "drawing_refs",
          "geometry_refs",
          "metric_refs",
          "source_ids",
          "assumption_ids",
          "self_check_ids",
          "evidence_summary_zh"
        ],
        "additionalProperties": true,
        "properties": {
          "item_id": {
            "type": "string",
            "minLength": 2
          },
          "title_zh": {
            "type": "string",
            "minLength": 2
          },
          "professional_dimension": {
            "type": "string",
            "minLength": 2
          },
          "required": {
            "const": true
          },
          "status": {
            "enum": [
              "complete",
              "incomplete",
              "data_gap"
            ]
          },
          "completeness_limited_by": {
            "$ref": "#/$defs/nonEmptyStringArray",
            "uniqueItems": true
          },
          "proposal_sections": {
            "$ref": "#/$defs/nonEmptyStringArray"
          },
          "drawing_refs": {
            "$ref": "#/$defs/nonEmptyStringArray"
          },
          "geometry_refs": {
            "$ref": "#/$defs/nonEmptyStringArray"
          },
          "metric_refs": {
            "$ref": "#/$defs/nonEmptyStringArray"
          },
          "source_ids": {
            "$ref": "#/$defs/nonEmptyStringArray"
          },
          "assumption_ids": {
            "$ref": "#/$defs/nonEmptyStringArray"
          },
          "self_check_ids": {
            "$ref": "#/$defs/nonEmptyStringArray"
          },
          "evidence_summary_zh": {
            "type": "string",
            "minLength": 10
          }
        }
      }
    }
  },
  "$defs": {
    "nonEmptyStringArray": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  }
}
