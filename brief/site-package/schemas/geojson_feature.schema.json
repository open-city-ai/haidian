{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/haidian-ai/geojson_feature.schema.json",
  "title": "AI Urban Design GeoJSON FeatureCollection",
  "type": "object",
  "required": [
    "type",
    "features"
  ],
  "additionalProperties": true,
  "properties": {
    "type": {
      "const": "FeatureCollection"
    },
    "name": {
      "type": "string"
    },
    "features": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/feature"
      }
    }
  },
  "$defs": {
    "feature": {
      "type": "object",
      "required": [
        "type",
        "id",
        "properties",
        "geometry"
      ],
      "additionalProperties": true,
      "properties": {
        "type": {
          "const": "Feature"
        },
        "id": {
          "type": "string",
          "minLength": 2
        },
        "properties": {
          "type": "object",
          "required": [
            "id",
            "layer",
            "source_type",
            "confidence",
            "geometry_role"
          ],
          "additionalProperties": true,
          "properties": {
            "id": {
              "type": "string",
              "minLength": 2
            },
            "layer": {
              "type": "string"
            },
            "source_type": {
              "type": "string"
            },
            "confidence": {
              "type": "string"
            },
            "geometry_role": {
              "type": "string"
            },
            "area_sqm_declared": {
              "type": [
                "number",
                "null"
              ],
              "minimum": 0
            }
          }
        },
        "geometry": {
          "type": "object",
          "required": [
            "type",
            "coordinates"
          ],
          "additionalProperties": false,
          "properties": {
            "type": {
              "type": "string",
              "enum": [
                "Point",
                "LineString",
                "MultiLineString",
                "Polygon",
                "MultiPolygon"
              ]
            },
            "coordinates": {}
          }
        }
      }
    }
  }
}

