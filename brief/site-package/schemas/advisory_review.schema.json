{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/haidian-ai/advisory_review.schema.json",
  "title": "PR Comment Advisory Review Output",
  "type": "object",
  "required": [
    "schema_version",
    "submission_dir",
    "recommendation",
    "can_enter_formal_review",
    "mandatory_rejection",
    "gate_checks",
    "rubric_scores",
    "data_gaps_zh",
    "required_next_actions_zh",
    "pr_comment_markdown"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "0.1.0"
    },
    "submission_dir": {
      "type": "string",
      "minLength": 1
    },
    "recommendation": {
      "enum": [
        "reject",
        "request-changes",
        "intake-provisional",
        "formal-review-ready"
      ]
    },
    "can_enter_formal_review": {
      "type": "boolean"
    },
    "mandatory_rejection": {
      "type": "object",
      "required": [
        "result",
        "hits",
        "notes_zh"
      ],
      "additionalProperties": false,
      "properties": {
        "result": {
          "enum": [
            "pass",
            "fail"
          ]
        },
        "hits": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "notes_zh": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "gate_checks": {
      "type": "object",
      "required": [
        "deterministic_validation",
        "spatial_review",
        "visual_review",
        "professional_evidence_review"
      ],
      "additionalProperties": false,
      "properties": {
        "deterministic_validation": {
          "$ref": "#/$defs/gateStatus"
        },
        "spatial_review": {
          "$ref": "#/$defs/gateStatus"
        },
        "visual_review": {
          "$ref": "#/$defs/gateStatus"
        },
        "professional_evidence_review": {
          "$ref": "#/$defs/gateStatus"
        }
      }
    },
    "rubric_scores": {
      "type": "array",
      "minItems": 7,
      "maxItems": 7,
      "items": {
        "type": "object",
        "required": [
          "dimension_id",
          "dimension_zh",
          "score",
          "comment_zh",
          "evidence_refs",
          "risks_zh",
          "required_repairs_zh"
        ],
        "additionalProperties": false,
        "properties": {
          "dimension_id": {
            "enum": [
              "brief_alignment",
              "originality",
              "ai_planning_innovation",
              "implementation_feasibility",
              "public_interest_inclusion",
              "risk_compliance",
              "expression_completeness"
            ]
          },
          "dimension_zh": {
            "type": "string",
            "minLength": 2
          },
          "score": {
            "type": "integer",
            "minimum": 0,
            "maximum": 5
          },
          "comment_zh": {
            "type": "string",
            "minLength": 10
          },
          "evidence_refs": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "risks_zh": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "required_repairs_zh": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "data_gaps_zh": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "required_next_actions_zh": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "pr_comment_markdown": {
      "type": "string",
      "minLength": 20
    }
  },
  "$defs": {
    "gateStatus": {
      "type": "object",
      "required": [
        "status",
        "summary_zh"
      ],
      "additionalProperties": false,
      "properties": {
        "status": {
          "enum": [
            "pass",
            "fail",
            "not_run"
          ]
        },
        "summary_zh": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
