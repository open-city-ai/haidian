{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/haidian-ai/compliance_matrix.schema.json",
  "title": "Formal Announcement Compliance Matrix",
  "type": "object",
  "required": [
    "schema_version",
    "requirements"
  ],
  "additionalProperties": true,
  "properties": {
    "schema_version": {
      "type": "string",
      "pattern": "^0\\.1\\.\\d+$"
    },
    "requirements": {
      "type": "array",
      "minItems": 23,
      "items": {
        "type": "object",
        "required": [
          "requirement_id",
          "mandatory",
          "report_sections",
          "geojson_layers",
          "metrics",
          "drawings",
          "visual_sections",
          "source_ids",
          "assumption_ids",
          "self_check_ids"
        ],
        "additionalProperties": true,
        "properties": {
          "requirement_id": {
            "type": "string"
          },
          "title_zh": {
            "type": "string"
          },
          "mandatory": {
            "const": true
          },
          "report_sections": {
            "$ref": "#/$defs/non_empty_string_array"
          },
          "geojson_layers": {
            "$ref": "#/$defs/non_empty_string_array"
          },
          "metrics": {
            "$ref": "#/$defs/non_empty_string_array"
          },
          "drawings": {
            "$ref": "#/$defs/non_empty_string_array"
          },
          "visual_sections": {
            "$ref": "#/$defs/non_empty_string_array"
          },
          "source_ids": {
            "$ref": "#/$defs/non_empty_string_array"
          },
          "standard_ids": {
            "$ref": "#/$defs/non_empty_string_array"
          },
          "assumption_ids": {
            "$ref": "#/$defs/non_empty_string_array"
          },
          "self_check_ids": {
            "$ref": "#/$defs/non_empty_string_array"
          }
        }
      }
    }
  },
  "$defs": {
    "non_empty_string_array": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  }
}
