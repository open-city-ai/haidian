{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/haidian-ai/self_check.schema.json",
  "title": "AI Urban Design Self Check",
  "type": "object",
  "required": [
    "schema_version",
    "checks"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "type": "string",
      "pattern": "^0\\.1\\.\\d+$"
    },
    "checks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "check_id",
          "result",
          "severity",
          "target"
        ],
        "additionalProperties": true,
        "properties": {
          "check_id": {
            "type": "string",
            "pattern": "^[A-Z0-9_]+$"
          },
          "result": {
            "type": "string",
            "enum": [
              "pass",
              "fail",
              "unknown",
              "not_applicable"
            ]
          },
          "severity": {
            "type": "string",
            "enum": [
              "blocking",
              "major",
              "minor",
              "info"
            ]
          },
          "target": {
            "type": "string"
          },
          "message": {
            "type": "string"
          },
          "suggested_fix": {
            "type": "string"
          }
        }
      }
    },
    "ok": {
      "type": "boolean",
      "description": "Whether the persisted four-gate self-check passed. This is a contributor-controlled replay record, not an independent attestation; trusted CI or a maintainer rerun supplies provenance."
    },
    "submission_dir": {
      "type": "string"
    },
    "pr_author": {
      "type": "string"
    },
    "stage": {
      "type": "string"
    },
    "deterministic_validation": {
      "type": "object"
    },
    "spatial_review": {
      "type": "object"
    },
    "visual_review": {
      "type": "object"
    },
    "professional_review": {
      "type": "object"
    },
    "spatial_issue_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "visual_issue_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "professional_issue_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "missing_review_dependencies": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "can_enter_formal_review": {
      "type": "boolean"
    },
    "package_type": {
      "type": "string"
    },
    "review_status": {
      "type": "string"
    },
    "next_actions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
