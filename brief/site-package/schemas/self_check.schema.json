{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/haidian-ai/self_check.schema.json",
  "title": "AI Urban Design Self Check",
  "type": "object",
  "required": [
    "schema_version",
    "checks"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "type": "string",
      "pattern": "^0\\.1\\.\\d+$"
    },
    "checks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "check_id",
          "result",
          "severity",
          "target"
        ],
        "additionalProperties": true,
        "properties": {
          "check_id": {
            "type": "string",
            "pattern": "^[A-Z0-9_]+$"
          },
          "result": {
            "type": "string",
            "enum": [
              "pass",
              "fail",
              "unknown",
              "not_applicable"
            ]
          },
          "severity": {
            "type": "string",
            "enum": [
              "blocking",
              "major",
              "minor",
              "info"
            ]
          },
          "target": {
            "type": "string"
          },
          "message": {
            "type": "string"
          },
          "suggested_fix": {
            "type": "string"
          }
        }
      }
    }
  }
}

