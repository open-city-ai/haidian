{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/haidian-ai/self_check.schema.json",
  "title": "AI Urban Design Self Check",
  "type": "object",
  "required": [
    "schema_version",
    "checks"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "type": "string",
      "pattern": "^0\\.1\\.\\d+$"
    },
    "checks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "check_id",
          "result",
          "severity",
          "target"
        ],
        "additionalProperties": true,
        "properties": {
          "check_id": {
            "type": "string",
            "pattern": "^[A-Z0-9_]+$"
          },
          "result": {
            "type": "string",
            "enum": [
              "pass",
              "fail",
              "unknown",
              "not_applicable"
            ]
          },
          "severity": {
            "type": "string",
            "enum": [
              "blocking",
              "major",
              "minor",
              "info"
            ]
          },
          "target": {
            "type": "string"
          },
          "message": {
            "type": "string"
          },
          "suggested_fix": {
            "type": "string"
          }
        }
      }
    },
    "package_state": {
      "type": "string",
      "minLength": 1
    },
    "content_review_eligible": {
      "type": "boolean"
    },
    "professional_scoring_eligible": {
      "type": "boolean"
    },
    "professional_scoring_blocked_by": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "official_site_boundary",
          "official_key_areas"
        ]
      },
      "uniqueItems": true
    },
    "can_enter_formal_review": {
      "type": "boolean",
      "description": "Legacy alias for content_review_eligible. It does not authorize formal professional scoring."
    },
    "content_review_status": {
      "type": "string",
      "enum": [
        "content-review-ready",
        "revision-requested"
      ]
    },
    "review_status": {
      "type": "string",
      "enum": [
        "formal-review-ready",
        "revision-requested"
      ],
      "description": "Legacy status; formal-review-ready means content-review readiness only."
    }
  }
}
