{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/haidian-ai/metrics.schema.json",
  "title": "AI Urban Design Metrics",
  "type": "object",
  "required": [
    "schema_version",
    "units",
    "metrics"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "type": "string",
      "pattern": "^0\\.1\\.\\d+$"
    },
    "units": {
      "type": "object",
      "required": [
        "length",
        "area"
      ],
      "additionalProperties": false,
      "properties": {
        "length": {
          "const": "m"
        },
        "area": {
          "const": "sqm"
        }
      }
    },
    "metrics": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "$ref": "#/$defs/metric"
      }
    }
  },
  "$defs": {
    "metric": {
      "type": "object",
      "required": [
        "status",
        "value",
        "unit",
        "source_files",
        "formula",
        "confidence",
        "assumptions"
      ],
      "additionalProperties": true,
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "known",
            "unknown",
            "not_applicable"
          ]
        },
        "value": {
          "type": [
            "number",
            "null"
          ]
        },
        "unit": {
          "type": "string",
          "enum": [
            "sqm",
            "m",
            "ratio",
            "count",
            "index",
            "none"
          ]
        },
        "source_files": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "formula": {
          "type": "string"
        },
        "confidence": {
          "type": "string",
          "enum": [
            "high",
            "medium",
            "low",
            "unknown"
          ]
        },
        "assumptions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "reason": {
          "type": "string"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "unknown"
              }
            }
          },
          "then": {
            "required": [
              "reason"
            ],
            "properties": {
              "value": {
                "type": "null"
              }
            }
          }
        }
      ]
    }
  }
}

