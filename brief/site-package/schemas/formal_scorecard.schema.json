{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/haidian-ai/formal_scorecard.schema.json",
  "title": "Formal Professional Scoring Scorecard",
  "type": "object",
  "required": [
    "schema_version",
    "submission_dir",
    "scoring_status",
    "eligibility_gate",
    "reviewer_panel",
    "dimensions",
    "total_weighted_score_100",
    "recommendation_after_scoring",
    "panel_notes_zh",
    "pr_comment_markdown"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "0.1.0"
    },
    "submission_dir": {
      "type": "string",
      "minLength": 1
    },
    "scoring_status": {
      "enum": [
        "blocked",
        "draft",
        "final"
      ]
    },
    "eligibility_gate": {
      "type": "object",
      "required": [
        "maintainer_recommendation",
        "can_enter_formal_review",
        "summary_zh"
      ],
      "additionalProperties": false,
      "properties": {
        "maintainer_recommendation": {
          "enum": [
            "reject",
            "request-changes",
            "intake-provisional",
            "formal-review-ready"
          ]
        },
        "can_enter_formal_review": {
          "type": "boolean"
        },
        "summary_zh": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "reviewer_panel": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "role_zh"
        ],
        "additionalProperties": false,
        "properties": {
          "role_zh": {
            "type": "string",
            "minLength": 1
          },
          "name_or_org": {
            "type": [
              "string",
              "null"
            ]
          },
          "notes_zh": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    },
    "dimensions": {
      "type": "array",
      "minItems": 7,
      "maxItems": 7,
      "items": {
        "type": "object",
        "required": [
          "dimension_id",
          "dimension_zh",
          "weight_percent",
          "score_0_to_5",
          "weighted_score_100",
          "score_reason_zh",
          "evidence_refs",
          "risks_zh",
          "panel_followups_zh"
        ],
        "additionalProperties": false,
        "properties": {
          "dimension_id": {
            "enum": [
              "brief_alignment",
              "originality",
              "ai_planning_innovation",
              "implementation_feasibility",
              "public_interest_inclusion",
              "risk_compliance",
              "expression_completeness"
            ]
          },
          "dimension_zh": {
            "type": "string",
            "minLength": 2
          },
          "weight_percent": {
            "type": "number",
            "minimum": 0,
            "maximum": 100
          },
          "score_0_to_5": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 0,
            "maximum": 5
          },
          "weighted_score_100": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 0,
            "maximum": 100
          },
          "score_reason_zh": {
            "type": "string"
          },
          "evidence_refs": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "risks_zh": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "panel_followups_zh": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "total_weighted_score_100": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0,
      "maximum": 100
    },
    "recommendation_after_scoring": {
      "type": [
        "string",
        "null"
      ],
      "enum": [
        "award-candidate",
        "reserve",
        "not-recommended",
        "needs-panel-discussion",
        null
      ]
    },
    "panel_notes_zh": {
      "type": "string"
    },
    "pr_comment_markdown": {
      "type": "string",
      "minLength": 20
    }
  }
}
