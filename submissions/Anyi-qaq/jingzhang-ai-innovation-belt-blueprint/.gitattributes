# Keep text files LF in the index so blob hashes match the manifest sha256
# values computed on any platform. Windows checkouts with core.autocrlf=true
# would otherwise commit CRLF-derived digests that fail CI's blob comparison.
*.md text eol=lf
*.json text eol=lf
*.geojson text eol=lf
*.html text eol=lf
*.css text eol=lf
*.js text eol=lf
*.csv text eol=lf
*.txt text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.gif binary
*.svg binary
*.pdf binary
