{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://open-city.ai/schemas/jingzhang-street-pass-1.0.json",
  "title": "Jing-Zhang Street Pass / 京张上街票",
  "description": "Conceptual, machine-readable handover record for an AI scenario moving from validation to translation and limited first use.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "pass_id",
    "scenario_id",
    "status",
    "spatial_refs",
    "gate_stamps",
    "public_rights",
    "data_boundary",
    "human_ownership",
    "operating_window",
    "exit_and_recovery",
    "evidence_refs"
  ],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "pass_id": {"type": "string", "minLength": 1},
    "scenario_id": {"type": "string", "minLength": 1},
    "status": {"enum": ["concept", "pending", "limited_trial", "paused", "retired"]},
    "spatial_refs": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "gate_stamps": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["gate", "place_role", "result", "human_owner_role", "evidence_refs"],
        "properties": {
          "gate": {"enum": ["PROVE", "TRANSLATE", "FIRST_USE"]},
          "place_role": {"type": "string"},
          "result": {"enum": ["pending", "pass", "fail", "expired"]},
          "human_owner_role": {"type": ["string", "null"]},
          "evidence_refs": {"type": "array", "items": {"type": "string"}}
        }
      }
    },
    "public_rights": {
      "type": "object",
      "additionalProperties": false,
      "required": ["know", "choose", "equivalent_service", "human_review", "correct_delete", "appeal", "exit_recover"],
      "properties": {
        "know": {"type": "boolean"},
        "choose": {"type": "boolean"},
        "equivalent_service": {"type": "boolean"},
        "human_review": {"type": "boolean"},
        "correct_delete": {"type": "boolean"},
        "appeal": {"type": "boolean"},
        "exit_recover": {"type": "boolean"}
      }
    },
    "data_boundary": {
      "type": "object",
      "required": ["purpose", "minimum_fields", "prohibited_fields", "retention", "deletion_route"],
      "additionalProperties": false,
      "properties": {
        "purpose": {"type": "string"},
        "minimum_fields": {"type": "array", "items": {"type": "string"}},
        "prohibited_fields": {"type": "array", "items": {"type": "string"}},
        "retention": {"type": "string"},
        "deletion_route": {"type": "string"}
      }
    },
    "human_ownership": {
      "type": "object",
      "required": ["accountable_role", "on_site_role", "review_roles", "pause_authority"],
      "additionalProperties": false,
      "properties": {
        "accountable_role": {"type": ["string", "null"]},
        "on_site_role": {"type": ["string", "null"]},
        "review_roles": {"type": "array", "items": {"type": "string"}},
        "pause_authority": {"type": "array", "items": {"type": "string"}}
      }
    },
    "operating_window": {
      "type": "object",
      "required": ["authorized", "start", "end", "status_display", "non_ai_path"],
      "additionalProperties": false,
      "properties": {
        "authorized": {"type": "boolean"},
        "start": {"type": ["string", "null"]},
        "end": {"type": ["string", "null"]},
        "status_display": {"type": "string"},
        "non_ai_path": {"type": "string"}
      }
    },
    "exit_and_recovery": {
      "type": "object",
      "required": ["stop_conditions", "recovery_owner_role", "restore_baseline_service", "public_notice"],
      "additionalProperties": false,
      "properties": {
        "stop_conditions": {"type": "array", "items": {"type": "string"}},
        "recovery_owner_role": {"type": ["string", "null"]},
        "restore_baseline_service": {"type": "boolean"},
        "public_notice": {"type": "boolean"}
      }
    },
    "evidence_refs": {"type": "array", "items": {"type": "string"}}
  }
}
