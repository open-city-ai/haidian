{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://haidian.open-city.ai/schemas/listening-receipt-1.2.json",
  "title": "倾听回执 1.2 / Listening Receipt 1.2",
  "description": "A machine-readable, auditable handoff record for one bounded urban pilot. It records evidence, authority, professional gates, operations, evaluation and exit; it is not an approval or certification.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "receipt_id",
    "schema_version",
    "pilot_id",
    "scenario_id",
    "record_status",
    "evidence_level",
    "problem_statement",
    "public_interest",
    "place",
    "authorisation",
    "system",
    "data_and_rights",
    "human_gate",
    "operations",
    "evaluation",
    "professional_handoff",
    "lifecycle",
    "event_log",
    "created_at",
    "updated_at"
  ],
  "properties": {
    "receipt_id": {"type": "string", "pattern": "^LR-[A-Z0-9-]{6,}$"},
    "schema_version": {"const": "1.2.0"},
    "pilot_id": {"enum": ["P1", "P2", "P3"]},
    "scenario_id": {"type": "string", "minLength": 2},
    "record_status": {"enum": ["synthetic_non_operational", "authorised_field_record"]},
    "evidence_level": {"$ref": "#/$defs/evidence_level"},
    "problem_statement": {"type": "string", "minLength": 20},
    "public_interest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["intended_value", "affected_groups", "distributional_test", "non_worsening_rule"],
      "properties": {
        "intended_value": {"type": "string"},
        "affected_groups": {"type": "array", "items": {"type": "string"}, "minItems": 1},
        "distributional_test": {"type": "string"},
        "non_worsening_rule": {"type": "string"}
      }
    },
    "place": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "geometry_refs", "precision_status", "site_verification_status"],
      "properties": {
        "name": {"type": "string"},
        "geometry_refs": {"type": "array", "items": {"type": "string"}, "minItems": 1},
        "precision_status": {"enum": ["provisional_rough", "official_verified"]},
        "site_verification_status": {"enum": ["not_started", "in_progress", "verified"]}
      }
    },
    "authorisation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "accountable_role_slot", "accountable_organisation", "authorisation_reference", "permit_dependencies"],
      "properties": {
        "status": {"enum": ["not_authorised", "conditional", "authorised"]},
        "accountable_role_slot": {"type": "string", "minLength": 3},
        "accountable_organisation": {"type": ["string", "null"]},
        "authorisation_reference": {"type": ["string", "null"]},
        "permit_dependencies": {"type": "array", "items": {"type": "string"}}
      }
    },
    "system": {
      "type": "object",
      "additionalProperties": false,
      "required": ["component", "version", "artifact_hash", "allowed_actions", "forbidden_actions", "abstention_rule", "human_takeover", "offline_behaviour"],
      "properties": {
        "component": {"type": "string"},
        "version": {"type": "string"},
        "artifact_hash": {"type": ["string", "null"]},
        "allowed_actions": {"type": "array", "items": {"type": "string"}},
        "forbidden_actions": {"type": "array", "items": {"type": "string"}, "minItems": 1},
        "abstention_rule": {"type": "string"},
        "human_takeover": {"type": "string"},
        "offline_behaviour": {"type": "string"}
      }
    },
    "data_and_rights": {
      "type": "object",
      "additionalProperties": false,
      "required": ["purpose", "minimum_fields", "prohibited_fields", "notice_and_choice", "retention", "deletion_verification", "content_rights", "accessibility_channels"],
      "properties": {
        "purpose": {"type": "string"},
        "minimum_fields": {"type": "array", "items": {"type": "string"}},
        "prohibited_fields": {"type": "array", "items": {"type": "string"}, "minItems": 1},
        "notice_and_choice": {"type": "string"},
        "retention": {"type": "string"},
        "deletion_verification": {"type": "string"},
        "content_rights": {"type": "string"},
        "accessibility_channels": {"type": "array", "items": {"type": "string"}, "minItems": 1}
      }
    },
    "human_gate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["proposer_role", "independent_reviewer_role", "decisions"],
      "properties": {
        "proposer_role": {"type": "string"},
        "independent_reviewer_role": {"type": "string"},
        "decisions": {
          "type": "array",
          "minItems": 4,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["gate_id", "decision", "decider_role", "signed_at", "evidence_refs", "decision_difference"],
            "properties": {
              "gate_id": {"enum": ["G1_PROFESSIONAL", "G2_PUBLIC_INTEREST", "G3_DATA_RIGHTS", "G4_OPERATIONS"]},
              "decision": {"enum": ["pending", "pass", "conditional", "fail", "pause"]},
              "decider_role": {"type": "string"},
              "signed_at": {"type": ["string", "null"], "format": "date-time"},
              "evidence_refs": {"type": "array", "items": {"type": "string"}},
              "decision_difference": {"type": "string"}
            }
          }
        }
      }
    },
    "operations": {
      "type": "object",
      "additionalProperties": false,
      "required": ["responsible_role_slots", "service_window", "contact_path", "on_call_rule", "maintenance_cycle", "spares_and_dependencies", "cost_status", "exit_owner_slot", "pause_authority_slots"],
      "properties": {
        "responsible_role_slots": {"type": "array", "items": {"type": "string"}, "minItems": 1},
        "service_window": {"type": "string"},
        "contact_path": {"type": "string"},
        "on_call_rule": {"type": "string"},
        "maintenance_cycle": {"type": "string"},
        "spares_and_dependencies": {"type": "array", "items": {"type": "string"}},
        "cost_status": {"enum": ["unknown", "conceptual_class", "verified"]},
        "exit_owner_slot": {"type": "string"},
        "pause_authority_slots": {"type": "array", "items": {"type": "string"}, "minItems": 1}
      }
    },
    "evaluation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["baseline_protocol_ref", "sample_frame", "metrics", "performance_results", "uncertainty_note", "review_cycle"],
      "properties": {
        "baseline_protocol_ref": {"type": "string"},
        "sample_frame": {"type": "string"},
        "metrics": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["metric_id", "definition", "baseline", "candidate_threshold", "result", "status"],
            "properties": {
              "metric_id": {"type": "string"},
              "definition": {"type": "string"},
              "baseline": {"type": ["number", "string", "null"]},
              "candidate_threshold": {"type": ["number", "string", "null"]},
              "result": {"type": ["number", "string", "null"]},
              "status": {"enum": ["awaiting_authorised_baseline", "baselined", "measured", "not_applicable"]}
            }
          }
        },
        "performance_results": {"type": ["object", "null"]},
        "uncertainty_note": {"type": "string"},
        "review_cycle": {"type": "string"}
      }
    },
    "professional_handoff": {
      "type": "object",
      "additionalProperties": false,
      "required": ["discipline_interfaces", "deliverables", "unresolved_items", "handoff_status"],
      "properties": {
        "discipline_interfaces": {"type": "array", "items": {"type": "string"}, "minItems": 1},
        "deliverables": {"type": "array", "items": {"type": "string"}, "minItems": 1},
        "unresolved_items": {"type": "array", "items": {"type": "string"}},
        "handoff_status": {"enum": ["not_ready", "ready_for_authorised_baseline", "ready_for_limited_trial", "closed"]}
      }
    },
    "lifecycle": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state", "transition_history"],
      "properties": {
        "state": {"$ref": "#/$defs/lifecycle_state"},
        "transition_history": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["from", "to", "at", "by_role", "evidence_refs"],
            "properties": {
              "from": {"type": ["string", "null"]},
              "to": {"$ref": "#/$defs/lifecycle_state"},
              "at": {"type": "string", "format": "date-time"},
              "by_role": {"type": "string"},
              "evidence_refs": {"type": "array", "items": {"type": "string"}}
            }
          }
        }
      }
    },
    "event_log": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["event_id", "event_type", "at", "reported_by_role", "evidence_refs", "resolution_status"],
        "properties": {
          "event_id": {"type": "string"},
          "event_type": {"enum": ["APPEAL", "INCIDENT", "WITHDRAWAL", "REPAIR", "DATA_DELETION"]},
          "at": {"type": "string", "format": "date-time"},
          "reported_by_role": {"type": "string"},
          "evidence_refs": {"type": "array", "items": {"type": "string"}},
          "resolution_status": {"enum": ["open", "verified", "resolved", "unresolved", "withdrawn"]}
        }
      }
    },
    "created_at": {"type": "string", "format": "date-time"},
    "updated_at": {"type": "string", "format": "date-time"}
  },
  "$defs": {
    "evidence_level": {"enum": ["E0_CLAIM", "E1_PUBLIC_SOURCE", "E2_REPRODUCIBLE_PACKAGE", "E3_PROTOCOL_FIELD_OBSERVATION", "E4_CO_SIGNED_VERIFICATION", "E5_LIMITED_PILOT_INDEPENDENT_REVIEW"]},
    "lifecycle_state": {"enum": ["PROPOSED", "BASELINED", "AUTHORISED", "LIMITED_TRIAL", "REVIEWED", "ADOPTED", "MODIFIED", "PAUSED", "EXITED"]}
  }
}
