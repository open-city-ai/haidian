{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://haidian.open-city.ai/schemas/listening-contract-1.2.json",
  "title": "倾听合约 1.2 / Listening Contract 1.2",
  "description": "A 14-dimension public checklist for AI-enabled and ordinary urban services. Each real run must additionally produce a Listening Receipt 1.2. This open proposal is not certification or administrative approval.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "purpose",
    "place_and_users",
    "trigger",
    "minimum_data",
    "consent_and_notice",
    "retention_and_deletion",
    "model_and_limits",
    "human_owner",
    "explanation",
    "appeal",
    "repair_sla",
    "non_ai_fallback",
    "public_value_metric",
    "stop_and_rollback"
  ],
  "properties": {
    "example_status": {"enum": ["synthetic_non_operational_example"]},
    "purpose": {"type": "string", "minLength": 10},
    "place_and_users": {
      "type": "object",
      "required": ["place", "intended_users", "excluded_or_at_risk_users"],
      "properties": {
        "place": {"type": "string"},
        "intended_users": {"type": "array", "items": {"type": "string"}, "minItems": 1},
        "excluded_or_at_risk_users": {"type": "array", "items": {"type": "string"}}
      }
    },
    "trigger": {"type": "string", "description": "How the service starts; user activation is preferred."},
    "minimum_data": {
      "type": "object",
      "required": ["inputs", "prohibited_inputs"],
      "properties": {
        "inputs": {"type": "array", "items": {"type": "string"}},
        "prohibited_inputs": {"type": "array", "items": {"type": "string"}}
      }
    },
    "consent_and_notice": {"type": "string"},
    "retention_and_deletion": {"type": "string"},
    "model_and_limits": {"type": "string"},
    "human_owner": {
      "type": "object",
      "required": ["role", "accountable_organisation", "authorisation_reference", "contact_path", "final_decision"],
      "properties": {
        "role": {"type": "string"},
        "accountable_organisation": {"type": ["string", "null"]},
        "authorisation_reference": {"type": ["string", "null"]},
        "contact_path": {"type": "string"},
        "final_decision": {"type": "string"}
      }
    },
    "explanation": {"type": "string"},
    "appeal": {"type": "string"},
    "repair_sla": {"type": "string"},
    "non_ai_fallback": {"type": "string"},
    "public_value_metric": {
      "type": "object",
      "required": ["measure", "baseline", "time_window", "negative_result"],
      "properties": {
        "measure": {"type": "string"},
        "baseline": {"type": "string"},
        "time_window": {"type": "string"},
        "negative_result": {"type": "string"}
      }
    },
    "stop_and_rollback": {
      "type": "object",
      "required": ["stop_conditions", "rollback_action", "retirement_owner"],
      "properties": {
        "stop_conditions": {"type": "array", "items": {"type": "string"}, "minItems": 1},
        "rollback_action": {"type": "string"},
        "retirement_owner": {"type": "string"}
      }
    },
    "state": {
      "type": "string",
      "enum": ["PROPOSED", "BASELINED", "AUTHORISED", "LIMITED_TRIAL", "REVIEWED", "ADOPTED", "MODIFIED", "PAUSED", "EXITED"]
    },
    "evidence_log": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["timestamp", "state", "accountable_role", "evidence"],
        "properties": {
          "timestamp": {"type": "string", "format": "date-time"},
          "state": {"$ref": "#/$defs/state"},
          "accountable_role": {"type": "string"},
          "evidence": {"type": "string"}
        }
      }
    }
  },
  "$defs": {
    "state": {
      "type": "string",
      "enum": ["PROPOSED", "BASELINED", "AUTHORISED", "LIMITED_TRIAL", "REVIEWED", "ADOPTED", "MODIFIED", "PAUSED", "EXITED"]
    }
  }
}
