  "d0_measurement_methods": [
    {
      "baseline_id": "D0-B01",
      "name_zh": "任务完成率",
      "name_en": "Task completion rate",
      "observation_start": "staffed_intake_accepts_one_eligible_task",
      "observation_end": "human_confirmed_referral_or_reasoned_refusal_receipt",
      "numerator": "eligible_tasks_with_human_confirmed_referral_or_reasoned_refusal_receipt",
      "denominator": "all_eligible_tasks_started",
      "formula": "numerator / denominator",
      "missingness_rule": "user_withdrawal_and_observer_interruption_reported_separately_and_never_relabelled_success",
      "reporting": "ratio_with_numerator_denominator_and_missing_count",
      "actual_sample_size": null,
      "actual_value": null,
      "status": "method_defined_actual_pending"
    },
    {
      "baseline_id": "D0-B02",
      "name_zh": "任务完成用时",
      "name_en": "Task completion time",
      "observation_start": "staffed_intake_accepts_one_eligible_task",
      "observation_end": "final_portable_receipt_is_explained",
      "numerator": null,
      "denominator": null,
      "formula": "elapsed_minutes_per_completed_or_reasoned_refusal_task",
      "missingness_rule": "user_requested_pause_is_reported_separately_and_raw_elapsed_time_is_retained",
      "reporting": "median_p90_range_and_missing_count",
      "actual_sample_size": null,
      "actual_value": null,
      "status": "method_defined_actual_pending"
    },
    {
      "baseline_id": "D0-B03",
      "name_zh": "人工接管时延",
      "name_en": "Human-takeover delay",
      "observation_start": "takeover_requested_or_stop_trigger_fires",
      "observation_end": "named_on_duty_human_acknowledges_control",
      "numerator": null,
      "denominator": null,
      "formula": "acknowledgement_timestamp - request_or_trigger_timestamp",
      "missingness_rule": "unacknowledged_takeover_is_a_failure_not_a_missing_value",
      "reporting": "median_p90_maximum_and_unacknowledged_count",
      "actual_sample_size": null,
      "actual_value": null,
      "status": "method_defined_actual_pending"
    },
    {
      "baseline_id": "D0-B04",
      "name_zh": "申诉权利理解",
      "name_en": "Appeal-rights comprehension",
      "observation_start": "receipt_and_appeal_route_explained",
      "observation_end": "plain_language_teach_back_completed_or_declined",
      "numerator": "participants_who_can_identify_human_appeal_channel_and_next_step",
      "denominator": "participants_completing_the_non_coercive_teach_back",
      "formula": "numerator / denominator",
      "missingness_rule": "declined_teach_back_reported_separately_and_never_scored_as_understanding",
      "reporting": "ratio_with_numerator_denominator_declines_and_accessibility_format",
      "actual_sample_size": null,
      "actual_value": null,
      "status": "method_defined_actual_pending"
    },
    {
      "baseline_id": "D0-B05",
      "name_zh": "退出后人工服务恢复",
      "name_en": "Staffed-service restoration after exit",
      "observation_start": "exit_or_stop_instruction_issued",
      "observation_end": "staffed_service_data_disposition_and_asset_state_receipts_complete",
      "numerator": "exit_tests_with_verified_staffed_baseline_restoration_and_receipt",
      "denominator": "all_exit_tests_started",
      "formula": "numerator / denominator",
      "missingness_rule": "incomplete_restoration_is_a_failure_not_a_missing_value",
      "reporting": "ratio_elapsed_time_open_cases_and_unrestored_items",
      "actual_sample_size": null,
      "actual_value": null,
      "status": "method_defined_actual_pending"
    },
    {
      "baseline_id": "D0-B06",
      "name_zh": "无手机及无障碍服务可达",
      "name_en": "No-phone and accessible service reachability",
      "observation_start": "participant_selects_no_phone_no_account_or_accommodation_route",
      "observation_end": "human_confirmed_referral_reasoned_refusal_or_documented_barrier",
      "numerator": "attempts_completed_with_equivalent_service_or_reasoned_refusal_without_phone_or_account",
      "denominator": "all_no_phone_no_account_or_accommodation_attempts",
      "formula": "numerator / denominator",
      "missingness_rule": "documented_accessibility_barrier_is_a_failure_and_is_never_removed_from_denominator",
      "reporting": "ratio_with_route_type_accommodation_barriers_and_non_identifying_breakdown",
      "actual_sample_size": null,
      "actual_value": null,
      "status": "method_defined_actual_pending"
    }
