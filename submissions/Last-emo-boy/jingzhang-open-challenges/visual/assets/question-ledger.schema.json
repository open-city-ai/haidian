{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:open-city-ai:jingzhang-open-challenges:question-ledger:1.0",
  "title": "京张开放题账本 / Jing-Zhang Open Challenge Ledger",
  "description": "用于公开记录城市问题、责任主体、验证门与退出条件的只读交换格式；不是审批、采购或正式规划文件。",
  "$comment": "Schema 固定校验 12 组 Q/SCN/card 映射与 G0 状态组合；trace_refs 的跨文件存在性仍须对 sources.json、assumptions.json 和 geometry/*.geojson 执行包级检查。",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "proposal_id",
    "status_as_of",
    "status_basis",
    "status_note_zh",
    "status_note_en",
    "questions"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "proposal_id": {
      "const": "jingzhang-open-challenges"
    },
    "status_as_of": {
      "type": "string",
      "format": "date"
    },
    "status_basis": {
      "const": "concept_design_fixture"
    },
    "status_note_zh": {
      "type": "string",
      "minLength": 12
    },
    "status_note_en": {
      "type": "string",
      "minLength": 12
    },
    "questions": {
      "type": "array",
      "minItems": 12,
      "maxItems": 12,
      "prefixItems": [
        {"$ref": "#/$defs/q001"},
        {"$ref": "#/$defs/q002"},
        {"$ref": "#/$defs/q003"},
        {"$ref": "#/$defs/q004"},
        {"$ref": "#/$defs/q005"},
        {"$ref": "#/$defs/q006"},
        {"$ref": "#/$defs/q007"},
        {"$ref": "#/$defs/q008"},
        {"$ref": "#/$defs/q009"},
        {"$ref": "#/$defs/q010"},
        {"$ref": "#/$defs/q011"},
        {"$ref": "#/$defs/q012"}
      ],
      "items": false
    }
  },
  "$defs": {
    "localizedText": {
      "type": "object",
      "additionalProperties": false,
      "required": ["zh", "en"],
      "properties": {
        "zh": {"type": "string", "minLength": 2},
        "en": {"type": "string", "minLength": 2}
      }
    },
    "question": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "question_id",
        "scenario_feature_id",
        "scenario_card_id",
        "title",
        "problem_owner",
        "public_beneficiaries",
        "rights_clearance_status",
        "lifecycle_status",
        "risk_level",
        "current_gate",
        "success_conditions",
        "stop_conditions",
        "human_owner_role",
        "public_receipt_status",
        "expiry_policy",
        "trace_refs"
      ],
      "properties": {
        "question_id": {
          "type": "string",
          "pattern": "^Q-[0-9]{3}$"
        },
        "scenario_feature_id": {
          "type": "string",
          "pattern": "^SCN-[0-9]{3}$"
        },
        "scenario_card_id": {
          "type": "string",
          "pattern": "^[TS][0-9]{2}$"
        },
        "title": {"$ref": "#/$defs/localizedText"},
        "problem_owner": {"$ref": "#/$defs/localizedText"},
        "public_beneficiaries": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/localizedText"}
        },
        "rights_clearance_status": {
          "enum": [
            "unreviewed",
            "cleared_for_offline_research",
            "cleared_for_limited_test",
            "blocked"
          ]
        },
        "lifecycle_status": {
          "enum": [
            "candidate",
            "pilot",
            "public_service",
            "paused",
            "retired"
          ]
        },
        "risk_level": {
          "enum": ["low", "medium", "high"]
        },
        "current_gate": {
          "enum": ["G0", "G1", "G2", "G3", "G4"]
        },
        "location_feature_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 3}
        },
        "success_conditions": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/localizedText"}
        },
        "stop_conditions": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/localizedText"}
        },
        "human_owner_role": {"$ref": "#/$defs/localizedText"},
        "public_receipt_status": {
          "enum": ["not_open", "collecting", "published", "closed"]
        },
        "expiry_policy": {"$ref": "#/$defs/localizedText"},
        "trace_refs": {
          "type": "object",
          "additionalProperties": false,
          "required": ["formal_source_ids", "context_source_ids", "assumption_ids", "feature_ids"],
          "properties": {
            "formal_source_ids": {
              "description": "Only sources whose stated allowed use directly supports the narrow claim.",
              "type": "array",
              "uniqueItems": true,
              "items": {"type": "string", "minLength": 3}
            },
            "context_source_ids": {
              "description": "Background-only policies, cases or community checks; never a statutory or site-control basis.",
              "type": "array",
              "uniqueItems": true,
              "items": {"type": "string", "minLength": 3}
            },
            "assumption_ids": {
              "type": "array",
              "uniqueItems": true,
              "items": {"type": "string", "minLength": 3}
            },
            "feature_ids": {
              "type": "array",
              "uniqueItems": true,
              "items": {"type": "string", "minLength": 3}
            }
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {"current_gate": {"const": "G0"}},
            "required": ["current_gate"]
          },
          "then": {
            "properties": {
              "rights_clearance_status": {"const": "unreviewed"},
              "lifecycle_status": {"const": "candidate"},
              "public_receipt_status": {"const": "not_open"}
            }
          }
        }
      ]
    },
    "q001": {
      "allOf": [{"$ref": "#/$defs/question"}, {"properties": {"question_id": {"const": "Q-001"}, "scenario_feature_id": {"const": "SCN-001"}, "scenario_card_id": {"const": "T01"}}}]
    },
    "q002": {
      "allOf": [{"$ref": "#/$defs/question"}, {"properties": {"question_id": {"const": "Q-002"}, "scenario_feature_id": {"const": "SCN-002"}, "scenario_card_id": {"const": "T02"}}}]
    },
    "q003": {
      "allOf": [{"$ref": "#/$defs/question"}, {"properties": {"question_id": {"const": "Q-003"}, "scenario_feature_id": {"const": "SCN-003"}, "scenario_card_id": {"const": "T03"}}}]
    },
    "q004": {
      "allOf": [{"$ref": "#/$defs/question"}, {"properties": {"question_id": {"const": "Q-004"}, "scenario_feature_id": {"const": "SCN-004"}, "scenario_card_id": {"const": "S04"}}}]
    },
    "q005": {
      "allOf": [{"$ref": "#/$defs/question"}, {"properties": {"question_id": {"const": "Q-005"}, "scenario_feature_id": {"const": "SCN-005"}, "scenario_card_id": {"const": "S05"}}}]
    },
    "q006": {
      "allOf": [{"$ref": "#/$defs/question"}, {"properties": {"question_id": {"const": "Q-006"}, "scenario_feature_id": {"const": "SCN-006"}, "scenario_card_id": {"const": "S06"}}}]
    },
    "q007": {
      "allOf": [{"$ref": "#/$defs/question"}, {"properties": {"question_id": {"const": "Q-007"}, "scenario_feature_id": {"const": "SCN-007"}, "scenario_card_id": {"const": "S07"}}}]
    },
    "q008": {
      "allOf": [{"$ref": "#/$defs/question"}, {"properties": {"question_id": {"const": "Q-008"}, "scenario_feature_id": {"const": "SCN-008"}, "scenario_card_id": {"const": "S08"}}}]
    },
    "q009": {
      "allOf": [{"$ref": "#/$defs/question"}, {"properties": {"question_id": {"const": "Q-009"}, "scenario_feature_id": {"const": "SCN-009"}, "scenario_card_id": {"const": "S09"}}}]
    },
    "q010": {
      "allOf": [{"$ref": "#/$defs/question"}, {"properties": {"question_id": {"const": "Q-010"}, "scenario_feature_id": {"const": "SCN-010"}, "scenario_card_id": {"const": "S10"}}}]
    },
    "q011": {
      "allOf": [{"$ref": "#/$defs/question"}, {"properties": {"question_id": {"const": "Q-011"}, "scenario_feature_id": {"const": "SCN-011"}, "scenario_card_id": {"const": "S11"}}}]
    },
    "q012": {
      "allOf": [{"$ref": "#/$defs/question"}, {"properties": {"question_id": {"const": "Q-012"}, "scenario_feature_id": {"const": "SCN-012"}, "scenario_card_id": {"const": "S12"}}}]
    }
  }
}
