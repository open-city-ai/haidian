{
  "schema_version": "1.0",
  "artifact_id": "DM-IC-180D",
  "status": "design_target",
  "boundary_notice": "This is a proposed delivery contract, not a government commitment, procurement result or approved budget.",
  "pilot_total_cost_band_cny": {"low": 7500000, "high": 13500000, "basis": "concept allowances for three reversible pilots, baseline work, accessibility review, operations and contingency"},
  "work_packages": [
    {"id": "WP0", "days": "0-30", "name": "Lock facts and rights", "outputs": ["official/provisional geometry register", "asset and operator map", "field baseline protocol", "rights and complaint map"], "gate": "G0 evidence completeness", "fallback": "remain at desktop study"},
    {"id": "WP1", "days": "31-60", "name": "Build the ordinary-service base", "outputs": ["step-free bypass", "paper and human service", "seating/shade/drinking water", "visible notices"], "gate": "G1 ordinary equivalence", "fallback": "open only ordinary services"},
    {"id": "WP2", "days": "61-90", "name": "Install bounded prototypes", "outputs": ["reversible consent-zone kit", "edge cabinet", "physical stop", "passport display and audit logger"], "gate": "G2 technical and accessibility drill", "fallback": "remove digital components within 48 hours"},
    {"id": "WP3", "days": "91-120", "name": "Run staffed test windows", "outputs": ["maximum 20 supervised windows", "positive/negative/near-miss log", "deletion receipts", "ordinary-route service comparison"], "gate": "G3 public-interest review", "fallback": "freeze further windows and restore ordinary mode"},
    {"id": "WP4", "days": "121-180", "name": "Decide and publish", "outputs": ["retain/revise/retire decision", "cost and benefit account", "complaint resolution report", "open pattern specification"], "gate": "G4 independent decision", "fallback": "retire prototype; archive only cleared public evidence"}
  ],
  "raci": [
    {"decision": "spatial release", "accountable": "site owner / authorized public-space authority", "responsible": "urban design and engineering team", "consulted": ["heritage", "fire", "transport", "accessibility", "community"], "informed": ["public", "maintainers"]},
    {"decision": "AI test release", "accountable": "named pilot operator", "responsible": "safety lead and on-site controller", "consulted": ["data protection", "cybersecurity", "accessibility", "independent reviewer"], "informed": ["site users", "complaint channel"]},
    {"decision": "scale, revise or retire", "accountable": "joint public-interest review panel", "responsible": "asset steward", "consulted": ["affected user panels", "operator", "professional reviewers"], "informed": ["public registry"]}
  ],
  "permit_and_fact_dependencies": [
    "official key-area polygons and ownership",
    "heritage status and intervention limits",
    "road, station, fire and emergency access conditions",
    "utilities, drainage, tree and soil survey",
    "accessibility field audit",
    "data protection impact assessment",
    "operator insurance, maintenance SLA and incident responsibility"
  ],
  "cost_rules": [
    "minimum 30 percent of first-stage spending goes to ordinary public-service and accessibility improvements",
    "maximum 25 percent goes to AI hardware before G3",
    "10 percent contingency is held until independent review",
    "a retired prototype must fund reinstatement and public record closure"
  ]
