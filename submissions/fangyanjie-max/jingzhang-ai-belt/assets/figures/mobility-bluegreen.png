<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 800 600" width="800" height="600">
  <rect width="800" height="600" fill="#0d1117"/>
  <text x="400" y="36" text-anchor="middle" font-family="sans-serif" font-size="20" font-weight="bold" fill="#e0e0ff">交通·轨道·蓝绿网络示意</text>
  <text x="400" y="56" text-anchor="middle" font-family="sans-serif" font-size="11" fill="#888aaa">（概念示意 · 不代表工程方案 · 供参考）</text>
  <!-- Site outline -->
  <polygon points="220,530 460,530 460,370 440,230 460,88 320,88 310,208 290,368 220,530"
    fill="none" stroke="#4488ff" stroke-width="1.5" stroke-dasharray="6,3"/>
  <!-- Green corridor -->
  <rect x="330" y="230" width="70" height="280" fill="#2d6a4f" opacity="0.5"/>
  <!-- Blue river -->
  <path d="M220,410 Q300,390 380,400 Q450,408 480,390" fill="none" stroke="#48cae4" stroke-width="4" opacity="0.7"/>
  <text x="500" y="395" font-family="sans-serif" font-size="10" fill="#48cae4">小月河</text>
  <!-- Metro lines -->
  <line x1="180" y1="490" x2="620" y2="490" stroke="#f77f00" stroke-width="5" opacity="0.8"/>
  <text x="400" y="510" text-anchor="middle" font-family="sans-serif" font-size="11" fill="#f77f00">地铁13号线 · 大钟寺站</text>
  <line x1="370" y1="100" x2="370" y2="550" stroke="#00b4d8" stroke-width="4" opacity="0.7" stroke-dasharray="12,4"/>
  <text x="645" y="300" font-family="sans-serif" font-size="10" fill="#00b4d8">南北AI</text>
  <text x="645" y="314" font-family="sans-serif" font-size="10" fill="#00b4d8">慢行轴</text>
  <line x1="180" y1="200" x2="620" y2="200" stroke="#7b2fbe" stroke-width="4" opacity="0.7"/>
  <text x="640" y="204" font-family="sans-serif" font-size="10" fill="#c77dff">北五环路</text>
  <!-- Nodes -->
  <circle cx="370" cy="490" r="12" fill="#f77f00"/>
  <text x="370" y="494" text-anchor="middle" font-family="sans-serif" font-size="9" fill="white">大钟寺</text>
  <circle cx="370" cy="320" r="12" fill="#00b4d8"/>
  <text x="370" y="324" text-anchor="middle" font-family="sans-serif" font-size="9" fill="white">五道口</text>
  <circle cx="370" cy="140" r="12" fill="#52b788"/>
  <text x="370" y="144" text-anchor="middle" font-family="sans-serif" font-size="9" fill="white">清河站</text>
  <!-- Legend -->
  <rect x="555" y="380" width="200" height="170" rx="4" fill="#0d0d1a" stroke="#333"/>
  <text x="655" y="400" text-anchor="middle" font-family="sans-serif" font-size="11" fill="#cccccc" font-weight="bold">图例</text>
  <line x1="570" y1="415" x2="594" y2="415" stroke="#f77f00" stroke-width="4"/>
  <text x="602" y="419" font-family="sans-serif" font-size="10" fill="#cccccc">地铁（参考线位）</text>
  <line x1="570" y1="432" x2="594" y2="432" stroke="#00b4d8" stroke-width="3" stroke-dasharray="6,3"/>
  <text x="602" y="436" font-family="sans-serif" font-size="10" fill="#cccccc">AI慢行廊道</text>
  <rect x="570" y="446" width="18" height="10" fill="#2d6a4f" opacity="0.6"/>
  <text x="596" y="455" font-family="sans-serif" font-size="10" fill="#cccccc">京张绿廊</text>
  <line x1="570" y1="465" x2="594" y2="465" stroke="#48cae4" stroke-width="3"/>
  <text x="602" y="469" font-family="sans-serif" font-size="10" fill="#cccccc">小月河蓝线</text>
  <circle cx="580" cy="481" r="6" fill="#00b4d8"/>
  <text x="596" y="485" font-family="sans-serif" font-size="10" fill="#cccccc">TOD节点</text>
  <text x="400" y="582" text-anchor="middle" font-family="sans-serif" font-size="10" fill="#555577">概念交通示意，不代表工程线位方案 | 轨道参考现有路线 | 供专业团队深化研究</text>
</svg>