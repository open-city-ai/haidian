{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Jing-Zhang Accession Review Protocol",
  "description": "Machine-readable review record for an AI service applying to enter the Jing-Zhang Natural History collection. Governs the 'distinguish clearly' step of the five-step lifecycle.",
  "type": "object",
  "required": ["protocol", "service_id", "applicant", "evidence_refs", "review_result", "reviewer_humans", "decided_by_human", "review_date"],
  "properties": {
    "protocol": { "const": "jingzhang-accession-review-v1" },
    "service_id": { "type": "string", "pattern": "^SC-[0-9]{2}$|^T-[0-9]{2}$" },
    "applicant": { "type": "string", "minLength": 1 },
    "evidence_refs": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
    "review_result": { "enum": ["approved", "rejected", "deferred"] },
    "veto_flags": {
      "type": "array",
      "items": { "enum": ["privacy_violation", "no_human_fallback", "fabricated_evidence"] }
    },
    "reviewer_humans": { "type": "integer", "minimum": 1 },
    "reviewer_machines": { "type": "integer", "minimum": 0 },
    "decided_by_human": { "const": true },
    "review_date": { "type": "string", "format": "date" },
    "note": { "type": "string" }
  },
  "additionalProperties": false
}
