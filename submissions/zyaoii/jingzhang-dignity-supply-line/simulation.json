        "synthetic": {
          "type": "boolean"
        },
        "point_id": {
          "type": "string"
        },
        "event_type": {
          "enum": [
            "COUNT",
            "LOW",
            "OUT",
            "DAMAGE",
            "EXPIRY",
            "RECALL",
            "RESTOCK",
            "CLOSE",
            "RECOVERY_VERIFY"
