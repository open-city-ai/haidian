            "OPEN_PM",
            "OPEN_EVENING",
            "CLOSED"
          ]
        },
        "actor_role": {
          "enum": [
            "counter",
            "restocker",
            "site_manager",
            "quality_role",
            "independent_checker"
          ]
        },
        "batch_ref": {
          "type": [
            "string",
            "null"
          ]
        },
        "aggregate_count": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "evidence_ref": {
          "type": "string"
        },
        "note": {
          "type": "string",
          "maxLength": 240
        }
      },
      "privacy_note": "The schema intentionally has no user identity, contact, health, cycle, image, cubicle, employer or trajectory field."
    },
