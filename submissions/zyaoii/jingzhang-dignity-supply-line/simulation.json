  "design_evidence": {
    "baseline_protocol": {
      "schema_version": "0.1.0",
      "question": "Does aggregate AI forecasting add public value beyond a two-bin system and deterministic reorder rule?",
      "non_ai_baseline": {
        "duration_days": 15,
        "mechanism": "two sealed bins, paper READY/LOW/OUT card, named daily count and fixed reorder point",
        "minimum_metrics": [
          "stockout_minutes_in_open_period",
          "expired_or_damaged_units",
          "wasted_units",
          "staff_minutes",
          "unsafe_release_count",
          "unresolved_status_age"
        ]
      },
      "blind_test": {
        "duration_days": 30,
        "inputs": [
          "point_id",
          "aggregate_time_band",
          "count",
          "batch_expiry_band",
          "restock_lead_time_band",
          "open_or_closed"
        ],
        "comparators": [
          "two_bin_manual",
          "deterministic_reorder",
          "aggregate_ai_forecast"
        ],
        "human_rule": "Counter/restocker does not see method label when assessing suggested reorder batches."
      },
      "adoption_gate": "AI proceeds only if it reduces stockout without increasing waste, unsafe release, privacy fields or staff minutes beyond an agreed tolerance.",
      "exit": "If no net improvement is demonstrated, remove AI and retain the non-AI service."
    },
    "case_library": {
      "schema_version": "0.1.0",
      "method_only": true,
      "cases": [
        {
          "case": "WHO menstrual health framing",
          "borrow": "products plus WASH/disposal and participation",
          "do_not_import": "a claim that any Beijing venue is already compliant"
        },
        {
          "case": "UNICEF MHH guidance",
          "borrow": "dignity, inclusion and programme evaluation",
          "do_not_import": "non-Chinese product or procurement rules"
        },
        {
          "case": "Open Food Facts",
          "borrow": "transparent provenance and explicit uncertainty",
          "do_not_import": "product database, brand endorsement or community certification"
        },
        {
          "case": "Snipe-IT",
          "borrow": "custody and status history",
          "do_not_import": "user assignment or personal consumption tracking"
        },
        {
          "case": "Open311",
          "borrow": "issue category, accountable role and status updates",
          "do_not_import": "foreign agency structure or SLA"
        },
        {
          "case": "ODK Collect",
          "borrow": "offline constrained object audit",
          "do_not_import": "photos or respondent identity"
        }
      ]
    },
    "cost_envelope": {
      "schema_version": "0.1.0",
      "currency": "CNY",
      "precision_policy": "No fabricated quotation or total. Obtain at least two comparable quotes for material items before a real pilot.",
      "cost_buckets": [
        {
          "bucket": "product_stock",
          "basis": "sealed compliant units × verified pilot buffer",
          "quote_required": true
        },
        {
          "bucket": "dry_storage_and_two_bin_dispenser",
          "basis": "reversible, cleanable, non-powered baseline",
          "quote_required": true
        },
        {
          "bucket": "paper_signage_and_accessibility",
          "basis": "bilingual/plain-language status and tactile/placement review",
          "quote_required": true
        },
        {
          "bucket": "staff_time",
          "basis": "count, restock, cleaning/disposal, quality escalation and recovery verification minutes",
          "quote_required": false
        },
        {
          "bucket": "training_and_drills",
          "basis": "batch/recall/privacy/offline tabletop sessions",
          "quote_required": false
        },
        {
          "bucket": "optional_local_software",
          "basis": "aggregate forecast only after G2; no cloud dependency",
          "quote_required": true
        },
        {
          "bucket": "insurance_legal_and_contingency",
          "basis": "operator review and locally agreed contingency",
          "quote_required": true
        },
        {
          "bucket": "exit_and_disposal",
          "basis": "remove module, handle remaining stock and delete prohibited data",
          "quote_required": true
        }
      ],
      "continue_rule": "Approve a monetary ceiling only after site/operator scope and baseline workload are known."
    },
    "event_receipt.schema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "title": "Dignity Supply Object Event",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "event_id",
        "synthetic",
        "point_id",
        "event_type",
        "time_band",
        "actor_role",
        "evidence_ref"
      ],
      "properties": {
