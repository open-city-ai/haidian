    "state_machine": {
      "schema_version": "0.1.0",
      "service": "dignity_supply_point",
      "authority_rule": "AI may propose; only named accountable human roles may verify, quarantine, replenish, reopen or close.",
      "states": [
        {
          "id": "UNKNOWN",
          "public_promise": "none",
          "entry": "new, expired or insufficient evidence"
        },
        {
          "id": "VERIFIED",
          "public_promise": "evidence prerequisites checked, not yet open",
          "entry": "human checklist and product record valid"
        },
        {
          "id": "READY",
          "public_promise": "anonymous emergency unit presently available",
          "entry": "human count, sealed in-date batch, storage and site prerequisites valid"
        },
        {
          "id": "LOW",
          "public_promise": "limited stock; manual reorder active",
          "entry": "count at or below agreed reorder point"
        },
        {
          "id": "OUT",
          "public_promise": "no unit promised",
          "entry": "count zero or count evidence missing during opening period"
        },
        {
          "id": "QUARANTINED",
          "public_promise": "do not use",
          "entry": "damage, expiry, traceability conflict or recall lead"
        },
        {
          "id": "CLOSED",
          "public_promise": "service unavailable",
          "entry": "site, water, privacy, cleaning/disposal or operator gate fails"
        },
        {
          "id": "RECOVERY_PENDING",
          "public_promise": "not ready until independent human verification",
          "entry": "replenishment or corrective work recorded"
        }
      ],
      "transitions": [
        {
          "from": "UNKNOWN",
          "to": "VERIFIED",
          "authority": "site_operator",
          "evidence": "signed prerequisite checklist"
        },
        {
          "from": "VERIFIED",
          "to": "READY",
          "authority": "designated_counter",
          "evidence": "batch, seal, expiry, count and time-band receipt"
        },
        {
          "from": "READY",
          "to": "LOW",
          "authority": "deterministic_rule_or_counter",
          "evidence": "aggregate count receipt"
        },
        {
          "from": [
            "READY",
            "LOW"
          ],
          "to": "OUT",
          "authority": "designated_counter",
          "evidence": "zero-count or expired-count receipt"
        },
        {
          "from": [
            "VERIFIED",
            "READY",
            "LOW",
            "OUT"
          ],
          "to": "QUARANTINED",
          "authority": "operator_or_supplier_quality_role",
          "evidence": "damage, expiry, traceability conflict or recall notice"
        },
        {
