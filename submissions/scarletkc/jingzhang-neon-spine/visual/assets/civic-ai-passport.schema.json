{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "civic-ai-passport.schema.json",
  "title": "Jingzhang Civic AI Passport",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "passport_id",
    "status",
    "service",
    "accountability",
    "data",
    "rights",
    "provenance"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "passport_id": {
      "type": "string",
      "minLength": 3
    },
    "status": {
      "const": "synthetic_tabletop_only"
    },
    "service": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scenario_id",
        "name_zh",
        "name_en",
        "ai_role",
        "non_ai_route",
        "accessible_route_verified"
      ],
      "properties": {
        "scenario_id": {
          "const": "T2"
        },
        "name_zh": {
          "type": "string"
        },
        "name_en": {
          "type": "string"
        },
        "ai_role": {
          "type": "string"
        },
        "non_ai_route": {
          "type": "string"
        },
        "accessible_route_verified": {
          "type": "boolean"
        }
      }
    },
    "accountability": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "accountable_role",
        "responsible_role",
        "onsite_steward_role",
        "human_checkpoint"
      ],
      "properties": {
        "accountable_role": {
          "type": "string"
        },
        "responsible_role": {
          "type": "string"
        },
        "onsite_steward_role": {
          "type": "string"
        },
        "human_checkpoint": {
          "type": "boolean"
        }
      }
    },
    "data": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "allowed_sources",
        "personal_data_default",
        "biometrics_default",
        "consent_status",
        "raw_feedback_records",
        "retention_days_max",
        "deletion_deadline_hours"
      ],
      "properties": {
        "allowed_sources": {
          "type": "array",
          "items": {
            "enum": [
              "public",
              "cleared",
              "synthetic"
            ]
          }
        },
        "personal_data_default": {
          "const": false
        },
        "biometrics_default": {
          "const": false
        },
        "consent_status": {
          "enum": [
            "not_required_no_personal_data",
            "granted",
            "withdrawn"
          ]
        },
        "raw_feedback_records": {
          "type": "integer",
          "minimum": 0
        },
        "retention_days_max": {
          "type": "integer",
          "minimum": 0,
          "maximum": 7
        },
        "deletion_deadline_hours": {
          "type": "integer",
          "minimum": 1,
          "maximum": 24
        }
      }
    },
    "rights": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "informed",
        "choice",
        "equivalent_service",
        "human_review",
        "correction_deletion",
        "appeal",
        "exit_restoration"
      ],
      "properties": {
        "informed": {
          "const": true
        },
        "choice": {
          "const": true
        },
        "equivalent_service": {
          "const": true
        },
        "human_review": {
          "const": true
        },
        "correction_deletion": {
          "const": true
        },
        "appeal": {
          "const": true
        },
        "exit_restoration": {
          "const": true
        }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_integrity",
        "claim_limit_visible"
      ],
      "properties": {
        "source_integrity": {
          "const": "verified"
        },
        "claim_limit_visible": {
          "const": true
        }
      }
    }
  }
}
