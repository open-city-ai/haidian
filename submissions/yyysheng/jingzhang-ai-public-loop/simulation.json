      "design_use": "作为潮汐运维和停车容量的压力倍数，不替代当前现场计数。"
    },
    {
      "id": "SIG-BEIJING-BIKE-2025",
      "source_id": "WEB-BIKE-CITY-2025",
      "observation": "2025年北京市互联网租赁自行车日均骑行量为311.64万人次，车辆日均周转率为3.67次。",
      "value": 3116400,
      "unit": "person_per_day_city_reference",
      "status": "background_reference",
      "design_use": "说明共享单车是城市级高频接驳系统，方案采用停车、电子围栏和调运闭环。"
    },
    {
      "id": "SIG-SUBWAY-SPACING",
      "source_id": "WEB-SUBWAY-SPACING-13",
      "observation": "北京地铁13号线大钟寺—知春路站间距约1206米，知春路—五道口站间距约1829米。",
      "value": [
        1206,
        1829
      ],
      "unit": "m",
      "status": "official_network_reference",
      "design_use": "把三处重点区之间的步行、骑行和公交接驳设置为连续层级，不虚构新轨道线位。"
    }
