{
  "schema_version": "0.1.0",
  "assumptions": [
    {
      "id": "ASM-PROVISIONAL-BOUNDARY",
      "statement_zh": "临时边界替代官方红线；所有面积与定位在官方几何公布后复算。",
      "category": "boundary",
      "affects_metrics": [
        "site_area_sqm",
        "key_area_zhongzhiyuan_sqm"
      ]
    },
    {
      "id": "ASM-AI-GENERATED-DESIGN",
      "statement_zh": "用地、建筑、绿地、公共空间、道路与分期均为 AI agent 生成的设计提案，非现状。",
      "category": "design",
      "affects_metrics": [
        "green_ratio",
        "public_space_ratio"
      ]
    },
    {
      "id": "ASM-POPULATION-LOAD",
      "statement_zh": "人口与就业岗位按公开量级估算，未做入户调查。",
      "category": "socio",
      "affects_metrics": [
        "building_footprint_area_sqm"
      ]
    },
    {
      "id": "ASM-MOBILITY-PATTERN",
      "statement_zh": "通勤与慢行动线基于打工人爸爸生活笔记推演，非流量观测。",
      "category": "mobility",
      "affects_metrics": [
        "site_area_sqm"
      ]
    },
    {
      "id": "ASM-GREEN-RATIO",
      "statement_zh": "绿地率与公共空间率随临时边界复算而更新。",
      "category": "environment",
      "affects_metrics": [
        "green_ratio",
        "public_space_ratio"
      ]
    },
    {
      "id": "ASM-HERITAGE-CORRIDOR",
      "statement_zh": "京张线性遗产走廊为城市风貌设计母题，边界以遗产资料粗略锚定。",
      "category": "heritage",
      "affects_metrics": [
        "site_area_sqm"
      ]
    },
    {
      "id": "ASM-SERVICE-RADIUS",
      "statement_zh": "公共服务按 5—10 分钟生活圈配置，半径为经验基准。",
      "category": "service",
      "affects_metrics": [
        "public_space_area_sqm"
      ]
    }
  ]
}