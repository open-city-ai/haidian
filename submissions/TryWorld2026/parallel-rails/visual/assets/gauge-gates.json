{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:parallel-rails:gauge-gates:0.1.0",
  "$comment": "Offline supporting asset for the Gauge Gates pilot decision gates described in proposal.md. Conceptual delivery framework only; not a construction drawing, statutory plan, procurement specification, cost estimate, or implementation approval.",
  "title": "Gauge Gates — pilot decision gates with evidence-ladder binding",
  "title_zh": "轨距门——试点决策门与证据梯绑定",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "gates",
    "evidence_ladder",
    "authority_boundary"
  ],
  "properties": {
    "schema_version": {
      "const": "0.1.0"
    },
    "gates": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "gate_id",
          "title_zh",
          "title_en",
          "pass_conditions",
          "min_evidence_level",
          "on_failure"
        ],
        "properties": {
          "gate_id": {
            "enum": [
              "G0",
              "G1",
              "G2",
              "G3"
            ]
          },
          "title_zh": {
            "type": "string"
          },
          "title_en": {
            "type": "string"
          },
          "pass_conditions": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "All conditions are verifiable. A gate failing any condition keeps the project on its current track: expand without overreaching."
          },
          "min_evidence_level": {
            "enum": [
              "E0_CONCEPT",
              "E1_PUBLIC_SOURCE",
              "E2_PACKAGE_RECOMPUTATION",
              "E3_ON_SITE_OBSERVATION",
              "E4_PROFESSIONAL_ENDORSEMENT",
              "E5_TIMEBOXED_PILOT_REVIEW"
            ],
            "description": "Lowest evidence level that may support passing this gate. A decision must never rely on evidence below its gate level."
          },
          "on_failure": {
            "type": "string",
            "description": "Handling when the gate is not passed."
          }
        }
      }
    },
    "evidence_ladder": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "levels",
        "unmeasured_are_assets"
      ],
      "properties": {
        "levels": {
          "type": "array",
          "items": {
            "enum": [
              "E0_CONCEPT",
              "E1_PUBLIC_SOURCE",
              "E2_PACKAGE_RECOMPUTATION",
              "E3_ON_SITE_OBSERVATION",
              "E4_PROFESSIONAL_ENDORSEMENT",
              "E5_TIMEBOXED_PILOT_REVIEW"
            ]
          },
          "description": "E0 concept narrative -> E1 public-source citations -> E2 in-package recomputation -> E3 on-site observation -> E4 professional endorsement -> E5 time-boxed pilot independent review. Each level supports only decisions at or below its grade."
        },
        "unmeasured_are_assets": {
          "type": "boolean",
          "const": true,
          "description": "Unmeasured fields (official polygon, ownership records, on-site surveys, heritage scopes, blue lines) are recorded as assets for recalculation, never hidden or overstated."
        }
      }
    },
    "authority_boundary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "is_construction_drawing",
        "is_statutory_plan",
        "is_procurement_specification",
        "is_cost_estimate",
        "is_implementation_approval",
        "geometry_or_quantity_added"
      ],
      "properties": {
        "is_construction_drawing": {
          "const": false
        },
        "is_statutory_plan": {
          "const": false
        },
        "is_procurement_specification": {
          "const": false
        },
        "is_cost_estimate": {
          "const": false
        },
        "is_implementation_approval": {
          "const": false
        },
        "geometry_or_quantity_added": {
          "const": false
        }
      }
    }
  },
  "examples": [
    {
      "schema_version": "0.1.0",
      "gates": [
        {
          "gate_id": "G0",
          "title_zh": "证据门",
          "title_en": "Evidence gate",
          "pass_conditions": [
            "dependent data in place (controls / existing baseline / tenure)",
            "citations registered in sources.json"
          ],
          "min_evidence_level": "E1_PUBLIC_SOURCE",
          "on_failure": "halt start; wait for data; no speculative construction"
        },
        {
          "gate_id": "G1",
          "title_zh": "权属门",
          "title_en": "Tenure gate",
          "pass_conditions": [
            "tenure and heritage scope confirmed",
            "affected-party consent mechanism started"
          ],
          "min_evidence_level": "E3_ON_SITE_OBSERVATION",
          "on_failure": "shift to interface-opening / research actions; no physical retrofitting"
        },
        {
          "gate_id": "G2",
          "title_zh": "试点门",
          "title_en": "Pilot gate",
          "pass_conditions": [
            "pilot scope and duration locked (~90-day conceptual window)",
            "non-AI control baseline established"
          ],
          "min_evidence_level": "E2_PACKAGE_RECOMPUTATION",
          "on_failure": "pilot not scaled; recalibrate after review"
        },
        {
          "gate_id": "G3",
          "title_zh": "常态门",
          "title_en": "Steady-state gate",
          "pass_conditions": [
            "pilot SLO met",
            "human-review records public",
            "exit / rollback drill passed"
          ],
          "min_evidence_level": "E5_TIMEBOXED_PILOT_REVIEW",
          "on_failure": "remain at pilot or fall back; no steady-state operation"
        }
      ],
      "evidence_ladder": {
        "levels": [
          "E0_CONCEPT",
          "E1_PUBLIC_SOURCE",
          "E2_PACKAGE_RECOMPUTATION",
          "E3_ON_SITE_OBSERVATION",
          "E4_PROFESSIONAL_ENDORSEMENT",
          "E5_TIMEBOXED_PILOT_REVIEW"
        ],
        "unmeasured_are_assets": true
      },
      "authority_boundary": {
        "is_construction_drawing": false,
        "is_statutory_plan": false,
        "is_procurement_specification": false,
        "is_cost_estimate": false,
        "is_implementation_approval": false,
        "geometry_or_quantity_added": false
      }
    }
  ]
}
