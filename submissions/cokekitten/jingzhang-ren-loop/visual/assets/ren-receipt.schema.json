{
 "$schema": "http://json-schema.org/draft-07/schema#",
 "$id": "ren-receipt.schema.json",
 "title": "折返凭证 Ren Receipt",
 "description": "人字形回路的最小试点执行凭证:任何 AI 场景在本带落地,必须走完『前行(问题→测试)+折返(证据→反馈/回滚)』十段链条并留下可核验记录。本 schema 只约束记录结构,不构成任何机构授权或实施承诺。",
 "type": "object",
 "additionalProperties": false,
 "required": ["receipt_id", "scenario_id", "run_status", "stages", "performance_results", "responsible_parties", "not_proven", "disclaimer"],
 "properties": {
  "receipt_id": {"type": "string", "pattern": "^RR-[A-Z0-9-]{3,40}$"},
  "scenario_id": {"type": "string", "pattern": "^S(0[1-9]|1[0-2])$"},
  "run_status": {"type": "string", "enum": ["not_run", "tabletop_only", "authorized_pilot", "suspended", "retired"], "description": "not_run=未获授权未运行;tabletop_only=仅桌面演练;authorized_pilot=已获属地授权的试点;suspended=红态暂停;retired=退出并完成回滚"},
  "performance_results": {"type": ["object", "null"], "description": "真实运行效果。run_status 为 not_run 或 tabletop_only 时必须为 null——桌面演练不产生可主张的运行效果。"},
  "responsible_parties": {
   "type": "object", "additionalProperties": false,
   "required": ["operator", "human_gate_owner", "data_steward"],
   "properties": {
    "operator": {"type": "string", "minLength": 2, "description": "运营主体角色(只定义角色,不虚构机构)"},
    "human_gate_owner": {"type": "string", "minLength": 2},
    "data_steward": {"type": "string", "minLength": 2}
   }
  },
  "stages": {
   "type": "array", "minItems": 10, "maxItems": 10,
   "items": {
    "type": "object", "additionalProperties": false,
    "required": ["stage", "status", "summary"],
    "properties": {
     "stage": {"type": "string", "enum": ["problem", "site", "data_scope", "authorization", "human_gate", "test_plan", "evidence", "adopt_or_reject", "feedback", "rollback"]},
     "status": {"type": "string", "enum": ["complete", "pending", "not_run", "not_applicable"]},
     "summary": {"type": "string", "minLength": 8},
     "hard_stop_conditions": {"type": "array", "items": {"type": "string", "minLength": 4}},
     "non_ai_fallback": {"type": "string", "minLength": 4, "description": "该环节失效时的非 AI 替代路径"}
    }
   }
  },
  "not_proven": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 8}, "description": "本凭证明确不能证明的事项清单,必填且不得为空"},
  "disclaimer": {"type": "string", "const": "concept-only; no government approval, authorization, funding or implementation commitment is claimed"}
 }
}
