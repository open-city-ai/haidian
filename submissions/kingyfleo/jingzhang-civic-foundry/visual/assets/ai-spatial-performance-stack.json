{
  "schema_version": "1.0.0",
  "architecture_id": "JZ-AI-SPATIAL-STACK-01",
  "principle": "AI is optional and must prove incremental public value against normal non-AI service",
  "layers": [
    {
      "id": "L0",
      "name": "public_base",
      "outputs": [
        "physical_signage",
        "accessibility",
        "staffed_service",
        "offline_route"
      ]
    },
    {
      "id": "L1",
      "name": "evidence_rights",
      "outputs": [
        "licensed_source_registry",
        "author_and_version",
        "correction_log",
        "bounded_RAG"
      ]
    },
    {
      "id": "L2",
      "name": "model_spatial_compute",
      "outputs": [
        "model_registry",
        "rule_check",
        "GIS",
        "microclimate",
        "accessibility"
      ]
    },
    {
      "id": "L3",
      "name": "accountable_agents",
      "agents": [
        "evidence_agent",
        "space_agent",
        "coauthor_agent",
        "operations_agent",
        "evaluation_agent"
      ]
    },
    {
      "id": "L4",
      "name": "human_gates_interfaces",
      "outputs": [
        "red_team",
        "staffed_takeover",
        "refusal",
        "exposure_grade",
        "time_permit"
      ]
    },
    {
      "id": "L5",
      "name": "evidence_loop",
      "outputs": [
        "timestamped_logs",
        "complaint_repair",
        "energy_cost",
        "rollback",
        "A0_A1_A2_comparison"
      ]
    }
  ],
  "normal_service_comparator": {
    "same_task": true,
    "same_user_group": true,
    "same_sample_window": true,
    "dimensions": [
      "completion_rate",
      "time",
      "correction",
      "exclusion",
      "frontline_workload"
    ]
  },
  "renewal_actions": [
    "keep_base_remove_AI",
    "limit_and_repair",
    "expand_with_new_A0"
  ],
  "stop_conditions": [
    "no_accountable_human",
    "no_refusal_path",
    "unresolved_high_risk",
    "no_rollback",
    "no_verified_public_increment"
  ]
}
