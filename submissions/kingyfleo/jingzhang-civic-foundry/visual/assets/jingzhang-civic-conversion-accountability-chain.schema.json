{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://open-city.ai/schemas/jingzhang-civic-conversion-accountability-chain-1.0.0.json",
  "title": "Jing-Zhang Civic Conversion Accountability Chain",
  "description": "A concept-only, machine-readable accountability record connecting technical results, civic products, public use, whole-life delivery, adoption, renewal, and exit. It is not a government permit, product certification, procurement endorsement, approval, or executed legal contract.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "chain_record_id",
    "proposal_status",
    "commission",
    "five_accounts",
    "spatial_licence",
    "stage_gates",
    "delivery",
    "public_safeguards",
    "adoption_evidence",
    "sunset_and_rollback",
    "disclaimer"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "chain_record_id": {
      "type": "string",
      "pattern": "^[A-Z0-9][A-Z0-9-]{5,80}$"
    },
    "proposal_status": {
      "enum": [
        "concept_only",
        "commissioned",
        "rights_review",
        "sandbox_authorized",
        "public_trial_authorized",
        "adoption_review",
        "adopted",
        "renewed",
        "suspended",
        "exited",
        "archived"
      ]
    },
    "commission": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "problem_statement",
        "commissioning_role",
        "primary_beneficiaries",
        "public_interest_test",
        "non_ai_baseline"
      ],
      "properties": {
        "problem_statement": {"type": "string", "minLength": 10},
        "commissioning_role": {"type": "string", "minLength": 3},
        "primary_beneficiaries": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 2}
        },
        "public_interest_test": {"type": "string", "minLength": 10},
        "non_ai_baseline": {"type": "string", "minLength": 5}
      }
    },
    "five_accounts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "public_value",
        "cultural_authenticity",
        "rights_provenance",
        "safety_environment",
        "operations_reinvestment"
      ],
      "properties": {
        "public_value": {"$ref": "#/$defs/account"},
        "cultural_authenticity": {"$ref": "#/$defs/account"},
        "rights_provenance": {"$ref": "#/$defs/account"},
        "safety_environment": {"$ref": "#/$defs/account"},
        "operations_reinvestment": {"$ref": "#/$defs/account"}
      }
    },
    "spatial_licence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "exposure_level",
        "allowed_space_ids",
        "time_limited",
        "reversible",
        "public_baseline_protected",
        "official_geometry_confirmed"
      ],
      "properties": {
        "exposure_level": {
          "enum": [
            "L1_CONTROLLED_VALIDATION",
            "L2_CO_CREATION",
            "L3_PUBLIC_PREMIERE"
          ]
        },
        "allowed_space_ids": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 2}
        },
        "time_limited": {"const": true},
        "reversible": {"const": true},
        "public_baseline_protected": {"const": true},
        "official_geometry_confirmed": {"type": "boolean"},
        "start_at": {"type": ["string", "null"], "format": "date-time"},
        "expires_at": {"type": ["string", "null"], "format": "date-time"}
      }
    },
    "stage_gates": {
      "type": "array",
      "minItems": 5,
      "maxItems": 5,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["gate_id", "decision", "human_owner_role", "evidence_refs"],
        "properties": {
          "gate_id": {
            "enum": [
              "G1_PUBLIC_NECESSITY",
              "G2_CULTURE_AND_RIGHTS",
              "G3_CONTROLLED_TRIAL",
              "G4_PUBLIC_PREMIERE",
              "G5_ADOPT_RENEW_OR_EXIT"
            ]
          },
          "decision": {
            "enum": ["not_submitted", "pending", "pass", "conditional", "stop"]
          },
          "human_owner_role": {"type": "string", "minLength": 3},
          "evidence_refs": {
            "type": "array",
            "items": {"type": "string", "minLength": 2}
          },
          "decision_note": {"type": ["string", "null"]},
          "decided_at": {"type": ["string", "null"], "format": "date-time"}
        }
      }
    },
    "delivery": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "accountable_operator_role",
        "maintenance_owner_role",
        "delivery_route",
        "funding_channels",
        "capex_status",
        "annual_opex_status",
        "exit_reserve_status"
      ],
      "properties": {
        "accountable_operator_role": {"type": "string", "minLength": 3},
        "maintenance_owner_role": {"type": "string", "minLength": 3},
        "delivery_route": {
          "enum": [
            "public_baseline_programme",
            "research_and_validation_trial",
            "public_service_procurement",
            "rights_cleared_cultural_commission",
            "licensed_operation",
            "open_source_common",
            "commercial_value_added_layer",
            "undetermined"
          ]
        },
        "funding_channels": {
          "type": "array",
          "items": {
            "enum": [
              "public_baseline_funding",
              "research_and_innovation_funding",
              "public_interest_or_philanthropic_funding",
              "disclosed_time_limited_sponsorship",
              "earned_operating_revenue",
              "undetermined"
            ]
          }
        },
        "capex_status": {"enum": ["identified", "pending", "not_applicable"]},
        "annual_opex_status": {"enum": ["identified", "pending", "not_applicable"]},
        "exit_reserve_status": {"enum": ["identified", "pending", "not_applicable"]}
      }
    },
    "public_safeguards": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "non_ai_channel",
        "staffed_human_override",
        "accessibility_verified",
        "quiet_or_no_scan_bypass",
        "complaint_route_published",
        "data_minimisation"
      ],
      "properties": {
        "non_ai_channel": {"type": "boolean"},
        "staffed_human_override": {"type": "boolean"},
        "accessibility_verified": {"type": "boolean"},
        "quiet_or_no_scan_bypass": {"type": "boolean"},
        "complaint_route_published": {"type": "boolean"},
        "data_minimisation": {"type": "boolean"}
      }
    },
    "adoption_evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "months_observed",
        "problem_relevance",
        "culture_and_rights_integrity",
        "public_access_and_trust",
        "operational_continuity",
        "transferability"
      ],
      "properties": {
        "months_observed": {"type": "integer", "minimum": 0, "maximum": 12},
        "problem_relevance": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
        "culture_and_rights_integrity": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
        "public_access_and_trust": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
        "operational_continuity": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
        "transferability": {"type": ["number", "null"], "minimum": 0, "maximum": 1}
      }
    },
    "sunset_and_rollback": {
      "type": "object",
      "additionalProperties": false,
      "required": ["stop_conditions", "rollback_plan", "data_disposal_or_retention_rule"],
      "properties": {
        "stop_conditions": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 5}
        },
        "rollback_plan": {"type": "string", "minLength": 10},
        "data_disposal_or_retention_rule": {"type": "string", "minLength": 10}
      }
    },
    "disclaimer": {
      "type": "string",
      "minLength": 20
    }
  },
  "$defs": {
    "account": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "human_owner_role", "evidence_refs", "open_issues"],
      "properties": {
        "status": {"enum": ["not_started", "incomplete", "ready_for_gate", "accepted", "rejected"]},
        "human_owner_role": {"type": "string", "minLength": 3},
        "evidence_refs": {
          "type": "array",
          "items": {"type": "string", "minLength": 2}
        },
        "open_issues": {
          "type": "array",
          "items": {"type": "string", "minLength": 2}
        }
      }
    }
  }
}
