    "normal": {"description_zh": "两门通过，人工、普通服务、数据边界、责任与解编均完整。", "mutation": "none", "expected_decision": "PASS", "expected_reason": "OK"},
    "missing_human_review": {"description_zh": "人工复核缺失。", "mutation": "human_review_present=false", "expected_decision": "BLOCK", "expected_reason": "HUMAN_REVIEW_MISSING"},
    "missing_ordinary_fallback": {"description_zh": "普通服务等价路径缺失。", "mutation": "ordinary_service_equivalence_present=false", "expected_decision": "BLOCK", "expected_reason": "ORDINARY_SERVICE_EQUIVALENCE_MISSING"},
    "data_boundary_violation": {"description_zh": "观测输入命中本场景数据禁区。", "mutation": "observed_data_classes=first_forbidden_class", "expected_decision": "BLOCK", "expected_reason": "DATA_BOUNDARY_VIOLATION"},
    "responsibility_drift": {"description_zh": "实际问责角色与契约结点责任漂移。", "mutation": "observed_accountable_role=UNASSIGNED", "expected_decision": "BLOCK", "expected_reason": "RESPONSIBILITY_DRIFT"},
    "unweave_failure": {"description_zh": "触发退出后未完成解编和恢复回执。", "mutation": "unweave_completed=false", "expected_decision": "BLOCK", "expected_reason": "UNWEAVE_INCOMPLETE"}
