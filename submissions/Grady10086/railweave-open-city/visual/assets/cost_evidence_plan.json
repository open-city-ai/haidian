  "early_stage_cost_rule_en": "Any early-stage service, including G1 participation and G3 independent validation, requires applicable lawful authorisation and an identified funding source before cost is incurred. G4 consolidates pricing, whole-life cost and procurement; it is not retrospective authorisation.",
  "pricing_workflow": [
    {"step": "CP0", "gate": "G0", "action_zh": "核验场地、服务范围、现状复用和工程量取数口径。"},
    {"step": "CP1", "gate": "G1", "action_zh": "确认真实需求、非AI基线、受影响用户和必要人工服务。"},
    {"step": "CP2", "gate": "G4", "action_zh": "由依法确定的PF角色依适用规则开展公开价格检索、市场调查或询价。"},
    {"step": "CP3", "gate": "G4", "action_zh": "统一税费、质保、人员、能耗、维护、更新、无障碍和退出口径。"},
    {"step": "CP4", "gate": "G4", "action_zh": "依法履行预算、采购或合作程序并留存有效文件。"}
  ],
