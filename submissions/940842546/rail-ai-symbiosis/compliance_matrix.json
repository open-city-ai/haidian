  "interlocking_systems": [
    {
      "system_id": "heritage_time",
      "name_zh": "遗产与时间系统",
      "decision": "以京张铁路遗产时间脊、可逆时间织标和经核定的文化叙事组织长期记忆。",
      "stop_condition": "历史来源、文保边界或保护要求未核定时，不进入实体介入。"
    },
    {
      "system_id": "ai_innovation_industry",
      "name_zh": "AI创新与产业系统",
      "decision": "形成开源—评测—受控测试—共享试制—企业采用—复盘的闭环。",
      "stop_condition": "许可、安全、责任主体或专业设备条件缺失时，停留在文档或封闭沙盒。"
    },
    {
      "system_id": "rail_walking_bluegreen",
      "name_zh": "轨道—步行—蓝绿公共空间系统",
      "decision": "以遗产公园为脊、轨道接驳为门、步行骑行为针脚、蓝绿空间为公共底盘。",
      "stop_condition": "道路、站点、无障碍、生态、权属或工程资料不足时，不给出工程线位或可行性结论。"
    },
    {
      "system_id": "accountable_civic_operations",
      "name_zh": "可问责城市与运营治理系统",
      "decision": "每个场景采用登记、分级、试验、审计、续期或退出，并公开责任卡。",
      "stop_condition": "没有最小数据、人工复核、申诉、更正、停机和退出机制时不得上线。"
    }
  ],
