      "statistical_scope": "公开测绘数据与仓库临时边界的独立空间交叉核验",
      "spatial_coverage": "Overpass bbox 39.925,116.315,40.035,116.375；京张铁路遗址公园已测绘段及废弃铁路要素",
      "temporal_coverage": "2026-08-09 查询快照",
      "collection_method": "2026-08-09 通过 Overpass API 独立重跑 Issue #846 公布的 park 与 railway 查询；将 OSM geometry 和 brief/site-package/geometry/provisional_boundaries.geojson 投影至 EPSG:4548，用 Shapely 复算面积、相交、最近距离与长度。",
      "source_locator": "Overpass 查询 bbox 与 Issue #846 复核脚本；已合并上游 PR #850 的登记记录",
      "public_access_status": "public_overpass_query",
      "license_or_reuse_terms": "Data © OpenStreetMap contributors，ODbL 1.0；保留署名、查询日期和数据库许可边界。本包只登记派生读数与方法，不再分发 OSM 原始数据库。",
      "reproduction": {
        "query_date": "2026-08-09",
        "bbox": "39.925,116.315,40.035,116.375",
        "query_filters": [
          "name~京张铁路遗址公园",
          "railway~disused|abandoned"
        ],
        "calculation_crs": "EPSG:4548",
        "independent_result": "与 Issue #846 公布读数一致"
      },
      "cross_check_note": "OSM 与仓库临时 polygon 都可能不完整；一致复算只能证明两条独立路径存在可量化差异，不能判断哪一个是 official boundary。官方 polygon 发布后本组读数失效，并触发全包重算。",
      "usable_for": [
        "背景核验临时边界的不确定性",
        "记录可复现的空间差异和官方 polygon 到来后的重算触发器",
        "规划后续公开数据采集与现场核对"
      ],
      "not_usable_for": [
        "official site boundary、法定规划控制或精确包含关系",
        "平移、替换或修补 PROV-SITE-001",
        "正式面积评分、工程线位或实施结论"
      ],
