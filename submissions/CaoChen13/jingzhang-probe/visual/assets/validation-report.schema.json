{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "validation-report.schema.json",
  "title": "Machine-readable artifact validation report",
  "type": "object",
  "required": ["schema_version", "generated_at", "overall_status", "method", "schema_results", "cross_reference_results", "immutable_input_fingerprint"],
  "properties": {
    "$schema": {"type": "string"},
    "schema_version": {"const": "1.0.0"},
    "generated_at": {"type": "string", "format": "date-time"},
    "overall_status": {"const": "PASS"},
    "method": {
      "type": "object",
      "required": ["schema_validation", "metric_id_check", "feature_id_check", "threshold_check", "reversibility_check"],
      "properties": {
        "schema_validation": {"type": "string", "minLength": 8},
        "metric_id_check": {"type": "string", "minLength": 8},
        "feature_id_check": {"type": "string", "minLength": 8},
        "threshold_check": {"type": "string", "minLength": 8},
        "reversibility_check": {"type": "string", "minLength": 8}
      },
      "additionalProperties": false
    },
    "schema_results": {"type": "array", "minItems": 5, "items": {"$ref": "#/$defs/result"}},
    "cross_reference_results": {"type": "array", "minItems": 5, "items": {"$ref": "#/$defs/result"}},
    "immutable_input_fingerprint": {"const": "56ec03269648908d0f00d050e447bc31d7e4a9d8d4ed33c258cbbc36e8f78f1e"}
  },
  "$defs": {
    "result": {
      "type": "object",
      "required": ["check", "status", "details"],
      "properties": {
        "file": {"type": "string"},
        "check": {"type": "string", "minLength": 2},
        "status": {"const": "PASS"},
        "details": {"type": "string", "minLength": 2},
        "count": {"type": "integer", "minimum": 0}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
