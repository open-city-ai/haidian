{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "reversibility-r1-r3.schema.json",
  "title": "R1-R3 reversibility classification",
  "type": "object",
  "required": ["schema_version", "proposal_section", "classification_rule", "levels", "linked_feature_ids", "linked_metric_ids", "cost_status"],
  "properties": {
    "$schema": {"type": "string"},
    "schema_version": {"const": "1.0.0"},
    "proposal_section": {"type": "string", "minLength": 2},
    "classification_rule": {"type": "string", "minLength": 20},
    "levels": {
      "type": "array", "minItems": 3, "maxItems": 3,
      "prefixItems": [
        {"$ref": "#/$defs/r1"},
        {"$ref": "#/$defs/r2"},
        {"$ref": "#/$defs/r3"}
      ],
      "items": false
    },
    "linked_feature_ids": {"const": ["PHASE-001", "PHASE-002", "PHASE-003", "COST-SCREEN-001"]},
    "linked_metric_ids": {"const": ["mitigation_budget_cny"]},
    "cost_status": {"const": "unknown"}
  },
  "$defs": {
    "base": {
      "type": "object",
      "required": ["level", "label_zh", "spatial_actions", "rollback_requirements", "allowed_while_key_data_unknown"],
      "properties": {
        "level": {"enum": ["R1", "R2", "R3"]},
        "label_zh": {"type": "string", "minLength": 3},
        "spatial_actions": {"type": "array", "minItems": 5, "uniqueItems": true, "items": {"type": "string", "minLength": 2}},
        "rollback_requirements": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 2}},
        "allowed_while_key_data_unknown": {"type": "boolean"}
      },
      "additionalProperties": false
    },
    "r1": {"allOf": [{"$ref": "#/$defs/base"}, {"properties": {"level": {"const": "R1"}, "label_zh": {"const": "可撤除"}, "allowed_while_key_data_unknown": {"const": true}}}]},
    "r2": {"allOf": [{"$ref": "#/$defs/base"}, {"properties": {"level": {"const": "R2"}, "label_zh": {"const": "可修复"}, "allowed_while_key_data_unknown": {"const": false}}}]},
    "r3": {"allOf": [{"$ref": "#/$defs/base"}, {"properties": {"level": {"const": "R3"}, "label_zh": {"const": "难逆或不可逆"}, "allowed_while_key_data_unknown": {"const": false}}}]}
  },
  "additionalProperties": false
}
