{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "duty-ledger.schema.json",
  "title": "Benefit-cost-responsibility ledger contract",
  "type": "object",
  "required": ["schema_version", "proposal_sections", "recalculation_key", "benefit_ledger", "cost_ledger", "duty_ledger", "cost_side_indicators"],
  "properties": {
    "$schema": {"type": "string"},
    "schema_version": {"const": "1.0.0"},
    "proposal_sections": {"type": "array", "minItems": 3, "items": {"type": "string", "minLength": 2}},
    "recalculation_key": {"const": ["intervention_id", "geometry_version", "evidence_cutoff"]},
    "benefit_ledger": {"$ref": "#/$defs/ledger"},
    "cost_ledger": {"$ref": "#/$defs/ledger"},
    "duty_ledger": {
      "type": "object",
      "required": ["fields", "state_chain", "closure_rule"],
      "properties": {
        "fields": {"type": "array", "minItems": 7, "uniqueItems": true, "items": {"type": "string"}},
        "state_chain": {"const": ["draft", "evidence_pending", "duty_confirmed", "accepted", "reopened"]},
        "closure_rule": {"type": "string", "minLength": 20}
      },
      "additionalProperties": false
    },
    "cost_side_indicators": {
      "type": "array", "minItems": 3, "maxItems": 3,
      "items": {
        "type": "object",
        "required": ["metric_id", "status", "value", "formula", "missing_inputs"],
        "properties": {
          "metric_id": {"enum": ["affected_household_count", "mitigation_budget_cny", "duty_closure_ratio"]},
          "status": {"const": "unknown"},
          "value": {"type": "null"},
          "formula": {"type": "string", "minLength": 8},
          "missing_inputs": {"type": "array", "minItems": 4, "items": {"type": "string", "minLength": 4}}
        },
        "additionalProperties": false
      }
    }
  },
  "$defs": {
    "ledger": {
      "type": "object",
      "required": ["fields", "domains"],
      "properties": {
        "fields": {"type": "array", "minItems": 4, "uniqueItems": true, "items": {"type": "string"}},
        "domains": {"type": "array", "minItems": 4, "uniqueItems": true, "items": {"type": "string", "minLength": 2}},
        "aggregation_rule": {"type": "string", "minLength": 10}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
