{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "01-continuous-framework.schema.json",
  "title": "Continuous framework decision gate",
  "type": "object",
  "required": ["schema_version", "gate_id", "proposal_section", "name_zh", "current_status", "establishment_conditions", "elimination_conditions", "current_allowed_actions", "prohibited_before_gate", "feature_ids", "metric_ids", "unknowns"],
  "properties": {
    "$schema": {"type": "string"},
    "schema_version": {"const": "1.0.0"},
    "gate_id": {"const": "GATE-01-CONTINUOUS-FRAMEWORK"},
    "proposal_section": {"type": "string", "minLength": 2},
    "name_zh": {"const": "连续骨架保全案"},
    "current_status": {"const": "unknown"},
    "establishment_conditions": {
      "type": "array", "minItems": 2,
      "items": {
        "type": "object",
        "required": ["condition_id", "statement", "operator", "expected", "current_value", "status"],
        "properties": {
          "condition_id": {"type": "string", "pattern": "^G01-C0[12]$"},
          "statement": {"type": "string", "minLength": 4},
          "operator": {"enum": ["contains_all", "all_pass"]},
          "expected": {"const": true},
          "current_value": {"type": "null"},
          "status": {"const": "unknown"}
        },
        "additionalProperties": false
      }
    },
    "elimination_conditions": {"type": "array", "minItems": 2, "items": {"type": "string", "minLength": 4}},
    "current_allowed_actions": {"type": "array", "minItems": 4, "items": {"type": "string", "minLength": 2}},
    "prohibited_before_gate": {"type": "array", "minItems": 2, "items": {"type": "string", "minLength": 2}},
    "feature_ids": {"type": "array", "minItems": 39, "uniqueItems": true, "items": {"type": "string", "pattern": "^(PUBLIC|ROAD|GREEN|BLDG|PHASE)-[0-9]{3}$"}},
    "metric_ids": {"const": ["floor_area_ratio"]},
    "unknowns": {"type": "array", "minItems": 2, "items": {"type": "string", "minLength": 4}}
  },
  "additionalProperties": false
}
