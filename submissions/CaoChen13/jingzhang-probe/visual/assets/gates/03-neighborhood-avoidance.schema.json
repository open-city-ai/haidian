{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "03-neighborhood-avoidance.schema.json",
  "title": "Neighborhood-avoidance decision gate",
  "type": "object",
  "required": ["schema_version", "gate_id", "proposal_section", "name_zh", "current_status", "establishment_expression", "elimination_expression", "current_allowed_actions", "prohibited_before_closure", "feature_ids", "metric_ids", "unknowns"],
  "properties": {
    "$schema": {"type": "string"},
    "schema_version": {"const": "1.0.0"},
    "gate_id": {"const": "GATE-03-NEIGHBORHOOD-AVOIDANCE"},
    "proposal_section": {"type": "string", "minLength": 2},
    "name_zh": {"const": "邻里避让回路案"},
    "current_status": {"const": "unknown"},
    "establishment_expression": {"type": "string", "minLength": 20},
    "elimination_expression": {"type": "string", "minLength": 20},
    "current_allowed_actions": {"type": "array", "minItems": 4, "items": {"type": "string", "minLength": 4}},
    "prohibited_before_closure": {"type": "array", "minItems": 4, "items": {"type": "string", "minLength": 2}},
    "feature_ids": {"type": "array", "minItems": 13, "uniqueItems": true, "items": {"type": "string", "pattern": "^(PHASE|ROAD|PUBLIC|COST-SCREEN)-[0-9]{3}$"}},
    "metric_ids": {"const": ["affected_household_count", "mitigation_budget_cny"]},
    "unknowns": {"type": "array", "minItems": 4, "items": {"type": "string", "minLength": 4}}
  },
  "additionalProperties": false
}
