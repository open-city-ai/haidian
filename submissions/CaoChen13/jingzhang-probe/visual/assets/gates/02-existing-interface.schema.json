{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "02-existing-interface.schema.json",
  "title": "Existing-interface decision gate",
  "type": "object",
  "required": ["schema_version", "gate_id", "proposal_section", "name_zh", "current_status", "decision_variables", "establishment_expression", "elimination_expression", "current_allowed_actions", "trial_entry_conditions", "feature_ids", "metric_ids", "unknowns"],
  "properties": {
    "$schema": {"type": "string"},
    "schema_version": {"const": "1.0.0"},
    "gate_id": {"const": "GATE-02-EXISTING-INTERFACE"},
    "proposal_section": {"type": "string", "minLength": 2},
    "name_zh": {"const": "存量界面织补案"},
    "current_status": {"const": "unknown"},
    "decision_variables": {
      "type": "array", "minItems": 4, "maxItems": 4,
      "items": {
        "type": "object",
        "required": ["variable_id", "symbol", "formula", "status", "value"],
        "properties": {
          "variable_id": {"enum": ["delta_gfa", "existing_capacity_surplus", "new_access_efficiency", "existing_access_efficiency"]},
          "symbol": {"enum": ["ΔGFA", "S", "R_新增", "R_存量"]},
          "formula": {"type": "string", "minLength": 8},
          "pass_expression": {"type": "string"},
          "comparison_expression": {"type": "string"},
          "status": {"const": "unknown"},
          "value": {"type": "null"}
        },
        "additionalProperties": false
      }
    },
    "establishment_expression": {"const": "ΔGFA ≤ 0 AND S ≥ 0"},
    "elimination_expression": {"const": "S < 0 OR (ΔGFA > 0 AND R_新增 > R_存量)"},
    "current_allowed_actions": {"const": ["存量盘点"]},
    "trial_entry_conditions": {"type": "array", "minItems": 3, "items": {"type": "string", "minLength": 4}},
    "feature_ids": {"type": "array", "minItems": 22, "uniqueItems": true, "items": {"type": "string", "pattern": "^(BLDG|PUBLIC|LU)-[0-9]{3}$"}},
    "metric_ids": {"const": ["floor_area_ratio"]},
    "unknowns": {"type": "array", "minItems": 5, "items": {"type": "string", "minLength": 4}}
  },
  "additionalProperties": false
}
