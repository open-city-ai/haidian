{
  "$schema": "duty-ledger.schema.json",
  "schema_version": "1.0.0",
  "proposal_sections": [
    "三层范围工作框架",
    "受益—成本—责任作为总图过滤器",
    "项目不是愿望清单，而是一组门控状态"
  ],
  "recalculation_key": [
    "intervention_id",
    "geometry_version",
    "evidence_cutoff"
  ],
  "benefit_ledger": {
    "fields": [
      "beneficiary_definition",
      "eligibility_rule",
      "accessibility_evidence",
      "use_evidence"
    ],
    "domains": [
      "公共通行",
      "日常停留",
      "服务可达",
      "社区与学研之间的资源共享"
    ],
    "aggregation_rule": "受益与代价不做简单净额相抵；总体受益不能取消权利、法定程序或最低服务条件"
  },
  "cost_ledger": {
    "fields": [
      "confirmed_impact_geometry",
      "impact_type",
      "duration_condition",
      "verified_action_quantity",
      "reviewed_unit_cost"
    ],
    "domains": [
      "施工",
      "绕行",
      "噪声",
      "经营",
      "维护",
      "能源",
      "隐私",
      "空间排他"
    ]
  },
  "duty_ledger": {
    "fields": [
      "trigger",
      "proposed_duty_holder",
      "funder",
      "reviewer",
      "due_condition",
      "acceptance_evidence",
      "status"
    ],
    "state_chain": [
      "draft",
      "evidence_pending",
      "duty_confirmed",
      "accepted",
      "reopened"
    ],
    "closure_rule": "责任关闭只在触发条件满足、资金与行动完成、验收证据被指定复核人接受后发生"
  },
  "cost_side_indicators": [
    {
      "metric_id": "affected_household_count",
      "status": "unknown",
      "value": null,
      "formula": "count(distinct verified_household_id intersecting professionally_confirmed_impact_area)",
      "missing_inputs": [
        "经授权且去重的房屋/住户资料",
        "专业确认的影响范围",
        "时间截面",
        "人的复核"
      ]
    },
    {
      "metric_id": "mitigation_budget_cny",
      "status": "unknown",
      "value": null,
      "formula": "Σ(verified_action_quantity_i × reviewed_unit_cost_i)",
      "missing_inputs": [
        "逐行动工程量",
        "审核单价及版本",
        "资金承诺",
        "审批状态",
        "受影响方过程",
        "人的批准"
      ]
    },
    {
      "metric_id": "duty_closure_ratio",
      "status": "unknown",
      "value": null,
      "formula": "accepted_closed_due_actions / all_due_actions",
      "missing_inputs": [
        "生效触发器",
        "截止条件",
        "行动状态",
        "验收记录"
      ]
    }
  ]
}
