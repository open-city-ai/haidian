<?xml version="1.0" encoding="UTF-8"?>
<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 1640 840">
  <rect width="1640" height="840" fill="#f8fafc"/>
  <rect x="56" y="56" width="1528" height="728" rx="32" fill="#ffffff" stroke="#cbd5e1" stroke-width="2"/>
  <text x="112" y="140" font-family="Arial, sans-serif" font-size="48" font-weight="bold" fill="#111827">核心指标复算与证据链</text>
  <text x="112" y="200" font-family="Arial, sans-serif" font-size="28" fill="#64748b">site_area | autonomous_road_ratio | green_ratio | shuttle_stop_density</text>
  
  <!-- Metrics grid -->
  <g transform="translate(120, 260)">
    <!-- Site Area -->
    <rect x="0" y="0" width="340" height="200" rx="16" fill="#e0f2fe" stroke="#0284c7" stroke-width="3"/>
    <text x="170" y="40" text-anchor="middle" font-family="Arial, sans-serif" font-size="22" font-weight="bold" fill="#0369a1">site_area_sqm</text>
    <text x="170" y="100" text-anchor="middle" font-family="Arial, sans-serif" font-size="48" font-weight="bold" fill="#0c4a6e">11.4M</text>
    <text x="170" y="140" text-anchor="middle" font-family="Arial, sans-serif" font-size="18" fill="#075985">11,400,000 sqm</text>
    <text x="170" y="175" text-anchor="middle" font-family="Arial, sans-serif" font-size="14" fill="#64748b">总体设计范围面积</text>
    
    <!-- Autonomous Road Ratio -->
    <rect x="360" y="0" width="340" height="200" rx="16" fill="#dcfce7" stroke="#16a34a" stroke-width="3"/>
    <text x="530" y="40" text-anchor="middle" font-family="Arial, sans-serif" font-size="22" font-weight="bold" fill="#15803d">autonomous_road_ratio</text>
    <text x="530" y="100" text-anchor="middle" font-family="Arial, sans-serif" font-size="48" font-weight="bold" fill="#14532d">85%</text>
    <text x="530" y="140" text-anchor="middle" font-family="Arial, sans-serif" font-size="18" fill="#166534">0.85</text>
    <text x="530" y="175" text-anchor="middle" font-family="Arial, sans-serif" font-size="14" fill="#64748b">自动驾驶专网覆盖率</text>
    
    <!-- Green Ratio -->
    <rect x="720" y="0" width="340" height="200" rx="16" fill="#fef3c7" stroke="#d97706" stroke-width="3"/>
    <text x="890" y="40" text-anchor="middle" font-family="Arial, sans-serif" font-size="22" font-weight="bold" fill="#b45309">green_ratio</text>
    <text x="890" y="100" text-anchor="middle" font-family="Arial, sans-serif" font-size="48" font-weight="bold" fill="#92400e">32%</text>
    <text x="890" y="140" text-anchor="middle" font-family="Arial, sans-serif" font-size="18" fill="#a16207">0.32</text>
    <text x="890" y="175" text-anchor="middle" font-family="Arial, sans-serif" font-size="14" fill="#64748b">绿地向积比</text>
    
    <!-- Public Space Ratio -->
    <rect x="1080" y="0" width="340" height="200" rx="16" fill="#fce7f3" stroke="#db2777" stroke-width="3"/>
    <text x="1250" y="40" text-anchor="middle" font-family="Arial, sans-serif" font-size="22" font-weight="bold" fill="#be185d">public_space_ratio</text>
    <text x="1250" y="100" text-anchor="middle" font-family="Arial, sans-serif" font-size="48" font-weight="bold" fill="#9d174d">18%</text>
    <text x="1250" y="140" text-anchor="middle" font-family="Arial, sans-serif" font-size="18" fill="#be3f87">0.18</text>
    <text x="1250" y="175" text-anchor="middle" font-family="Arial, sans-serif" font-size="14" fill="#64748b">公共空间比</text>
  </g>
  
  <!-- Shuttle stop density -->
  <g transform="translate(120, 500)">
    <rect x="0" y="0" width="700" height="150" rx="16" fill="#1e293b"/>
    <text x="350" y="35" text-anchor="middle" font-family="Arial, sans-serif" font-size="22" font-weight="bold" fill="#ffffff">shuttle_stop_density</text>
    <text x="200" y="90" text-anchor="middle" font-family="Arial, sans-serif" font-size="48" font-weight="bold" fill="#22d3ee">200m</text>
    <text x="200" y="130" text-anchor="middle" font-family="Arial, sans-serif" font-size="16" fill="#94a3b8">摆渡站点间距</text>
    <text x="500" y="90" text-anchor="middle" font-family="Arial, sans-serif" font-size="48" font-weight="bold" fill="#22d3ee">120处</text>
    <text x="500" y="130" text-anchor="middle" font-family="Arial, sans-serif" font-size="16" fill="#94a3b8">全域站点数量</text>
  </g>
  
  <!-- Key area count -->
  <g transform="translate(860, 500)">
    <rect x="0" y="0" width="660" height="150" rx="16" fill="#ffffff" stroke="#e2e8f0" stroke-width="2"/>
    <text x="330" y="35" text-anchor="middle" font-family="Arial, sans-serif" font-size="22" font-weight="bold" fill="#1e293b">key_area_count</text>
    <text x="165" y="100" text-anchor="middle" font-family="Arial, sans-serif" font-size="48" font-weight="bold" fill="#0284c7">3</text>
    <text x="165" y="135" text-anchor="middle" font-family="Arial, sans-serif" font-size="14" fill="#64748b">重点区域数量</text>
    <text x="400" y="70" text-anchor="middle" font-family="Arial, sans-serif" font-size="16" fill="#475569">众智园</text>
    <text x="400" y="95" text-anchor="middle" font-family="Arial, sans-serif" font-size="16" fill="#475569">AI原点社区</text>
    <text x="400" y="120" text-anchor="middle" font-family="Arial, sans-serif" font-size="16" fill="#475569">大钟寺</text>
  </g>
  
  <!-- Evidence sources -->
  <g transform="translate(120, 690)">
    <rect x="0" y="0" width="1400" height="60" rx="12" fill="#f1f5f9" stroke="#cbd5e1" stroke-width="1"/>
    <text x="30" y="38" font-family="Arial, sans-serif" font-size="16" font-weight="bold" fill="#475569">证据来源:</text>
    <text x="180" y="38" font-family="Arial, sans-serif" font-size="16" fill="#64748b">site_boundary.geojson</text>
    <text x="420" y="38" font-family="Arial, sans-serif" font-size="16" fill="#64748b">| roads.geojson</text>
    <text x="560" y="38" font-family="Arial, sans-serif" font-size="16" fill="#64748b">| green_space.geojson</text>
    <text x="800" y="38" font-family="Arial, sans-serif" font-size="16" fill="#64748b">| public_space.geojson</text>
    <text x="1080" y="38" font-family="Arial, sans-serif" font-size="16" fill="#64748b">| key_areas.geojson</text>
  </g>
  
  <text x="112" y="800" font-family="Arial, sans-serif" font-size="20" fill="#475569">所有指标均基于provisional边界计算，待官方边界发布后需重算。</text>
</svg>
