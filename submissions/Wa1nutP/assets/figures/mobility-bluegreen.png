<?xml version="1.0" encoding="UTF-8"?>
<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 1640 840">
  <rect width="1640" height="840" fill="#f8fafc"/>
  <rect x="56" y="56" width="1528" height="728" rx="32" fill="#ffffff" stroke="#cbd5e1" stroke-width="2"/>
  <text x="112" y="140" font-family="Arial, sans-serif" font-size="48" font-weight="bold" fill="#111827">交通慢行与蓝绿公共空间复合系统</text>
  <text x="112" y="200" font-family="Arial, sans-serif" font-size="28" fill="#64748b">L3-L4自动驾驶专网 | 京张遗址公园绿带 | 慢行优先街道</text>
  
  <!-- Main diagram -->
  <g transform="translate(120, 240)">
    <!-- Site boundary -->
    <rect x="0" y="0" width="800" height="400" rx="16" fill="#f1f5f9" stroke="#cbd5e1" stroke-width="2"/>
    
    <!-- Autonomous main corridor (north-south) -->
    <rect x="350" y="30" width="100" height="340" rx="8" fill="#22d3ee"/>
    <text x="400" y="200" text-anchor="middle" font-family="Arial, sans-serif" font-size="18" font-weight="bold" fill="#0e7490">L3-L4</text>
    <text x="400" y="225" text-anchor="middle" font-family="Arial, sans-serif" font-size="16" fill="#0e7490">主廊道</text>
    
    <!-- East-west connectors -->
    <rect x="150" y="120" width="550" height="30" rx="4" fill="#0891b2"/>
    <rect x="150" y="250" width="550" height="30" rx="4" fill="#0891b2"/>
    
    <!-- Green space (Jingzhang Park) -->
    <rect x="100" y="100" width="200" height="200" rx="12" fill="#86efac" stroke="#16a34a" stroke-width="2"/>
    <text x="200" y="195" text-anchor="middle" font-family="Arial, sans-serif" font-size="18" font-weight="bold" fill="#15803d">京张遗址公园</text>
    <text x="200" y="220" text-anchor="middle" font-family="Arial, sans-serif" font-size="14" fill="#166534">绿带</text>
    
    <!-- Key areas -->
    <circle cx="200" cy="80" r="50" fill="#0284c7"/>
    <text x="200" y="75" text-anchor="middle" font-family="Arial, sans-serif" font-size="14" font-weight="bold" fill="#ffffff">众智园</text>
    
    <circle cx="650" cy="200" r="50" fill="#16a34a"/>
    <text x="650" y="195" text-anchor="middle" font-family="Arial, sans-serif" font-size="14" font-weight="bold" fill="#ffffff">AI原点</text>
    
    <circle cx="200" cy="320" r="40" fill="#d97706"/>
    <text x="200" y="315" text-anchor="middle" font-family="Arial, sans-serif" font-size="12" font-weight="bold" fill="#ffffff">大钟寺</text>
    
    <!-- Shuttle stops -->
    <circle cx="400" cy="60" r="12" fill="#1e293b"/>
    <circle cx="400" cy="160" r="12" fill="#1e293b"/>
    <circle cx="400" cy="260" r="12" fill="#1e293b"/>
    <circle cx="400" cy="360" r="12" fill="#1e293b"/>
    
    <!-- Slow street -->
    <rect x="500" y="90" width="200" height="60" rx="8" fill="#fef3c7" stroke="#d97706" stroke-width="2"/>
    <text x="600" y="125" text-anchor="middle" font-family="Arial, sans-serif" font-size="16" font-weight="bold" fill="#b45309">慢行优先</text>
  </g>
  
  <!-- Legend -->
  <g transform="translate(1000, 240)">
    <rect x="0" y="0" width="500" height="400" rx="16" fill="#ffffff" stroke="#e2e8f0" stroke-width="2"/>
    <text x="250" y="40" text-anchor="middle" font-family="Arial, sans-serif" font-size="24" font-weight="bold" fill="#1e293b">图例</text>
    
    <rect x="30" y="70" width="60" height="30" rx="4" fill="#22d3ee"/>
    <text x="110" y="90" font-family="Arial, sans-serif" font-size="18" fill="#475569">L3-L4自动驾驶主廊道</text>
    
    <rect x="30" y="120" width="60" height="30" rx="4" fill="#0891b2"/>
    <text x="110" y="140" font-family="Arial, sans-serif" font-size="18" fill="#475569">自动驾驶支线</text>
    
    <rect x="30" y="170" width="60" height="30" rx="4" fill="#86efac" stroke="#16a34a"/>
    <text x="110" y="190" font-family="Arial, sans-serif" font-size="18" fill="#475569">京张遗址公园绿地</text>
    
    <rect x="30" y="220" width="60" height="30" rx="4" fill="#fef3c7" stroke="#d97706"/>
    <text x="110" y="240" font-family="Arial, sans-serif" font-size="18" fill="#475569">慢行优先街道</text>
    
    <circle cx="60" cy="290" r="12" fill="#1e293b"/>
    <text x="110" y="295" font-family="Arial, sans-serif" font-size="18" fill="#475569">自动驾驶摆渡站点</text>
    
    <circle cx="60" cy="340" r="20" fill="#0284c7"/>
    <text x="110" y="345" font-family="Arial, sans-serif" font-size="18" fill="#475569">重点区域</text>
  </g>
  
  <!-- Key metrics -->
  <g transform="translate(1000, 660)">
    <rect x="0" y="0" width="500" height="100" rx="16" fill="#1e293b"/>
    <text x="250" y="30" text-anchor="middle" font-family="Arial, sans-serif" font-size="20" font-weight="bold" fill="#ffffff">道路分类指标</text>
    <text x="120" y="70" text-anchor="middle" font-family="Arial, sans-serif" font-size="28" font-weight="bold" fill="#22d3ee">85%</text>
    <text x="250" y="70" text-anchor="middle" font-family="Arial, sans-serif" font-size="28" font-weight="bold" fill="#22d3ee">120</text>
    <text x="380" y="70" text-anchor="middle" font-family="Arial, sans-serif" font-size="28" font-weight="bold" fill="#22d3ee">200m</text>
    <text x="120" y="90" text-anchor="middle" font-family="Arial, sans-serif" font-size="12" fill="#94a3b8">专网比例</text>
    <text x="250" y="90" text-anchor="middle" font-family="Arial, sans-serif" font-size="12" fill="#94a3b8">站点数量</text>
    <text x="380" y="90" text-anchor="middle" font-family="Arial, sans-serif" font-size="12" fill="#94a3b8">服务半径</text>
  </g>
  
  <text x="112" y="800" font-family="Arial, sans-serif" font-size="20" fill="#475569">数据来源: roads.geojson | green_space.geojson | public_space.geojson</text>
</svg>
