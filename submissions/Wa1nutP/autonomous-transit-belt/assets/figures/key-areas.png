<?xml version="1.0" encoding="UTF-8"?>
<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 1640 840">
  <rect width="1640" height="840" fill="#f8fafc"/>
  <rect x="56" y="56" width="1528" height="728" rx="32" fill="#ffffff" stroke="#cbd5e1" stroke-width="2"/>
  <text x="112" y="140" font-family="Arial, sans-serif" font-size="48" font-weight="bold" fill="#111827">三处重点区域索引与设计任务</text>
  <text x="112" y="200" font-family="Arial, sans-serif" font-size="28" fill="#64748b">众智园AI自主创新加速区 | 北京AI原点社区 | 大钟寺AI产业聚集区</text>
  
  <!-- Key Area 1: Zhongzhiyuan -->
  <g transform="translate(120, 260)">
    <rect x="0" y="0" width="460" height="320" rx="20" fill="#e0f2fe" stroke="#0284c7" stroke-width="4"/>
    <rect x="20" y="20" width="420" height="60" rx="12" fill="#0284c7"/>
    <text x="230" y="58" text-anchor="middle" font-family="Arial, sans-serif" font-size="26" font-weight="bold" fill="#ffffff">众智园AI自主创新加速区</text>
    <text x="230" y="105" text-anchor="middle" font-family="Arial, sans-serif" font-size="18" fill="#0369a1">192.1 ha | PROV-KEY-001</text>
    
    <text x="30" y="145" font-family="Arial, sans-serif" font-size="20" font-weight="bold" fill="#1e293b">核心定位</text>
    <text x="30" y="175" font-family="Arial, sans-serif" font-size="16" fill="#475569">自动驾驶技术策源与测试核心</text>
    
    <text x="30" y="210" font-family="Arial, sans-serif" font-size="20" font-weight="bold" fill="#1e293b">自动驾驶场景</text>
    <text x="30" y="240" font-family="Arial, sans-serif" font-size="14" fill="#475569">北航-北邮自动驾驶测试走廊</text>
    <text x="30" y="265" font-family="Arial, sans-serif" font-size="14" fill="#475569">清河滨水自动驾驶展示</text>
    <text x="30" y="290" font-family="Arial, sans-serif" font-size="14" fill="#475569">L4封闭测试场</text>
  </g>
  
  <!-- Key Area 2: AI Origin Community -->
  <g transform="translate(590, 260)">
    <rect x="0" y="0" width="460" height="320" rx="20" fill="#dcfce7" stroke="#16a34a" stroke-width="4"/>
    <rect x="20" y="20" width="420" height="60" rx="12" fill="#16a34a"/>
    <text x="230" y="58" text-anchor="middle" font-family="Arial, sans-serif" font-size="26" font-weight="bold" fill="#ffffff">北京AI原点社区</text>
    <text x="230" y="105" text-anchor="middle" font-family="Arial, sans-serif" font-size="18" fill="#15803d">104.3 ha | PROV-KEY-002</text>
    
    <text x="30" y="145" font-family="Arial, sans-serif" font-size="20" font-weight="bold" fill="#1e293b">核心定位</text>
    <text x="30" y="175" font-family="Arial, sans-serif" font-size="16" fill="#475569">自动驾驶与人的亲密接触界面</text>
    
    <text x="30" y="210" font-family="Arial, sans-serif" font-size="20" font-weight="bold" fill="#1e293b">自动驾驶场景</text>
    <text x="30" y="240" font-family="Arial, sans-serif" font-size="14" fill="#475569">AI原点中央枢纽（摆渡总站）</text>
    <text x="30" y="265" font-family="Arial, sans-serif" font-size="14" fill="#475569">社区巴士网格（200m站点）</text>
    <text x="30" y="290" font-family="Arial, sans-serif" font-size="14" fill="#475569">深夜安全摆渡服务</text>
  </g>
  
  <!-- Key Area 3: Dazhongsi -->
  <g transform="translate(1060, 260)">
    <rect x="0" y="0" width="460" height="320" rx="20" fill="#fef3c7" stroke="#d97706" stroke-width="4"/>
    <rect x="20" y="20" width="420" height="60" rx="12" fill="#d97706"/>
    <text x="230" y="58" text-anchor="middle" font-family="Arial, sans-serif" font-size="26" font-weight="bold" fill="#ffffff">大钟寺AI产业聚集区</text>
    <text x="230" y="105" text-anchor="middle" font-family="Arial, sans-serif" font-size="18" fill="#b45309">72.0 ha | PROV-KEY-003</text>
    
    <text x="30" y="145" font-family="Arial, sans-serif" font-size="20" font-weight="bold" fill="#1e293b">核心定位</text>
    <text x="30" y="175" font-family="Arial, sans-serif" font-size="16" fill="#475569">自动驾驶商业服务与TOD一体化</text>
    
    <text x="30" y="210" font-family="Arial, sans-serif" font-size="20" font-weight="bold" fill="#1e293b">自动驾驶场景</text>
    <text x="30" y="240" font-family="Arial, sans-serif" font-size="14" fill="#475569">大钟寺站自动驾驶枢纽</text>
    <text x="30" y="265" font-family="Arial, sans-serif" font-size="14" fill="#475569">智能配送走廊</text>
    <text x="30" y="290" font-family="Arial, sans-serif" font-size="14" fill="#475569">企业专属摆渡服务</text>
  </g>
  
  <!-- Autonomous transit key metrics -->
  <g transform="translate(120, 620)">
    <rect x="0" y="0" width="1400" height="120" rx="16" fill="#1e293b"/>
    <text x="700" y="35" text-anchor="middle" font-family="Arial, sans-serif" font-size="24" font-weight="bold" fill="#ffffff">核心交通指标</text>
    
    <text x="200" y="70" text-anchor="middle" font-family="Arial, sans-serif" font-size="32" font-weight="bold" fill="#22d3ee">85%</text>
    <text x="200" y="100" text-anchor="middle" font-family="Arial, sans-serif" font-size="16" fill="#94a3b8">道路专网比例</text>
    
    <text x="500" y="70" text-anchor="middle" font-family="Arial, sans-serif" font-size="32" font-weight="bold" fill="#22d3ee">120处</text>
    <text x="500" y="100" text-anchor="middle" font-family="Arial, sans-serif" font-size="16" fill="#94a3b8">摆渡站点</text>
    
    <text x="800" y="70" text-anchor="middle" font-family="Arial, sans-serif" font-size="32" font-weight="bold" fill="#22d3ee">200m</text>
    <text x="800" y="100" text-anchor="middle" font-family="Arial, sans-serif" font-size="16" fill="#94a3b8">服务半径</text>
    
    <text x="1100" y="70" text-anchor="middle" font-family="Arial, sans-serif" font-size="32" font-weight="bold" fill="#22d3ee">L3-L4</text>
    <text x="1100" y="100" text-anchor="middle" font-family="Arial, sans-serif" font-size="16" fill="#94a3b8">自动驾驶等级</text>
  </g>
  
  <text x="112" y="800" font-family="Arial, sans-serif" font-size="20" fill="#475569">数据来源: key_areas.geojson | 交通设计: roads.geojson | 指标: metrics.json</text>
</svg>
