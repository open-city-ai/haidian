<?xml version="1.0" encoding="UTF-8"?>
<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 1640 840">
  <rect width="1640" height="840" fill="#f8fafc"/>
  <rect x="56" y="56" width="1528" height="728" rx="32" fill="#ffffff" stroke="#cbd5e1" stroke-width="2"/>
  <text x="112" y="140" font-family="Arial, sans-serif" font-size="48" font-weight="bold" fill="#111827">三层范围与空间结构</text>
  <text x="112" y="200" font-family="Arial, sans-serif" font-size="28" fill="#64748b">统筹研究 → 总体设计 → 重点区域 逐级落实</text>
  
  <!-- Three-level scope framework -->
  <g transform="translate(120, 260)">
    <!-- Level 1: Coordinated Research -->
    <rect x="0" y="0" width="420" height="180" rx="16" fill="#e0f2fe" stroke="#0284c7" stroke-width="4"/>
    <text x="210" y="40" text-anchor="middle" font-family="Arial, sans-serif" font-size="28" font-weight="bold" fill="#0369a1">统筹研究范围</text>
    <text x="210" y="75" text-anchor="middle" font-family="Arial, sans-serif" font-size="22" fill="#075985">43.6 km²</text>
    <text x="210" y="110" text-anchor="middle" font-family="Arial, sans-serif" font-size="18" fill="#0c4a6e">AI产业生态战略定位</text>
    <text x="210" y="140" text-anchor="middle" font-family="Arial, sans-serif" font-size="18" fill="#0c4a6e">全域自动驾驶专网框架</text>
    <text x="210" y="165" text-anchor="middle" font-family="Arial, sans-serif" font-size="16" fill="#64748b">三条主题带 | 五项功能</text>
    
    <!-- Arrow -->
    <line x1="420" y1="90" x2="520" y2="90" stroke="#0284c7" stroke-width="4"/>
    <polygon points="520,90 510,80 510,100" fill="#0284c7"/>
    
    <!-- Level 2: Overall Design -->
    <rect x="520" y="0" width="420" height="180" rx="16" fill="#dcfce7" stroke="#16a34a" stroke-width="4"/>
    <text x="730" y="40" text-anchor="middle" font-family="Arial, sans-serif" font-size="28" font-weight="bold" fill="#15803d">总体设计范围</text>
    <text x="730" y="75" text-anchor="middle" font-family="Arial, sans-serif" font-size="22" fill="#166534">11.4 km²</text>
    <text x="730" y="110" text-anchor="middle" font-family="Arial, sans-serif" font-size="18" fill="#14532d">城市更新与控规深度</text>
    <text x="730" y="140" text-anchor="middle" font-family="Arial, sans-serif" font-size="18" fill="#14532d">L3-L4道路改造详细设计</text>
    <text x="730" y="165" text-anchor="middle" font-family="Arial, sans-serif" font-size="16" fill="#64748b">85%道路专网 | 120处站点</text>
    
    <!-- Arrow -->
    <line x1="940" y1="90" x2="1040" y2="90" stroke="#16a34a" stroke-width="4"/>
    <polygon points="1040,90 1030,80 1030,100" fill="#16a34a"/>
    
    <!-- Level 3: Key Areas -->
    <rect x="1040" y="0" width="420" height="180" rx="16" fill="#fef3c7" stroke="#d97706" stroke-width="4"/>
    <text x="1250" y="40" text-anchor="middle" font-family="Arial, sans-serif" font-size="28" font-weight="bold" fill="#b45309">重点区域范围</text>
    <text x="1250" y="75" text-anchor="middle" font-family="Arial, sans-serif" font-size="22" fill="#92400e">368.4 ha</text>
    <text x="1250" y="110" text-anchor="middle" font-family="Arial, sans-serif" font-size="18" fill="#78350f">三处片区详细设计</text>
    <text x="1250" y="140" text-anchor="middle" font-family="Arial, sans-serif" font-size="18" fill="#78350f">差异化自动驾驶场景</text>
    <text x="1250" y="165" text-anchor="middle" font-family="Arial, sans-serif" font-size="16" fill="#64748b">众智园 | AI原点 | 大钟寺</text>
  </g>
  
  <!-- Spatial structure diagram -->
  <g transform="translate(120, 500)">
    <rect x="0" y="0" width="1400" height="200" rx="16" fill="#1e293b"/>
    
    <!-- North-South autonomous spine -->
    <rect x="650" y="20" width="100" height="160" rx="8" fill="#22d3ee"/>
    <text x="700" y="90" text-anchor="middle" font-family="Arial, sans-serif" font-size="16" font-weight="bold" fill="#0e7490">京张</text>
    <text x="700" y="115" text-anchor="middle" font-family="Arial, sans-serif" font-size="16" font-weight="bold" fill="#0e7490">智行</text>
    <text x="700" y="165" text-anchor="middle" font-family="Arial, sans-serif" font-size="12" fill="#94a3b8">主廊道</text>
    
    <!-- Key areas -->
    <circle cx="300" cy="100" r="60" fill="#0284c7" opacity="0.8"/>
    <text x="300" y="95" text-anchor="middle" font-family="Arial, sans-serif" font-size="18" font-weight="bold" fill="#ffffff">众智园</text>
    <text x="300" y="120" text-anchor="middle" font-family="Arial, sans-serif" font-size="14" fill="#e0f2fe">AI自主创新</text>
    
    <circle cx="700" cy="100" r="50" fill="#16a34a" opacity="0.8"/>
    <text x="700" y="95" text-anchor="middle" font-family="Arial, sans-serif" font-size="16" font-weight="bold" fill="#ffffff">AI原点</text>
    <text x="700" y="115" text-anchor="middle" font-family="Arial, sans-serif" font-size="12" fill="#dcfce7">社区</text>
    
    <circle cx="1100" cy="100" r="50" fill="#d97706" opacity="0.8"/>
    <text x="1100" y="95" text-anchor="middle" font-family="Arial, sans-serif" font-size="16" font-weight="bold" fill="#ffffff">大钟寺</text>
    <text x="1100" y="115" text-anchor="middle" font-family="Arial, sans-serif" font-size="12" fill="#fef3c7">产业聚集</text>
    
    <!-- Connection lines -->
    <line x1="360" y1="100" x2="650" y2="100" stroke="#94a3b8" stroke-width="3" stroke-dasharray="10,5"/>
    <line x1="750" y1="100" x2="1050" y2="100" stroke="#94a3b8" stroke-width="3" stroke-dasharray="10,5"/>
  </g>
  
  <text x="112" y="760" font-family="Arial, sans-serif" font-size="20" fill="#475569">数据来源: provisional_boundaries.geojson | 空间结构: roads.geojson | 面积: metrics.json</text>
</svg>
