<?xml version="1.0" encoding="UTF-8"?>
<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 1640 840">
  <rect width="1640" height="840" fill="#f8fafc"/>
  <rect x="56" y="56" width="1528" height="728" rx="32" fill="#ffffff" stroke="#cbd5e1" stroke-width="2"/>
  <text x="112" y="140" font-family="Arial, sans-serif" font-size="48" font-weight="bold" fill="#111827">资料证据链与提交包</text>
  <text x="112" y="200" font-family="Arial, sans-serif" font-size="28" fill="#64748b">边界状态: provisional | 主体文本: proposal.md | 证据层: JSON/GeoJSON</text>
  
  <!-- Evidence chain visualization -->
  <g transform="translate(120, 280)">
    <rect x="0" y="0" width="200" height="120" rx="12" fill="#e0f2fe" stroke="#0284c7" stroke-width="3"/>
    <text x="100" y="45" text-anchor="middle" font-family="Arial, sans-serif" font-size="22" font-weight="bold" fill="#0369a1">公告任务</text>
    <text x="100" y="75" text-anchor="middle" font-family="Arial, sans-serif" font-size="16" fill="#075985">1.3/1.4/1.5</text>
    <text x="100" y="100" text-anchor="middle" font-family="Arial, sans-serif" font-size="16" fill="#075985">agent taskbook</text>
    
    <line x1="200" y1="60" x2="280" y2="60" stroke="#0284c7" stroke-width="3" stroke-dasharray="8,4"/>
    <polygon points="280,60 270,55 270,65" fill="#0284c7"/>
    
    <rect x="280" y="0" width="200" height="120" rx="12" fill="#dcfce7" stroke="#16a34a" stroke-width="3"/>
    <text x="380" y="45" text-anchor="middle" font-family="Arial, sans-serif" font-size="22" font-weight="bold" fill="#15803d">Provisional边界</text>
    <text x="380" y="75" text-anchor="middle" font-family="Arial, sans-serif" font-size="16" fill="#166534">site_boundary</text>
    <text x="380" y="100" text-anchor="middle" font-family="Arial, sans-serif" font-size="16" fill="#166534">key_areas</text>
    
    <line x1="480" y1="60" x2="560" y2="60" stroke="#16a34a" stroke-width="3" stroke-dasharray="8,4"/>
    <polygon points="560,60 550,55 550,65" fill="#16a34a"/>
    
    <rect x="560" y="0" width="200" height="120" rx="12" fill="#fef3c7" stroke="#d97706" stroke-width="3"/>
    <text x="660" y="45" text-anchor="middle" font-family="Arial, sans-serif" font-size="22" font-weight="bold" fill="#b45309">设计图层</text>
    <text x="660" y="75" text-anchor="middle" font-family="Arial, sans-serif" font-size="16" fill="#92400e">land_use</text>
    <text x="660" y="100" text-anchor="middle" font-family="Arial, sans-serif" font-size="16" fill="#92400e">roads/buildings</text>
    
    <line x1="760" y1="60" x2="840" y2="60" stroke="#d97706" stroke-width="3" stroke-dasharray="8,4"/>
    <polygon points="840,60 830,55 830,65" fill="#d97706"/>
    
    <rect x="840" y="0" width="200" height="120" rx="12" fill="#fce7f3" stroke="#db2777" stroke-width="3"/>
    <text x="940" y="45" text-anchor="middle" font-family="Arial, sans-serif" font-size="22" font-weight="bold" fill="#be185d">指标复算</text>
    <text x="940" y="75" text-anchor="middle" font-family="Arial, sans-serif" font-size="16" fill="#9d174d">metrics.json</text>
    <text x="940" y="100" text-anchor="middle" font-family="Arial, sans-serif" font-size="16" fill="#9d174d">autonomous_ratio</text>
    
    <line x1="1040" y1="60" x2="1120" y2="60" stroke="#db2777" stroke-width="3" stroke-dasharray="8,4"/>
    <polygon points="1120,60 1110,55 1110,65" fill="#db2777"/>
    
    <rect x="1120" y="0" width="200" height="120" rx="12" fill="#ede9fe" stroke="#7c3aed" stroke-width="3"/>
    <text x="1220" y="45" text-anchor="middle" font-family="Arial, sans-serif" font-size="22" font-weight="bold" fill="#6d28d9">自检验证</text>
    <text x="1220" y="75" text-anchor="middle" font-family="Arial, sans-serif" font-size="16" fill="#5b21b6">self_check.json</text>
    <text x="1220" y="100" text-anchor="middle" font-family="Arial, sans-serif" font-size="16" fill="#5b21b6">PASS all checks</text>
  </g>
  
  <!-- Autonomous transit concept -->
  <g transform="translate(120, 480)">
    <rect x="0" y="0" width="360" height="200" rx="16" fill="#1e293b" stroke="#334155" stroke-width="2"/>
    <text x="180" y="40" text-anchor="middle" font-family="Arial, sans-serif" font-size="26" font-weight="bold" fill="#ffffff">核心创新</text>
    <text x="180" y="80" text-anchor="middle" font-family="Arial, sans-serif" font-size="20" fill="#94a3b8">L3-L4自动驾驶专网</text>
    <text x="180" y="115" text-anchor="middle" font-family="Arial, sans-serif" font-size="20" fill="#94a3b8">禁止普通私家车</text>
    <text x="180" y="150" text-anchor="middle" font-family="Arial, sans-serif" font-size="20" fill="#22d3ee">自动驾驶巴士摆渡</text>
    <text x="180" y="185" text-anchor="middle" font-family="Arial, sans-serif" font-size="16" fill="#64748b">85%道路改造 | 120处站点 | 200m覆盖</text>
  </g>
  
  <g transform="translate(540, 480)">
    <rect x="0" y="0" width="360" height="200" rx="16" fill="#ffffff" stroke="#e2e8f0" stroke-width="2"/>
    <text x="180" y="40" text-anchor="middle" font-family="Arial, sans-serif" font-size="26" font-weight="bold" fill="#1e293b">Track 赛道</text>
    <circle cx="90" cy="100" r="35" fill="#0284c7"/>
    <text x="90" y="105" text-anchor="middle" font-family="Arial, sans-serif" font-size="14" font-weight="bold" fill="#ffffff">AI+交通</text>
    <circle cx="270" cy="100" r="35" fill="#7c3aed"/>
    <text x="270" y="105" text-anchor="middle" font-family="Arial, sans-serif" font-size="14" font-weight="bold" fill="#ffffff">机器人</text>
    <text x="180" y="170" text-anchor="middle" font-family="Arial, sans-serif" font-size="18" fill="#64748b">ai-traffic-walkability</text>
    <text x="180" y="195" text-anchor="middle" font-family="Arial, sans-serif" font-size="18" fill="#64748b">robotics-autonomous-mobility</text>
  </g>
  
  <g transform="translate(960, 480)">
    <rect x="0" y="0" width="360" height="200" rx="16" fill="#ffffff" stroke="#e2e8f0" stroke-width="2"/>
    <text x="180" y="40" text-anchor="middle" font-family="Arial, sans-serif" font-size="26" font-weight="bold" fill="#1e293b">边界状态</text>
    <rect x="30" y="70" width="300" height="50" rx="8" fill="#fef3c7"/>
    <text x="180" y="102" text-anchor="middle" font-family="Arial, sans-serif" font-size="18" fill="#b45309">⚠ Provisional 临时边界</text>
    <text x="180" y="145" text-anchor="middle" font-family="Arial, sans-serif" font-size="16" fill="#64748b">需待官方边界发布后重算</text>
    <text x="180" y="175" text-anchor="middle" font-family="Arial, sans-serif" font-size="14" fill="#94a3b8">不得作为official redline依据</text>
  </g>
  
  <text x="112" y="760" font-family="Arial, sans-serif" font-size="20" fill="#475569">由提交包 GeoJSON、metrics.json、矩阵与自检结果派生；不得替代 official boundary 或专业图纸。</text>
</svg>
