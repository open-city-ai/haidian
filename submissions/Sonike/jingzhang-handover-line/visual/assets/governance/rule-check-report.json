  },
  {
   "rule_id": "R2_HUMAN_FLOOR_FIRST",
   "statement_zh": "人工等价服务必须先于智能层存在，且至少一条渠道在智能层关闭时仍可用"
  },
  {
   "rule_id": "R3_BLOCKING_ITEM_HOLDS_SMART_LAYER_OFF",
   "statement_zh": "存在未闭合的阻塞性未决项时，智能层必须保持关闭"
  },
  {
   "rule_id": "R4_NO_TRIAL_WITHOUT_OBSERVED_ROLLBACK",
   "statement_zh": "回滚演练未被观察到通过前，不得进入限定试用"
  },
  {
   "rule_id": "R5_SYNTHETIC_MUST_NOT_TOUCH_LIVE",
