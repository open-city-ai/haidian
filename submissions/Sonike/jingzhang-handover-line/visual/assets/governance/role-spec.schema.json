{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/jingzhang-handover-line/role-spec.schema.json",
  "title": "Handover role specification",
  "description": "A transferable specification for the accountable roles the Handover Line needs, written as role categories rather than named organisations. Every entry keeps assignment_status = unassigned: the specification says what a future authorised party must be able to do, it does not claim that any party has agreed, been appointed or been contracted.",
  "type": "object",
  "additionalProperties": false,
  "required": ["spec_version", "assignment_notice", "roles"],
  "properties": {
    "spec_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+$",
      "description": "Version of this specification, independent of the submission version."
    },
    "assignment_notice": {
      "type": "string",
      "minLength": 60,
      "description": "Standing notice that no role in this file is assigned, and that assignment rests with the competent authorities."
    },
    "roles": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/role" }
    }
  },
  "$defs": {
    "role": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "role_id",
        "role_category_zh",
        "role_category_en",
        "assignment_status",
        "minimum_qualification",
        "duty_boundary",
        "coverage",
        "authority",
        "two_person_review",
        "conflict_escalation",
        "handover_evidence",
        "prohibition_when_unstaffed"
      ],
      "properties": {
        "role_id": {
          "type": "string",
          "pattern": "^R-[A-Z0-9-]{3,28}$",
          "description": "Stable identifier referenced from proposal.md, metrics.json and the measurement protocol."
        },
        "role_category_zh": { "type": "string", "minLength": 2 },
        "role_category_en": { "type": "string", "minLength": 2 },
        "assignment_status": {
          "const": "unassigned",
          "description": "Always unassigned. A specification is not an appointment."
        },
        "minimum_qualification": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 4 },
          "description": "Capability or licence classes the role must hold, stated as categories, never as a named holder."
        },
        "duty_boundary": {
          "type": "object",
          "additionalProperties": false,
          "required": ["may_decide", "may_not_decide"],
          "properties": {
            "may_decide": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 4 } },
            "may_not_decide": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 4 } }
          }
        },
        "coverage": {
          "type": "object",
          "additionalProperties": false,
          "required": ["pattern", "unattended_fallback"],
          "properties": {
            "pattern": {
              "type": "string",
              "enum": [
                "staffed_opening_hours",
                "staffed_during_test_window",
                "on_call_with_named_deputy_role",
                "scheduled_visit_with_public_timetable",
                "event_duration_only"
              ]
            },
            "unattended_fallback": { "type": "string", "minLength": 8 }
          }
        },
        "authority": {
          "type": "object",
          "additionalProperties": false,
          "required": ["may_start", "may_stop", "stop_is_unilateral"],
          "properties": {
            "may_start": { "type": "boolean" },
            "may_stop": { "type": "boolean" },
            "stop_is_unilateral": {
              "type": "boolean",
              "description": "True when this role can stop a scenario without another party's agreement."
            }
          }
        },
        "two_person_review": {
          "type": "object",
          "additionalProperties": false,
          "required": ["required_for", "second_reviewer_role"],
          "properties": {
            "required_for": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 4 } },
            "second_reviewer_role": {
              "type": "string",
              "pattern": "^R-[A-Z0-9-]{3,28}$",
              "description": "Role id of the independent second reviewer; must differ from role_id."
            }
          }
        },
        "conflict_escalation": {
          "type": "array",
          "minItems": 2,
          "items": { "type": "string", "minLength": 4 },
          "description": "Ordered escalation path when two roles disagree; the last step must return the decision to people."
        },
        "handover_evidence": {
          "type": "array",
          "minItems": 2,
          "items": { "type": "string", "minLength": 4 },
          "description": "What must physically or digitally change hands when this role hands over a shift."
        },
        "prohibition_when_unstaffed": {
          "type": "string",
          "minLength": 10,
          "description": "What must not open, run or expand while this role is unfilled."
        }
      }
    }
  }
}
