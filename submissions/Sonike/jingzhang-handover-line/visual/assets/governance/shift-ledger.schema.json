{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:jingzhang:sonike:dual-control-shift-ledger:0.1.0",
  "title": "双联交接账 / Dual-Control Shift Ledger — sandbox profile",
  "description": "A closed-shape, machine-checkable ledger for a bounded civic-AI shift change. This profile permits synthetic, disconnected sandbox evidence only and requires two distinct control roles.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "protocol_version",
    "ledger_id",
    "scenario_anchor",
    "operating_envelope",
    "control_pair",
    "transfer_attempt",
    "human_service_floor",
    "rollback_rehearsal",
    "evidence_snapshot",
    "unresolved_register",
    "use_notice"
  ],
  "properties": {
    "protocol_version": {
      "const": "0.1.0"
    },
    "ledger_id": {
      "type": "string",
      "pattern": "^DCSL-SCN-[0-9]{2}-[A-Z0-9][A-Z0-9-]{2,31}$"
    },
    "scenario_anchor": {
      "$ref": "#/$defs/scenarioAnchor"
    },
    "operating_envelope": {
      "$ref": "#/$defs/operatingEnvelope"
    },
    "control_pair": {
      "$ref": "#/$defs/controlPair"
    },
    "transfer_attempt": {
      "$ref": "#/$defs/transferAttempt"
    },
    "human_service_floor": {
      "$ref": "#/$defs/humanServiceFloor"
    },
    "rollback_rehearsal": {
      "$ref": "#/$defs/rollbackRehearsal"
    },
    "evidence_snapshot": {
      "$ref": "#/$defs/evidenceSnapshot"
    },
    "unresolved_register": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/unresolvedItem"
      }
    },
    "use_notice": {
      "$ref": "#/$defs/useNotice"
    }
  },
  "$defs": {
    "scenarioAnchor": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scenario_id",
        "label_zh",
        "label_en",
        "district_segment",
        "geometry_pointer",
        "geometry_role",
        "confidence",
        "site_status"
      ],
      "properties": {
        "scenario_id": {
          "type": "string",
          "pattern": "^SCN-[0-9]{2}$"
        },
        "label_zh": {
          "type": "string",
          "minLength": 1
        },
        "label_en": {
          "type": "string",
          "minLength": 1
        },
        "district_segment": {
          "type": "string",
          "minLength": 1
        },
        "geometry_pointer": {
          "type": "string",
          "pattern": "^geometry/[A-Za-z0-9._/-]+#SCN-[0-9]{2}$"
        },
        "geometry_role": {
          "enum": [
            "design_proposal",
            "verified_existing"
          ]
        },
        "confidence": {
          "enum": [
            "low",
            "medium",
            "high"
          ]
        },
        "site_status": {
          "enum": [
            "pending_official_and_field_confirmation",
            "field_checked",
            "officially_confirmed"
          ]
        }
      }
    },
    "operatingEnvelope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "run_mode",
        "record_origin",
        "contains_personal_data",
        "touches_live_service",
        "allowed_io",
        "forbidden_effects",
        "synthetic_record_disposal"
      ],
      "properties": {
        "run_mode": {
          "const": "sandbox_only"
        },
        "record_origin": {
          "const": "synthetic"
        },
        "contains_personal_data": {
          "const": false
        },
        "touches_live_service": {
          "const": false
        },
        "allowed_io": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "forbidden_effects": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "synthetic_record_disposal": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "trigger",
            "verification_method",
            "retained_material"
          ],
          "properties": {
            "trigger": {
              "type": "string",
              "minLength": 1
            },
            "verification_method": {
              "type": "string",
              "minLength": 1
            },
            "retained_material": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      }
    },
    "roleSlot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "role_code",
        "role_name_zh",
        "assignment_state",
        "attestation_state",
        "attestation_at"
      ],
      "properties": {
        "role_code": {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9_]{2,47}$"
        },
        "role_name_zh": {
          "type": "string",
          "minLength": 1
        },
        "assignment_state": {
          "enum": [
            "unassigned_concept_role",
            "appointed"
          ]
        },
        "attestation_state": {
          "enum": [
            "not_requested",
            "pending",
            "recorded"
          ]
        },
        "attestation_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        }
      }
    },
    "controlPair": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "separation_rule",
        "same_person_permitted",
        "release_role",
        "receive_role",
        "pair_state"
      ],
      "properties": {
        "separation_rule": {
          "const": "release_and_receive_require_distinct_role_holders"
        },
        "same_person_permitted": {
          "const": false
        },
        "release_role": {
          "$ref": "#/$defs/roleSlot"
        },
        "receive_role": {
          "$ref": "#/$defs/roleSlot"
        },
        "pair_state": {
          "enum": [
            "incomplete",
            "ready_for_joint_review",
            "jointly_attested"
          ]
        }
      }
    },
    "transferAttempt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "attempt_id",
        "offered_object",
        "requested_transition",
        "decision_authority",
        "receiver_disposition",
        "refusal_reasons",
        "smart_layer_state_after_decision",
        "reconsideration_triggers",
        "recorded_at"
      ],
      "properties": {
        "attempt_id": {
          "type": "string",
          "pattern": "^TA-[A-Z0-9-]{4,48}$"
        },
        "offered_object": {
          "type": "string",
          "minLength": 1
        },
        "requested_transition": {
          "enum": [
            "off_to_sandbox_review",
            "sandbox_review_to_limited_trial"
          ]
        },
        "decision_authority": {
          "enum": [
            "protocol_default",
            "authorized_human_pair"
          ]
        },
        "receiver_disposition": {
          "enum": [
            "accepted",
            "accepted_with_conditions",
            "refused",
            "deferred"
          ]
        },
        "refusal_reasons": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[A-Z][A-Z0-9_]{2,63}$",
            "enum": [
              "DUAL_ROLE_NOT_APPOINTED",
              "HUMAN_FLOOR_NOT_PROVEN",
              "PUBLIC_INTEREST_REVIEW_PENDING",
              "ROLLBACK_REHEARSAL_NOT_OBSERVED",
              "SITE_AUTHORITY_NOT_GRANTED"
            ],
            "description_zh": "拒收或暂缓的理由码。2026-08-22 由自由字符串收紧为固定枚举：本包的模型影子测试（SHADOW-F1）实测发现，同一套协议交给独立判断者时，约 5 个概念被拼成 14 个不同码（单是「场地未确认」就有 4 种拼法），使「按理由分类公布拒收分布」这件事失效。五个码与协议的四道阻断门＋人工兜底一一对应，见本文件 refusal_reason_catalog。"
          }
        },
        "smart_layer_state_after_decision": {
          "enum": [
            "off",
            "sandbox_preview",
            "limited_trial"
          ]
        },
        "reconsideration_triggers": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "recorded_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "receiver_disposition": {
                "const": "refused"
              }
            },
            "required": [
              "receiver_disposition"
            ]
          },
          "then": {
            "properties": {
              "smart_layer_state_after_decision": {
                "enum": [
                  "off"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "receiver_disposition": {
                "const": "deferred"
              }
            },
            "required": [
              "receiver_disposition"
            ]
          },
          "then": {
            "properties": {
              "smart_layer_state_after_decision": {
                "enum": [
                  "off"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "receiver_disposition": {
                "const": "accepted_with_conditions"
              }
            },
            "required": [
              "receiver_disposition"
            ]
          },
          "then": {
            "properties": {
              "smart_layer_state_after_decision": {
                "enum": [
                  "off",
                  "sandbox_preview"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "receiver_disposition": {
                "const": "accepted"
              }
            },
            "required": [
              "receiver_disposition"
            ]
          },
          "then": {
            "properties": {
              "smart_layer_state_after_decision": {
                "enum": [
                  "off",
                  "sandbox_preview",
                  "limited_trial"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "receiver_disposition": {
                "const": "refused"
              }
            },
            "required": [
              "receiver_disposition"
            ]
          },
          "then": {
            "properties": {
              "refusal_reasons": {
                "minItems": 1
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "receiver_disposition": {
                "enum": [
                  "accepted",
                  "accepted_with_conditions"
                ]
              }
            },
            "required": [
              "receiver_disposition"
            ]
          },
          "then": {
            "properties": {
              "refusal_reasons": {
                "maxItems": 0
              }
            }
          }
        }
      ]
    },
    "serviceChannel": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "channel_id",
        "method_zh",
        "method_en",
        "continuity_rule",
        "proof_state"
      ],
      "properties": {
        "channel_id": {
          "type": "string",
          "pattern": "^HF-[0-9]{2}$"
        },
        "method_zh": {
          "type": "string",
          "minLength": 1
        },
        "method_en": {
          "type": "string",
          "minLength": 1
        },
        "continuity_rule": {
          "enum": [
            "available_while_smart_layer_is_off",
            "available_before_during_and_after_smart_layer"
          ]
        },
        "proof_state": {
          "enum": [
            "not_observed",
            "observed"
          ]
        }
      }
    },
    "humanServiceFloor": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "floor_rule_zh",
        "must_exist_before_smart_layer",
        "device_free_access",
        "service_owner_role",
        "channels",
        "shutdown_triggers"
      ],
      "properties": {
        "floor_rule_zh": {
          "type": "string",
          "minLength": 1
        },
        "must_exist_before_smart_layer": {
          "const": true
        },
        "device_free_access": {
          "const": true
        },
        "service_owner_role": {
          "type": "string",
          "minLength": 1
        },
        "channels": {
          "type": "array",
          "minItems": 2,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/serviceChannel"
          }
        },
        "shutdown_triggers": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "rehearsalStep": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "step_no",
        "actor_role_code",
        "action_zh"
      ],
      "properties": {
        "step_no": {
          "type": "integer",
          "minimum": 1
        },
        "actor_role_code": {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9_]{2,47}$"
        },
        "action_zh": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "rollbackRehearsal": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "drill_id",
        "drill_mode",
        "trigger_fixture_zh",
        "expected_sequence",
        "target_state_zh",
        "execution_state",
        "executed_at",
        "elapsed_seconds",
        "pass",
        "evidence_pointer"
      ],
      "properties": {
        "drill_id": {
          "type": "string",
          "pattern": "^RB-SCN-[0-9]{2}-[A-Z0-9-]{3,32}$"
        },
        "drill_mode": {
          "const": "synthetic_tabletop"
        },
        "trigger_fixture_zh": {
          "type": "string",
          "minLength": 1
        },
        "expected_sequence": {
          "type": "array",
          "minItems": 3,
          "items": {
            "$ref": "#/$defs/rehearsalStep"
          }
        },
        "target_state_zh": {
          "type": "string",
          "minLength": 1
        },
        "execution_state": {
          "enum": [
            "specified_not_run",
            "observed_pass",
            "observed_fail"
          ]
        },
        "executed_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "elapsed_seconds": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "pass": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "evidence_pointer": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "execution_state": {
                "const": "specified_not_run"
              }
            },
            "required": [
              "execution_state"
            ]
          },
          "then": {
            "properties": {
              "executed_at": {
                "const": null
              },
              "elapsed_seconds": {
                "const": null
              },
              "pass": {
                "const": null
              },
              "evidence_pointer": {
                "const": null
              }
            }
          }
        }
      ]
    },
    "performanceResult": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "synthetic_routes_checked",
        "unsafe_guidance_count",
        "human_floor_available"
      ],
      "properties": {
        "synthetic_routes_checked": {
          "type": "integer",
          "minimum": 0
        },
        "unsafe_guidance_count": {
          "type": "integer",
          "minimum": 0
        },
        "human_floor_available": {
          "type": "boolean"
        }
      }
    },
    "evidenceSnapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "human_route_verification",
        "professional_accessibility_review",
        "performance_results",
        "evidence_scope_zh",
        "evidence_recorded_at"
      ],
      "properties": {
        "human_route_verification": {
          "enum": [
            "not_started",
            "incomplete",
            "complete"
          ]
        },
        "professional_accessibility_review": {
          "enum": [
            "not_started",
            "incomplete",
            "complete"
          ]
        },
        "performance_results": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/performanceResult"
            }
          ]
        },
        "evidence_scope_zh": {
          "type": "string",
          "minLength": 1
        },
        "evidence_recorded_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        }
      }
    },
    "unresolvedItem": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "item_id",
        "category",
        "blocking",
        "statement_zh",
        "accountable_role",
        "closure_proof",
        "state"
      ],
      "properties": {
        "item_id": {
          "type": "string",
          "pattern": "^OPEN-[0-9]{2}$"
        },
        "category": {
          "enum": [
            "site",
            "authority",
            "accessibility",
            "rollback",
            "performance",
            "data"
          ]
        },
        "blocking": {
          "type": "boolean"
        },
        "statement_zh": {
          "type": "string",
          "minLength": 1
        },
        "accountable_role": {
          "type": "string",
          "minLength": 1
        },
        "closure_proof": {
          "type": "string",
          "minLength": 1
        },
        "state": {
          "enum": [
            "open",
            "closed"
          ]
        }
      }
    },
    "useNotice": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "classification",
        "not_an_approval",
        "excluded_claims",
        "data_notice_zh"
      ],
      "properties": {
        "classification": {
          "const": "concept_protocol_fixture"
        },
        "not_an_approval": {
          "const": true
        },
        "excluded_claims": {
          "type": "array",
          "minItems": 4,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "data_notice_zh": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  },
  "refusal_reason_catalog": {
    "note_zh": "拒收／暂缓理由码的唯一权威清单。任何新增码必须先进本目录与 transferAttempt.refusal_reasons.items.enum，两处同时改；脚本按本目录逐条校验，两处分岔即报错。",
    "note_en": "The single authoritative list of refusal/deferral reason codes. A new code must enter this catalogue and the enum together; the checker compares both and fails on divergence.",
    "codes": [
      {
        "code": "DUAL_ROLE_NOT_APPOINTED",
        "meaning_zh": "双联两侧角色未指派——任一侧 `assignment_state` 为 unassigned_concept_role"
      },
      {
        "code": "HUMAN_FLOOR_NOT_PROVEN",
        "meaning_zh": "人工服务底线未验证——`human_service_floor.proof_state` 为 not_observed，而 must_exist_before_smart_layer 为 true"
      },
      {
        "code": "PUBLIC_INTEREST_REVIEW_PENDING",
        "meaning_zh": "公共利益复核未完成——人工路径复核或无障碍专业复核不是 complete"
      },
      {
        "code": "ROLLBACK_REHEARSAL_NOT_OBSERVED",
        "meaning_zh": "回滚演练未实际执行——`rollback_rehearsal.execution_state` 不是 observed_pass"
      },
      {
        "code": "SITE_AUTHORITY_NOT_GRANTED",
        "meaning_zh": "场地授权未取得——`site_authority.status` 不是 officially_confirmed"
      }
    ],
    "count": 5,
    "provenance_zh": "四个阻断门码取自随包 12 条账的实际取值（各 12 次）；第五个 HUMAN_FLOOR_NOT_PROVEN 取自影子测试 P4 档的确定性基准，SHADOW-F3 指出协议此前记录的四个码里没有任何一个对应「人工兜底未验证」，本次一并补入。"
  },
  "disposition_smart_layer_compatibility": {
    "note_zh": "接收结论与决定后智能层状态的兼容表。**这张表此前不存在**——schema 只强制了 refused ⇒ off 一条，其余三种处置对智能层没有任何约束，因此「附条件接受」在结构上可以直接跳到 limited_trial。2026-08-22 按 fail-closed 原则补齐并逐条强制：处置越保守，智能层上限越低；拒收与暂缓一律 off。",
    "note_en": "Compatibility table between the receiving conclusion and the smart-layer state after the decision. Only refused implies off was enforced before; the other three dispositions were unconstrained. Completed and enforced on 2026-08-22 on a fail-closed basis.",
    "table": [
      {
        "receiver_disposition": "refused",
        "permitted_smart_layer_state_after_decision": [
          "off"
        ]
      },
      {
        "receiver_disposition": "deferred",
        "permitted_smart_layer_state_after_decision": [
          "off"
        ]
      },
      {
        "receiver_disposition": "accepted_with_conditions",
        "permitted_smart_layer_state_after_decision": [
          "off",
          "sandbox_preview"
        ]
      },
      {
        "receiver_disposition": "accepted",
        "permitted_smart_layer_state_after_decision": [
          "off",
          "sandbox_preview",
          "limited_trial"
        ]
      }
    ],
    "invariant_zh": "refusal_reasons 非空 ⟺ receiver_disposition ∈ {refused, deferred}；任一阻断门未满足时 smart_layer_state_after_decision 必须为 off。",
    "pair_count": 7
  }
}
