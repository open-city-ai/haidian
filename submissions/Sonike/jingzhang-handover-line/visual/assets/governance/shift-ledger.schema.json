{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:jingzhang:sonike:dual-control-shift-ledger:0.1.0",
  "title": "双联交接账 / Dual-Control Shift Ledger — sandbox profile",
  "description": "A closed-shape, machine-checkable ledger for a bounded civic-AI shift change. This profile permits synthetic, disconnected sandbox evidence only and requires two distinct control roles.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "protocol_version",
    "ledger_id",
    "scenario_anchor",
    "operating_envelope",
    "control_pair",
    "transfer_attempt",
    "human_service_floor",
    "rollback_rehearsal",
    "evidence_snapshot",
    "unresolved_register",
    "use_notice"
  ],
  "properties": {
    "protocol_version": {
      "const": "0.1.0"
    },
    "ledger_id": {
      "type": "string",
      "pattern": "^DCSL-SCN-[0-9]{2}-[A-Z0-9][A-Z0-9-]{2,31}$"
    },
    "scenario_anchor": {
      "$ref": "#/$defs/scenarioAnchor"
    },
    "operating_envelope": {
      "$ref": "#/$defs/operatingEnvelope"
    },
    "control_pair": {
      "$ref": "#/$defs/controlPair"
    },
    "transfer_attempt": {
      "$ref": "#/$defs/transferAttempt"
    },
    "human_service_floor": {
      "$ref": "#/$defs/humanServiceFloor"
    },
    "rollback_rehearsal": {
      "$ref": "#/$defs/rollbackRehearsal"
    },
    "evidence_snapshot": {
      "$ref": "#/$defs/evidenceSnapshot"
    },
    "unresolved_register": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/unresolvedItem"
      }
    },
    "use_notice": {
      "$ref": "#/$defs/useNotice"
    }
  },
  "$defs": {
    "scenarioAnchor": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scenario_id",
        "label_zh",
        "label_en",
        "district_segment",
        "geometry_pointer",
        "geometry_role",
        "confidence",
        "site_status"
      ],
      "properties": {
        "scenario_id": {
          "type": "string",
          "pattern": "^SCN-[0-9]{2}$"
        },
        "label_zh": {
          "type": "string",
          "minLength": 1
        },
        "label_en": {
          "type": "string",
          "minLength": 1
        },
        "district_segment": {
          "type": "string",
          "minLength": 1
        },
        "geometry_pointer": {
          "type": "string",
          "pattern": "^geometry/[A-Za-z0-9._/-]+#SCN-[0-9]{2}$"
        },
        "geometry_role": {
          "enum": [
            "design_proposal",
            "verified_existing"
          ]
        },
        "confidence": {
          "enum": [
            "low",
            "medium",
            "high"
          ]
        },
        "site_status": {
          "enum": [
            "pending_official_and_field_confirmation",
            "field_checked",
            "officially_confirmed"
          ]
        }
      }
    },
    "operatingEnvelope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "run_mode",
        "record_origin",
        "contains_personal_data",
        "touches_live_service",
        "allowed_io",
        "forbidden_effects",
        "synthetic_record_disposal"
      ],
      "properties": {
        "run_mode": {
          "const": "sandbox_only"
        },
        "record_origin": {
          "const": "synthetic"
        },
        "contains_personal_data": {
          "const": false
        },
        "touches_live_service": {
          "const": false
        },
        "allowed_io": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "forbidden_effects": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "synthetic_record_disposal": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "trigger",
            "verification_method",
            "retained_material"
          ],
          "properties": {
            "trigger": {
              "type": "string",
              "minLength": 1
            },
            "verification_method": {
              "type": "string",
              "minLength": 1
            },
            "retained_material": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      }
    },
    "roleSlot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "role_code",
        "role_name_zh",
        "assignment_state",
        "attestation_state",
        "attestation_at"
      ],
      "properties": {
        "role_code": {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9_]{2,47}$"
        },
        "role_name_zh": {
          "type": "string",
          "minLength": 1
        },
        "assignment_state": {
          "enum": [
            "unassigned_concept_role",
            "appointed"
          ]
        },
        "attestation_state": {
          "enum": [
            "not_requested",
            "pending",
            "recorded"
          ]
        },
        "attestation_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        }
      }
    },
    "controlPair": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "separation_rule",
        "same_person_permitted",
        "release_role",
        "receive_role",
        "pair_state"
      ],
      "properties": {
        "separation_rule": {
          "const": "release_and_receive_require_distinct_role_holders"
        },
        "same_person_permitted": {
          "const": false
        },
        "release_role": {
          "$ref": "#/$defs/roleSlot"
        },
        "receive_role": {
          "$ref": "#/$defs/roleSlot"
        },
        "pair_state": {
          "enum": [
            "incomplete",
            "ready_for_joint_review",
            "jointly_attested"
          ]
        }
      }
    },
    "transferAttempt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "attempt_id",
        "offered_object",
        "requested_transition",
        "decision_authority",
        "receiver_disposition",
        "refusal_reasons",
        "smart_layer_state_after_decision",
        "reconsideration_triggers",
        "recorded_at"
      ],
      "properties": {
        "attempt_id": {
          "type": "string",
          "pattern": "^TA-[A-Z0-9-]{4,48}$"
        },
        "offered_object": {
          "type": "string",
          "minLength": 1
        },
        "requested_transition": {
          "enum": [
            "off_to_sandbox_review",
            "sandbox_review_to_limited_trial"
          ]
        },
        "decision_authority": {
          "enum": [
            "protocol_default",
            "authorized_human_pair"
          ]
        },
        "receiver_disposition": {
          "enum": [
            "accepted",
            "accepted_with_conditions",
            "refused",
            "deferred"
          ]
        },
        "refusal_reasons": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[A-Z][A-Z0-9_]{2,63}$"
          }
        },
        "smart_layer_state_after_decision": {
          "enum": [
            "off",
            "sandbox_preview",
            "limited_trial"
          ]
        },
        "reconsideration_triggers": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "recorded_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "receiver_disposition": {
                "const": "refused"
              }
            },
            "required": [
              "receiver_disposition"
            ]
          },
          "then": {
            "properties": {
              "refusal_reasons": {
                "minItems": 1
              },
              "smart_layer_state_after_decision": {
                "const": "off"
              }
            }
          }
        }
      ]
    },
    "serviceChannel": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "channel_id",
        "method_zh",
        "method_en",
        "continuity_rule",
        "proof_state"
      ],
      "properties": {
        "channel_id": {
          "type": "string",
          "pattern": "^HF-[0-9]{2}$"
        },
        "method_zh": {
          "type": "string",
          "minLength": 1
        },
        "method_en": {
          "type": "string",
          "minLength": 1
        },
        "continuity_rule": {
          "enum": [
            "available_while_smart_layer_is_off",
            "available_before_during_and_after_smart_layer"
          ]
        },
        "proof_state": {
          "enum": [
            "not_observed",
            "observed"
          ]
        }
      }
    },
    "humanServiceFloor": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "floor_rule_zh",
        "must_exist_before_smart_layer",
        "device_free_access",
        "service_owner_role",
        "channels",
        "shutdown_triggers"
      ],
      "properties": {
        "floor_rule_zh": {
          "type": "string",
          "minLength": 1
        },
        "must_exist_before_smart_layer": {
          "const": true
        },
        "device_free_access": {
          "const": true
        },
        "service_owner_role": {
          "type": "string",
          "minLength": 1
        },
        "channels": {
          "type": "array",
          "minItems": 2,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/serviceChannel"
          }
        },
        "shutdown_triggers": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "rehearsalStep": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "step_no",
        "actor_role_code",
        "action_zh"
      ],
      "properties": {
        "step_no": {
          "type": "integer",
          "minimum": 1
        },
        "actor_role_code": {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9_]{2,47}$"
        },
        "action_zh": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "rollbackRehearsal": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "drill_id",
        "drill_mode",
        "trigger_fixture_zh",
        "expected_sequence",
        "target_state_zh",
        "execution_state",
        "executed_at",
        "elapsed_seconds",
        "pass",
        "evidence_pointer"
      ],
      "properties": {
        "drill_id": {
          "type": "string",
          "pattern": "^RB-SCN-[0-9]{2}-[A-Z0-9-]{3,32}$"
        },
        "drill_mode": {
          "const": "synthetic_tabletop"
        },
        "trigger_fixture_zh": {
          "type": "string",
          "minLength": 1
        },
        "expected_sequence": {
          "type": "array",
          "minItems": 3,
          "items": {
            "$ref": "#/$defs/rehearsalStep"
          }
        },
        "target_state_zh": {
          "type": "string",
          "minLength": 1
        },
        "execution_state": {
          "enum": [
            "specified_not_run",
            "observed_pass",
            "observed_fail"
          ]
        },
        "executed_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "elapsed_seconds": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "pass": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "evidence_pointer": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "execution_state": {
                "const": "specified_not_run"
              }
            },
            "required": [
              "execution_state"
            ]
          },
          "then": {
            "properties": {
              "executed_at": {
                "const": null
              },
              "elapsed_seconds": {
                "const": null
              },
              "pass": {
                "const": null
              },
              "evidence_pointer": {
                "const": null
              }
            }
          }
        }
      ]
    },
    "performanceResult": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "synthetic_routes_checked",
        "unsafe_guidance_count",
        "human_floor_available"
      ],
      "properties": {
        "synthetic_routes_checked": {
          "type": "integer",
          "minimum": 0
        },
        "unsafe_guidance_count": {
          "type": "integer",
          "minimum": 0
        },
        "human_floor_available": {
          "type": "boolean"
        }
      }
    },
    "evidenceSnapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "human_route_verification",
        "professional_accessibility_review",
        "performance_results",
        "evidence_scope_zh",
        "evidence_recorded_at"
      ],
      "properties": {
        "human_route_verification": {
          "enum": [
            "not_started",
            "incomplete",
            "complete"
          ]
        },
        "professional_accessibility_review": {
          "enum": [
            "not_started",
            "incomplete",
            "complete"
          ]
        },
        "performance_results": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/performanceResult"
            }
          ]
        },
        "evidence_scope_zh": {
          "type": "string",
          "minLength": 1
        },
        "evidence_recorded_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        }
      }
    },
    "unresolvedItem": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "item_id",
        "category",
        "blocking",
        "statement_zh",
        "accountable_role",
        "closure_proof",
        "state"
      ],
      "properties": {
        "item_id": {
          "type": "string",
          "pattern": "^OPEN-[0-9]{2}$"
        },
        "category": {
          "enum": [
            "site",
            "authority",
            "accessibility",
            "rollback",
            "performance",
            "data"
          ]
        },
        "blocking": {
          "type": "boolean"
        },
        "statement_zh": {
          "type": "string",
          "minLength": 1
        },
        "accountable_role": {
          "type": "string",
          "minLength": 1
        },
        "closure_proof": {
          "type": "string",
          "minLength": 1
        },
        "state": {
          "enum": [
            "open",
            "closed"
          ]
        }
      }
    },
    "useNotice": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "classification",
        "not_an_approval",
        "excluded_claims",
        "data_notice_zh"
      ],
      "properties": {
        "classification": {
          "const": "concept_protocol_fixture"
        },
        "not_an_approval": {
          "const": true
        },
        "excluded_claims": {
          "type": "array",
          "minItems": 4,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "data_notice_zh": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
