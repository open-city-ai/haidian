{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://open-city-ai.example/schemas/jz168-week-v2.json",
  "title": "京张168公共时间表协议 v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "protocol_version",
    "schedule_basis",
    "week_id",
    "timezone",
    "publication_state",
    "disclosure",
    "role_registry_file",
    "scenario_locator_map",
    "slots"
  ],
  "properties": {
    "protocol_version": {
      "const": "2.0.0"
    },
    "schedule_basis": {
      "const": "relative_demonstration_only"
    },
    "week_id": {
      "type": "string",
      "pattern": "^W-[A-Z0-9_-]+$"
    },
    "timezone": {
      "const": "Asia/Shanghai"
    },
    "publication_state": {
      "enum": [
        "draft",
        "public_comment",
        "operator_confirmed",
        "archived"
      ]
    },
    "disclosure": {
      "type": "string",
      "minLength": 1
    },
    "role_registry_file": {
      "const": "governance-raci.json"
    },
    "scenario_locator_map": {
      "type": "object",
      "minProperties": 12,
      "additionalProperties": {
        "type": "string",
        "pattern": "^SCN-(0[1-9]|1[0-2])-[A-Z0-9-]+$"
      }
    },
    "slots": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/slot"
      }
    }
  },
  "$defs": {
    "roleId": {
      "enum": [
        "TO",
        "PTC",
        "SASP",
        "DHL",
        "DS",
        "AO",
        "NL",
        "PA",
        "OPS",
        "IE"
      ]
    },
    "roleIds": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/roleId"
      }
    },
    "pendingNumber": {
      "oneOf": [
        {
          "type": "number",
          "minimum": 0
        },
        {
          "type": "null"
        },
        {
          "const": "pending"
        }
      ]
    },
    "slot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "slot_id",
        "first_168h_stage_id",
        "scenario_ids",
        "locator_ids",
        "booking_segment_ids",
        "key_area_ids",
        "time_component_ids",
        "relative_window",
        "state",
        "state_guard",
        "operator_role",
        "operator_role_ids",
        "affected_people",
        "nonparticipant_impact",
        "non_ai_baseline",
        "human_gate",
        "data_minimum",
        "capacity",
        "budget_cny",
        "slo",
        "stop_restore",
        "evidence_receipt",
        "review",
        "action"
      ],
      "properties": {
        "slot_id": {
          "type": "string"
        },
        "first_168h_stage_id": {
          "type": "string",
          "pattern": "^FS-0[1-9]$"
        },
        "scenario_ids": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "pattern": "^SCN-(0[1-9]|1[0-2])-[A-Z0-9-]+$"
          }
        },
        "locator_ids": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "pattern": "^SCN-(0[1-9]|1[0-2])$"
          }
        },
        "booking_segment_ids": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "pattern": "^BK-0[1-6]-[A-Z0-9-]+$"
          }
        },
        "time_component_ids": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "pattern": "^TC-0[1-7]-[A-Z0-9-]+$"
          }
        },
        "relative_window": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "start_hour",
            "end_hour",
            "label"
          ],
          "properties": {
            "start_hour": {
              "type": "integer",
              "minimum": 0,
              "maximum": 167
            },
            "end_hour": {
              "type": "integer",
              "minimum": 1,
              "maximum": 168
            },
            "label": {
              "type": "string"
            }
          }
        },
        "state": {
          "enum": [
            "proposed",
            "admitted",
            "scheduled",
            "active",
            "paused",
            "returned",
            "audited",
            "archived"
          ]
        },
        "state_guard": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "operator_role": {
          "type": "string"
        },
        "operator_role_ids": {
          "$ref": "#/$defs/roleIds"
        },
        "affected_people": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "nonparticipant_impact": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "non_ai_baseline": {
          "type": "object",
          "required": [
            "available",
            "delivery"
          ],
          "properties": {
            "available": {
              "const": true
            },
            "delivery": {
              "type": "string"
            }
          }
        },
        "human_gate": {
          "type": "object",
          "required": [
            "owner_role",
            "owner_role_ids",
            "decision",
            "record_required",
            "appeal_channel"
          ],
          "properties": {
            "owner_role": {
              "type": "string"
            },
            "owner_role_ids": {
              "$ref": "#/$defs/roleIds"
            },
            "decision": {
              "enum": [
                "pending",
                "approve",
                "reject",
                "pause",
                "return"
              ]
            },
            "record_required": {
              "const": true
            },
            "appeal_channel": {
              "type": "array",
              "minItems": 2,
              "items": {
                "enum": [
                  "onsite_human_counter",
                  "telephone",
                  "paper_form",
                  "accessible_web",
                  "community_representative"
                ]
              }
            }
          }
        },
        "data_minimum": {
          "type": "object",
          "required": [
            "allowed",
            "forbidden",
            "retention",
            "deletion_proof"
          ],
          "properties": {
            "allowed": {
              "type": "array"
            },
            "forbidden": {
              "type": "array",
              "minItems": 1
            },
            "retention": {
              "type": [
                "string",
                "null"
              ]
            },
            "deletion_proof": {
              "type": "boolean"
            }
          }
        },
        "capacity": {
          "$ref": "#/$defs/pendingNumber"
        },
        "budget_cny": {
          "$ref": "#/$defs/pendingNumber"
        },
        "slo": {
          "oneOf": [
            {
              "type": "object"
            },
            {
              "type": "null"
            },
            {
              "type": "string"
            }
          ]
        },
        "stop_restore": {
          "type": "object",
          "required": [
            "stop_triggers",
            "stop_authority",
            "stop_authority_role_ids",
            "authority_channel",
            "safe_state",
            "restore_checklist",
            "restart_authority",
            "restart_authority_role_ids"
          ],
          "properties": {
            "stop_triggers": {
              "type": "array",
              "minItems": 1
            },
            "stop_authority": {
              "type": "array",
              "minItems": 1
            },
            "stop_authority_role_ids": {
              "$ref": "#/$defs/roleIds"
            },
            "authority_channel": {
              "const": "accessible_public_stop_channel"
            },
            "safe_state": {
              "type": "string"
            },
            "restore_checklist": {
              "type": "array",
              "minItems": 1
            },
            "restart_authority": {
              "type": "string"
            },
            "restart_authority_role_ids": {
              "$ref": "#/$defs/roleIds"
            }
          }
        },
        "evidence_receipt": {
          "type": "array",
          "minItems": 2
        },
        "review": {
          "type": "object",
          "required": [
            "date",
            "trigger"
          ],
          "properties": {
            "date": {
              "type": [
                "string",
                "null"
              ]
            },
            "trigger": {
              "type": "array",
              "minItems": 1
            }
          }
        },
        "action": {
          "type": "string"
        },
        "key_area_ids": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "pattern": "^PROV-KEY-00[1-3]$"
          }
        }
      }
    }
  }
}
