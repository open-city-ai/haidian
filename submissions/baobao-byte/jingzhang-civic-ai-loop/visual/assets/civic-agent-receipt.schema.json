{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://open-city-ai.example/schemas/civic-agent-receipt-1.0.json",
  "title": "共智环城市智能体收据 1.0",
  "description": "记录公共系统一次运行及追责链，不记录自然人身份。",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "receipt_id",
    "record_status",
    "scenario_id",
    "system_version",
    "purpose",
    "data_categories",
    "retention",
    "evidence_refs",
    "output_summary",
    "confidence_status",
    "human_accountable_role",
    "handoff_status",
    "incident_status",
    "appeal_channel",
    "expires_at",
    "final_disposition"
  ],
  "properties": {
    "receipt_id": {
      "type": "string",
      "pattern": "^R-[A-Z0-9-]+$"
    },
    "scenario_id": {
      "type": "string"
    },
    "system_version": {
      "type": "string"
    },
    "purpose": {
      "type": "string"
    },
    "data_categories": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1
    },
    "retention": {
      "type": "object",
      "required": [
        "period",
        "deletion_evidence"
      ],
      "properties": {
        "period": {
          "type": "string"
        },
        "deletion_evidence": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "evidence_refs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "output_summary": {
      "type": "string"
    },
    "confidence_status": {
      "enum": [
        "supported",
        "limited",
        "refused"
      ]
    },
    "human_accountable_role": {
      "type": "string"
    },
    "handoff_status": {
      "enum": [
        "not_needed",
        "offered",
        "accepted",
        "completed",
        "failed"
      ]
    },
    "incident_status": {
      "enum": [
        "none",
        "near_miss",
        "harm",
        "under_review"
      ]
    },
    "appeal_channel": {
      "type": "string"
    },
    "appeal_case_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "expires_at": {
      "type": "string",
      "format": "date-time"
    },
    "final_disposition": {
      "enum": [
        "continue_limited",
        "repair",
        "suspend",
        "retire",
        "pending_review"
      ]
    },
    "prohibited_identity_fields": {
      "const": false
    },
    "record_status": {
      "enum": [
        "synthetic_example",
        "operational"
      ]
    },
    "notice": {
      "type": "string"
    }
  }
}
