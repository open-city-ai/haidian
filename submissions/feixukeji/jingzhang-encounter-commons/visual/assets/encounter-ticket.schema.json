{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://open-city.ai/schemas/jingzhang-encounter-ticket-0.2.json",
  "title": "Encounter Ticket 0.2 / 相遇票 0.2",
  "description": "An eight-group minimum operating contract for matching authorised public tasks, spaces, times and resources. It must not encode or infer personal relationships.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "task",
    "access_and_exit",
    "space_time_capacity",
    "minimum_data",
    "human_host",
    "resources",
    "public_output",
    "review_decision"
  ],
  "properties": {
    "task": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "ticket_id",
        "revision",
        "issued_at",
        "public_task_id",
        "title",
        "expires_at",
        "authorisation_status"
      ],
      "properties": {
        "schema_version": {"type": "string", "const": "0.2"},
        "ticket_id": {"type": "string", "pattern": "^[A-Z0-9][A-Z0-9._-]{2,79}$"},
        "revision": {"type": "integer", "minimum": 1},
        "issued_at": {"type": "string", "format": "date-time"},
        "public_task_id": {"type": "string", "pattern": "^[A-Z0-9][A-Z0-9._-]{2,79}$"},
        "title": {"type": "string", "minLength": 1},
        "expires_at": {"type": "string", "format": "date-time"},
        "authorisation_status": {
          "type": "string",
          "enum": ["not_authorized", "authorized", "expired", "withdrawn"]
        }
      }
    },
    "access_and_exit": {
      "type": "object",
      "additionalProperties": false,
      "required": ["entry_mode", "non_ai_equivalent", "accessibility_route", "exit_route"],
      "properties": {
        "entry_mode": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "enum": ["walk_in", "paper_card", "optional_web_list", "telephone", "host_assisted"]
          }
        },
        "non_ai_equivalent": {"$ref": "#/$defs/non_ai_equivalent"},
        "accessibility_route": {"$ref": "#/$defs/route_evidence"},
        "exit_route": {"$ref": "#/$defs/route_evidence"}
      }
    },
    "space_time_capacity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "candidate_space_id",
        "starts_at",
        "ends_at",
        "capacity",
        "status",
        "capacity_evidence_ref"
      ],
      "properties": {
        "candidate_space_id": {"type": "string", "minLength": 1},
        "starts_at": {"type": "string", "format": "date-time"},
        "ends_at": {"type": "string", "format": "date-time"},
        "capacity": {"type": "integer", "minimum": 1},
        "status": {
          "type": "string",
          "enum": ["candidate", "verified", "blocked", "returned"]
        },
        "capacity_evidence_ref": {
          "anyOf": [
            {"type": "string", "minLength": 1},
            {"type": "null"}
          ]
        }
      },
      "allOf": [
        {
          "if": {"properties": {"status": {"const": "verified"}}, "required": ["status"]},
          "then": {"properties": {"capacity_evidence_ref": {"type": "string", "minLength": 1}}}
        }
      ]
    },
    "minimum_data": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "fields",
        "legal_basis_status",
        "legal_basis_ref",
        "delete_by",
        "deletion_receipt_ref",
        "prohibited_fields"
      ],
      "properties": {
        "fields": {
          "type": "array",
          "maxItems": 4,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/minimum_data_field"}
        },
        "legal_basis_status": {
          "type": "string",
          "enum": ["pending", "confirmed", "not_required", "blocked"]
        },
        "legal_basis_ref": {
          "anyOf": [
            {"type": "string", "minLength": 1},
            {"type": "null"}
          ]
        },
        "delete_by": {"type": "string", "format": "date-time"},
        "deletion_receipt_ref": {
          "anyOf": [
            {"type": "string", "minLength": 1},
            {"type": "null"}
          ]
        },
        "prohibited_fields": {
          "type": "array",
          "minItems": 7,
          "maxItems": 7,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "enum": [
              "face",
              "contact_list",
              "precise_trajectory",
              "emotion",
              "health_record",
              "relationship_graph",
              "personal_score"
            ]
          }
        }
      }
    },
    "human_host": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "accountable_slot",
        "duty_holder",
        "stop_authority_role",
        "hard_stop_conditions",
        "accepted"
      ],
      "properties": {
        "accountable_slot": {"type": "string", "minLength": 1},
        "duty_holder": {
          "anyOf": [
            {"type": "string", "minLength": 1},
            {"type": "null"}
          ]
        },
        "stop_authority_role": {"type": "string", "minLength": 1},
        "hard_stop_conditions": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "accepted": {"type": "boolean"}
      }
    },
    "resources": {
      "type": "object",
      "additionalProperties": false,
      "required": ["dependencies", "cost_class"],
      "properties": {
        "dependencies": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "cost_class": {
          "type": "string",
          "enum": ["A_shared_existing", "B_reversible_temporary", "C_professional_works_pending"]
        }
      }
    },
    "public_output": {
      "type": "object",
      "additionalProperties": false,
      "required": ["minimum_output", "artifact_refs", "rights_status", "publication_status"],
      "properties": {
        "minimum_output": {"type": "string", "minLength": 1},
        "artifact_refs": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "rights_status": {
          "type": "string",
          "enum": ["pending", "cleared", "restricted", "withdrawn"]
        },
        "publication_status": {
          "type": "string",
          "enum": ["not_started", "draft", "published", "retired"]
        }
      }
    },
    "review_decision": {
      "type": "object",
      "additionalProperties": false,
      "required": ["complaint_route", "review_due", "decision", "performance_results"],
      "properties": {
        "complaint_route": {"$ref": "#/$defs/complaint_route"},
        "review_due": {"type": "string", "format": "date-time"},
        "decision": {
          "type": "string",
          "enum": ["pending", "adopt", "revise", "retire"]
        },
        "performance_results": {
          "anyOf": [
            {"type": "null"},
            {"$ref": "#/$defs/performance_results"}
          ]
        }
      }
    }
  },
  "$defs": {
    "route_evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "description", "evidence_ref"],
      "properties": {
        "status": {
          "type": "string",
          "enum": ["pending_walkthrough", "verified", "blocked"]
        },
        "description": {
          "anyOf": [
            {"type": "string", "minLength": 1},
            {"type": "null"}
          ]
        },
        "evidence_ref": {
          "anyOf": [
            {"type": "string", "minLength": 1},
            {"type": "null"}
          ]
        }
      },
      "allOf": [
        {
          "if": {"properties": {"status": {"const": "verified"}}, "required": ["status"]},
          "then": {
            "properties": {
              "description": {"type": "string", "minLength": 1},
              "evidence_ref": {"type": "string", "minLength": 1}
            }
          }
        }
      ]
    },
    "non_ai_equivalent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "description", "evidence_ref"],
      "properties": {
        "status": {
          "type": "string",
          "enum": ["pending_test", "verified", "blocked"]
        },
        "description": {"type": "string", "minLength": 1},
        "evidence_ref": {
          "anyOf": [
            {"type": "string", "minLength": 1},
            {"type": "null"}
          ]
        }
      },
      "allOf": [
        {
          "if": {"properties": {"status": {"const": "verified"}}, "required": ["status"]},
          "then": {"properties": {"evidence_ref": {"type": "string", "minLength": 1}}}
        }
      ]
    },
    "complaint_route": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "description", "evidence_ref"],
      "properties": {
        "status": {
          "type": "string",
          "enum": ["pending_authorized_operator_channel", "verified", "blocked"]
        },
        "description": {
          "anyOf": [
            {"type": "string", "minLength": 1},
            {"type": "null"}
          ]
        },
        "evidence_ref": {
          "anyOf": [
            {"type": "string", "minLength": 1},
            {"type": "null"}
          ]
        }
      },
      "allOf": [
        {
          "if": {"properties": {"status": {"const": "verified"}}, "required": ["status"]},
          "then": {
            "properties": {
              "description": {"type": "string", "minLength": 1},
              "evidence_ref": {"type": "string", "minLength": 1}
            }
          }
        }
      ]
    },
    "minimum_data_field": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "purpose", "required", "collection_mode", "sensitivity", "retention"],
      "properties": {
        "name": {
          "type": "string",
          "enum": ["task_role", "language_preference", "access_feature_requested", "time_slot"]
        },
        "purpose": {"type": "string", "minLength": 1},
        "required": {"type": "boolean"},
        "collection_mode": {
          "type": "string",
          "enum": ["anonymous_walk_in", "self_declared_ephemeral", "host_assisted_ephemeral"]
        },
        "sensitivity": {
          "type": "string",
          "enum": ["non_sensitive", "accessibility_sensitive"]
        },
        "retention": {
          "type": "string",
          "enum": ["session_only", "until_delete_by"]
        }
      },
      "allOf": [
        {
          "if": {"properties": {"name": {"const": "access_feature_requested"}}, "required": ["name"]},
          "then": {"properties": {"sensitivity": {"const": "accessibility_sensitive"}}},
          "else": {"properties": {"sensitivity": {"const": "non_sensitive"}}}
        }
      ]
    },
    "performance_results": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "evidence_status",
        "window_start",
        "window_end",
        "sample_size",
        "task_completed_count",
        "task_completion_rate",
        "non_ai_equivalent_attempt_count",
        "non_ai_equivalent_success_rate",
        "complaints_received",
        "complaints_closed",
        "safety_incident_count",
        "privacy_incident_count",
        "human_override_count",
        "recommended_decision",
        "evidence_refs"
      ],
      "properties": {
        "evidence_status": {
          "type": "string",
          "enum": ["synthetic_tabletop", "field_observed", "independently_audited"]
        },
        "window_start": {"type": "string", "format": "date-time"},
        "window_end": {"type": "string", "format": "date-time"},
        "sample_size": {"type": "integer", "minimum": 0},
        "task_completed_count": {"type": "integer", "minimum": 0},
        "task_completion_rate": {
          "anyOf": [
            {"type": "number", "minimum": 0, "maximum": 1},
            {"type": "null"}
          ]
        },
        "non_ai_equivalent_attempt_count": {"type": "integer", "minimum": 0},
        "non_ai_equivalent_success_rate": {
          "anyOf": [
            {"type": "number", "minimum": 0, "maximum": 1},
            {"type": "null"}
          ]
        },
        "complaints_received": {"type": "integer", "minimum": 0},
        "complaints_closed": {"type": "integer", "minimum": 0},
        "safety_incident_count": {"type": "integer", "minimum": 0},
        "privacy_incident_count": {"type": "integer", "minimum": 0},
        "human_override_count": {"type": "integer", "minimum": 0},
        "recommended_decision": {
          "type": "string",
          "enum": ["adopt", "revise", "retire"]
        },
        "evidence_refs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {"human_host": {"properties": {"accepted": {"const": true}}}}
      },
      "then": {
        "properties": {
          "human_host": {"properties": {"duty_holder": {"type": "string", "minLength": 1}}}
        }
      }
    },
    {
      "if": {
        "properties": {
          "task": {"properties": {"authorisation_status": {"const": "authorized"}}}
        }
      },
      "then": {
        "properties": {
          "access_and_exit": {
            "properties": {
              "non_ai_equivalent": {"properties": {"status": {"const": "verified"}}},
              "accessibility_route": {"properties": {"status": {"const": "verified"}}},
              "exit_route": {"properties": {"status": {"const": "verified"}}}
            }
          },
          "space_time_capacity": {"properties": {"status": {"const": "verified"}}},
          "minimum_data": {"properties": {"legal_basis_status": {"const": "confirmed"}}},
          "human_host": {
            "properties": {
              "duty_holder": {"type": "string", "minLength": 1},
              "accepted": {"const": true}
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "space_time_capacity": {"properties": {"status": {"const": "verified"}}}
        }
      },
      "then": {
        "properties": {
          "task": {"properties": {"authorisation_status": {"const": "authorized"}}},
          "human_host": {
            "properties": {
              "duty_holder": {"type": "string", "minLength": 1},
              "accepted": {"const": true}
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "public_output": {"properties": {"publication_status": {"const": "published"}}}
        }
      },
      "then": {
        "properties": {
          "public_output": {
            "properties": {
              "artifact_refs": {"minItems": 1},
              "rights_status": {"enum": ["cleared", "restricted"]}
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "minimum_data": {"properties": {"legal_basis_status": {"const": "confirmed"}}}
        }
      },
      "then": {
        "properties": {
          "minimum_data": {"properties": {"legal_basis_ref": {"type": "string", "minLength": 1}}}
        }
      }
    },
    {
      "if": {
        "properties": {
          "minimum_data": {"properties": {"fields": {"maxItems": 0}}}
        }
      },
      "then": {
        "properties": {
          "minimum_data": {"properties": {"legal_basis_status": {"const": "not_required"}}}
        }
      },
      "else": {
        "properties": {
          "minimum_data": {
            "properties": {"legal_basis_status": {"enum": ["pending", "confirmed", "blocked"]}}
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "review_decision": {"properties": {"decision": {"const": "pending"}}}
        }
      },
      "then": {
        "properties": {
          "review_decision": {"properties": {"performance_results": {"type": "null"}}}
        }
      },
      "else": {
        "properties": {
          "review_decision": {
            "properties": {"performance_results": {"$ref": "#/$defs/performance_results"}}
          }
        }
      }
    },
    {
      "if": {
        "properties": {"review_decision": {"properties": {"decision": {"const": "adopt"}}}}
      },
      "then": {
        "properties": {
          "review_decision": {
            "properties": {
              "performance_results": {"properties": {"recommended_decision": {"const": "adopt"}}}
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {"review_decision": {"properties": {"decision": {"const": "revise"}}}}
      },
      "then": {
        "properties": {
          "review_decision": {
            "properties": {
              "performance_results": {"properties": {"recommended_decision": {"const": "revise"}}}
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {"review_decision": {"properties": {"decision": {"const": "retire"}}}}
      },
      "then": {
        "properties": {
          "review_decision": {
            "properties": {
              "performance_results": {"properties": {"recommended_decision": {"const": "retire"}}}
            }
          }
        }
      }
    }
  ]
}
