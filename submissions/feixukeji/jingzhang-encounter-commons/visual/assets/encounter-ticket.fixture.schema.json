{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://open-city.ai/schemas/jingzhang-encounter-ticket-fixture-0.2.json",
  "title": "Encounter Ticket S01-S03 synthetic fixture envelope 0.2",
  "description": "A machine-readable envelope that prevents synthetic fixtures from being mistaken for authorised or field-observed operations.",
  "type": "object",
  "additionalProperties": false,
  "required": ["synthetic_fixture", "evidence_status", "fixture_version", "tickets"],
  "properties": {
    "synthetic_fixture": {"type": "boolean", "const": true},
    "evidence_status": {
      "type": "string",
      "const": "schema_example_only_not_real_operation"
    },
    "fixture_version": {"type": "string", "const": "0.2"},
    "tickets": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {
        "$ref": "https://open-city.ai/schemas/jingzhang-encounter-ticket-0.2.json"
      }
    }
  }
}
