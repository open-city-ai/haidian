{
  "schema_version": "1.0",
  "concept": "ONE ERROR, EQUAL REMEDY",
  "status": "synthetic_concept_only",
  "public_problem": "A confirmed systemic error is often repaired only for the person who complained, leaving silent co-affected people to rediscover and re-prove the same failure.",
  "five_field_difference": {
    "service_population": "All potentially co-affected people under one frozen version, especially non-complainants, plus frontline workers maintaining ordinary service.",
    "complete_task": [
      "report",
      "pause_and_preserve",
      "human_repeatability_confirmation",
      "freeze_minimum_scope",
      "controlled_candidate_search",
      "human_inclusion_exclusion",
      "refuseable_notice",
      "no_repeat_proof_remedy",
      "omission_false_inclusion_appeal",
      "delete_temporary_links"
    ],
    "spatial_carrier": [
      "ordinary entrance",
      "evidence room",
      "scope review room",
      "equal remedy desk",
      "independent appeal and deletion receipt"
    ],
    "human_rights": [
      "not lose rights by silence",
      "refuse notice",
      "leave temporary candidate link",
      "see reasons",
      "appeal omission or false inclusion"
    ],
    "failure_result": "Keep disputed automation off, preserve original order/time/unresolved matters, continue ordinary human service, and delete temporary links on exit."
  },
  "gates": [
    {
      "id": "G1_REPORT",
      "human": "incident_owner",
      "stop_if": "lead cannot be safely preserved"
    },
    {
      "id": "G2_PRESERVE",
      "human": "incident_owner",
      "stop_if": "version or disputed action cannot be frozen"
    },
    {
      "id": "G3_CONFIRM",
      "human": "independent_professional_reviewer",
      "stop_if": "system error is not repeatable or evidence is insufficient"
    },
    {
      "id": "G4_SCOPE",
      "human": "impact_scope_reviewer",
      "stop_if": "purpose, time window, and minimum fields are unreliable"
    },
    {
      "id": "G5_REVIEW",
      "human": "impact_scope_reviewer",
      "stop_if": "inclusion/exclusion cannot be explained and appealed"
    },
    {
      "id": "G6_REMEDY",
      "human": "authorized_service_owner",
      "stop_if": "authority or lawful case path is absent"
    },
    {
      "id": "G7_CLOSE",
      "human": "independent_appeal_reviewer",
      "stop_if": "omissions, false inclusions, unresolved matters, or temporary links remain"
    }
  ],
  "named_human_roles": [
    "incident_owner",
    "independent_professional_reviewer",
    "impact_scope_reviewer",
    "authorized_service_owner",
    "notification_safety_lead",
    "independent_appeal_reviewer"
  ],
  "ai_minimum_role": [
    "compare frozen versions",
    "deduplicate candidates",
    "find cross-channel omissions",
    "draft editable notices"
  ],
  "ai_prohibited": [
    "confirm harm",
    "decide inclusion or exclusion",
    "decide remedy",
    "create durable group labels",
    "expand data purpose",
    "close the event"
  ],
  "synthetic_test": {
    "record_count": 60,
    "shared_error_version_count": 12,
    "complainant_count": 1,
    "ambiguous_or_missing_count": 4,
    "personal_data": false,
    "measures": [
      "silent recovery",
      "false inclusion",
      "omission",
      "repeated-proof steps",
      "pause delay",
      "ordinary-service continuity",
      "temporary-link deletion",
      "AI-off equivalence"
    ]
  },
  "ai_off": "Paper version lists, controlled sampling, staffed inclusion/exclusion, human notice, remedy receipts, and appeal complete the same task."
}
