{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/open-city-ai/haidian/civic-value-passport.schema.json",
  "title": "京张公共价值护照",
  "type": "object",
  "required": ["passport_id", "version", "status", "public_problem", "place", "conversion", "rights", "evidence", "governance", "operations", "disclaimer"],
  "properties": {
    "passport_id": {"type": "string", "pattern": "^JZ-CVP-[0-9]{3}$"},
    "version": {"type": "string"},
    "status": {"enum": ["concept", "baseline", "controlled_pilot", "public_trial", "retained", "modified", "retired"]},
    "public_problem": {"type": "object", "required": ["statement", "affected_public", "non_intervention_baseline"]},
    "place": {"type": "object", "required": ["geometry_ref", "geometry_status", "spatial_type", "ordinary_service_baseline"]},
    "conversion": {"type": "object", "required": ["input_resource", "public_value_output", "handoff_chain"]},
    "rights": {"type": "object", "required": ["notice", "opt_out", "appeal", "accessibility", "non_ai_equivalence"]},
    "evidence": {"type": "object", "required": ["level", "baseline", "target", "source_refs", "negative_result_recorded"]},
    "governance": {"type": "object", "required": ["accountable", "responsible", "consulted", "informed", "human_gate", "stop_condition", "rollback_action"]},
    "operations": {"type": "object", "required": ["trial_window", "service_level_objective", "maintenance_owner", "cost_status", "exit_assets"]},
    "disclaimer": {"type": "string"}
  },
  "additionalProperties": true
}
