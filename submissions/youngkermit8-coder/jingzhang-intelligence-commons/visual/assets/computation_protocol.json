{
  "schema_version": "1.0.0",
  "method": "multi_scale_rule_based_research_by_design",
  "principles": [
    "parameter_to_geometry",
    "geometry_to_metric",
    "scenario_to_threshold",
    "threshold_to_human_decision",
    "version_to_public_diff"
  ],
  "parameters": [
    {
      "id": "P-BOUNDARY",
      "source": "geometry/site_boundary.geojson",
      "status": "provisional",
      "downstream": [
        "all geometry",
        "all area metrics",
        "all drawings"
      ]
    },
    {
      "id": "P-SPINE",
      "source": "geometry/roads.geojson#ROAD-001",
      "status": "concept",
      "downstream": [
        "green overlay",
        "scenario nodes",
        "mobility diagrams"
      ]
    },
    {
      "id": "P-KEY-AREAS",
      "source": "geometry/key_areas.geojson",
      "status": "provisional",
      "downstream": [
        "three courts",
        "intervention envelopes",
        "slow loops"
      ]
    },
    {
      "id": "P-TARGETS",
      "source": "performance_targets.json",
      "status": "concept targets",
      "downstream": [
        "simulation briefs",
        "stage gates",
        "monitoring plan"
      ]
    }
  ],
  "recalculation_order": [
    "replace official inputs",
    "run topology",
    "recompute metrics",
    "run performance models",
    "professional sign-off",
    "publish diff",
    "regenerate HTML/PDF"
  ],
  "human_decision_points": [
    "retain/demolish",
