{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:all-life-speaks:life-letter:0.1.0",
  "$comment": "Offline supporting asset; protocol is conceptual and requires benchmark plus professional review.",
  "title": "ALL LIFE SPEAKS machine-readable civic life letter",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "letter_id",
    "letter_type",
    "status",
    "signal",
    "model",
    "runtime",
    "evidence",
    "governance",
    "public_interpretation",
    "disclaimer"
  ],
  "properties": {
    "schema_version": {"const": "0.1.0"},
    "letter_id": {"type": "string", "minLength": 3},
    "letter_type": {
      "enum": ["water", "rain", "tree", "soil", "pollinator", "bird", "night", "small_fauna", "heat", "food", "citizen_reply", "governance_reply"]
    },
    "status": {
      "enum": ["received", "model_abstained", "verification_required", "awaiting_review", "verified", "responded", "monitored", "not_adopted", "trial_stopped", "rolled_back", "revoked", "archived"]
    },
    "signal": {
      "type": "object",
      "additionalProperties": false,
      "required": ["signal_type", "time_window", "spatial_resolution", "feature_names", "contains_personal_data", "synthetic"],
      "properties": {
        "signal_type": {"type": "string"},
        "time_window": {"type": ["string", "null"]},
        "spatial_resolution": {"type": "string"},
        "feature_names": {"type": "array", "items": {"type": "string"}},
        "contains_personal_data": {"const": false},
        "synthetic": {"type": "boolean"},
        "quality_flags": {"type": "array", "items": {"type": "string"}}
      }
    },
    "model": {
      "type": "object",
      "additionalProperties": false,
      "required": ["model_id", "model_version", "model_hash", "input_contract_version", "model_family", "confidence", "calibration_status", "out_of_distribution_status", "abstained"],
      "properties": {
        "model_id": {"type": "string"},
        "model_version": {"type": "string"},
        "model_hash": {"type": ["string", "null"]},
        "input_contract_version": {"type": "string"},
        "model_family": {"type": "string"},
        "confidence": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
        "calibration_status": {"enum": ["unknown", "pending_benchmark", "calibrated", "failed"]},
        "out_of_distribution_status": {"enum": ["unknown", "in_distribution", "out_of_distribution"]},
        "abstained": {"type": "boolean"}
      }
    },
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": ["compute_mode", "edge_processed", "critical_control_connected", "deployment_status"],
      "properties": {
        "compute_mode": {"type": "string"},
        "edge_processed": {"type": "boolean"},
        "critical_control_connected": {"const": false},
        "deployment_status": {"enum": ["concept_only_unvalidated", "bench", "controlled_sandbox", "shadow_mode", "bounded_public_pilot", "paused", "exited"]}
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_ids", "source_hashes", "provenance_hash", "missing_evidence", "sensitive_location_protected"],
      "properties": {
        "source_ids": {"type": "array", "items": {"type": "string"}},
        "source_hashes": {"type": "array", "items": {"type": "string"}},
        "provenance_hash": {"type": ["string", "null"]},
        "missing_evidence": {"type": "array", "items": {"type": "string"}},
        "sensitive_location_protected": {"type": "boolean"}
      }
    },
    "governance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["human_reviewer_role", "human_decision", "human_signature_status", "reason", "decision_diff_available", "correction_route", "appeal_status", "non_ai_fallback", "expires_at", "rollback_state"],
      "properties": {
        "human_reviewer_role": {"type": "string"},
        "human_decision": {"enum": ["pending", "accepted", "modified", "not_adopted", "trial_stopped"]},
        "human_signature_status": {"enum": ["not_signed", "signed", "revoked"]},
        "reason": {"type": ["string", "null"]},
        "decision_diff_available": {"type": "boolean"},
        "correction_route": {"type": "string"},
        "appeal_status": {"enum": ["available", "requested", "resolved", "not_applicable"]},
        "non_ai_fallback": {"type": "string"},
        "expires_at": {"type": ["string", "null"]},
        "rollback_state": {"type": "string"}
      }
    },
    "public_interpretation": {"type": "string"},
    "disclaimer": {"type": "string"}
  }
}
