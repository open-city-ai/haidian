{
  "schema_version": "0.1.0",
  "system_id": "ALS-STACK-1.0",
  "title_zh": "万物来信城市生命通信技术栈",
  "title_en": "An Open Multispecies Urban Intelligence Stack for Jingzhang",
  "status": "conceptual_design_benchmark_required",
  "asset_scope": "offline_visual_machine_readable_supporting_asset",
  "controlling_principle": "Every signal has provenance. Every model has limits. Every action has a human owner.",
  "system_boundary": "conceptual_open_architecture_not_deployed_not_connected_to_critical_control_networks",
  "release_path": [
    "bench",
    "controlled_sandbox",
    "shadow_mode",
    "bounded_public_pilot",
    "continue_modify_rollback_or_exit"
  ],
  "control_planes": [
    {
      "plane_id": "PROOF-PLANE",
      "purpose": "versioned provenance for signal model rule permission human edit and decision"
    },
    {
      "plane_id": "SAFETY-PLANE",
      "purpose": "privacy ecology cybersecurity accessibility energy and critical-system isolation"
    },
    {
      "plane_id": "BENCHMARK-PLANE",
      "purpose": "fault injection independent benchmark and staged release or rollback"
    },
    {
      "plane_id": "HUMAN-AUTHORITY-PLANE",
      "purpose": "named professional release role appeal correction and non-AI fallback"
    }
  ],
  "modules": [
    {
      "module_id": "ALS-SENSE",
      "role": "edge_sensing_and_privacy_filtering",
      "standard_object": "SignalPacket",
      "inputs": ["environmental_timeseries", "non_human_acoustic_features", "restricted_field_of_view_images", "irreversible_event_vectors", "voluntary_citizen_observations"],
      "outputs": ["de_identified_features", "device_health", "data_quality_flags"],
      "release_gate": "identifiable human material cannot leave the device"
    },
    {
      "module_id": "ALS-MODEL",
      "role": "multimodal_inference_with_uncertainty",
      "standard_object": "ModelObservation",
      "model_families": ["time_series_anomaly_detection", "bioacoustic_classification", "restricted_vision_classification", "sensor_fusion", "spatiotemporal_routing", "evidence_grounded_language_model"],
      "outputs": ["candidate_interpretation", "confidence", "calibration_status", "out_of_distribution_status"],
      "release_gate": "low-confidence or out-of-distribution inputs return unknown"
    },
    {
      "module_id": "ALS-TWIN",
      "role": "urban_ecological_digital_twin",
      "standard_object": "TwinScenario",
      "objects": ["habitat_patch", "tree_asset", "rain_garden", "public_space_component", "lighting_prototype", "slow_mobility_link"],
      "outputs": ["scenario_comparison", "evidence_gap", "field_verification_queue"],
      "release_gate": "simulation output is not an engineering or causal conclusion"
    },
    {
      "module_id": "ALS-PROOF",
      "role": "living_data_fabric_provenance_uncertainty_and_model_registry",
      "standard_object": "ProofBundle",
      "records": ["source_id", "source_hash", "model_id", "model_version", "feature_schema", "confidence", "human_edit", "expiry", "rollback"],
      "outputs": ["life_letter", "model_card", "datasheet", "audit_event"],
      "release_gate": "a factual claim without a source and model version cannot be published"
    },
    {
      "module_id": "ALS-AGENT",
      "role": "specialist_agent_orchestration",
      "standard_object": "ActionProposal",
      "agent_ids": ["WATER-AGENT", "HABITAT-AGENT", "NBS-OPS-AGENT", "EVIDENCE-GUARD", "CIVIC-RAG-AGENT", "REPLY-ORCHESTRATOR"],
      "outputs": ["conflict_log", "responsibility_suggestion", "human_review_packet"],
      "release_gate": "agents cannot approve, enforce, allocate budget or close a case"
    },
    {
      "module_id": "ALS-REPLY",
      "role": "human_authorized_operations_and_public_reply",
      "standard_object": "LifeLetter_and_ReplyCommit",
      "channels": ["maintenance_work_order", "static_public_notice", "offline_service_desk", "public_reply_ledger", "digital_twin_feedback"],
      "statuses": ["received", "verification_required", "verified", "responded", "not_adopted", "trial_stopped", "archived"],
      "release_gate": "every consequential response has a named human role, reason, correction route and non-AI fallback"
    }
  ],
  "specialist_agents": [
    {
      "agent_id": "WATER-AGENT",
      "scope": "water_and_microclimate_timeseries",
      "may": ["flag_change", "request_calibration", "suggest_sampling_queue"],
      "may_not": ["declare_compliance", "attribute_pollution", "close_water_space"]
    },
    {
      "agent_id": "HABITAT-AGENT",
      "scope": "trees_birds_insects_soil_and_small_fauna",
      "may": ["return_candidate_taxon_group", "flag_uncertainty", "protect_sensitive_location"],
      "may_not": ["publish_sensitive_location", "diagnose_tree_disease", "claim_species_increase"]
    },
    {
      "agent_id": "NBS-OPS-AGENT",
      "scope": "rain_garden_tree_pit_shade_and_public_space_maintenance",
      "may": ["rank_inspection_queue", "identify_missing_data", "draft_work_order"],
      "may_not": ["control_critical_infrastructure", "auto_close_work_order", "replace_field_inspection"]
    },
    {
      "agent_id": "EVIDENCE-GUARD",
      "scope": "provenance_model_registry_and_uncertainty",
      "may": ["block_unsourced_claim", "check_model_version", "mark_out_of_distribution", "expire_stale_letter"],
      "may_not": ["approve_policy", "hide_disagreement"]
    },
    {
      "agent_id": "CIVIC-RAG-AGENT",
      "scope": "retrieval_from_cleared_local_sources_and_public_rules",
      "may": ["retrieve_source_passage", "draft_plain_language_explanation", "preserve_minor_opinion"],
      "may_not": ["use_unregistered_source", "invent_rule", "treat_draft_as_law"]
    },
    {
      "agent_id": "REPLY-ORCHESTRATOR",
      "scope": "merge_verified_letters_into_human_review_packet",
      "may": ["deduplicate", "surface_conflict", "suggest_responsible_role", "draft_reply"],
      "may_not": ["approve", "enforce", "allocate_budget", "close_case"]
    }
  ],
  "benchmark_suites": [
    {
      "benchmark_id": "T01-EDGE-MULTISPECIES",
      "tests": ["classification_by_season_and_noise", "out_of_distribution_rejection", "privacy_filtering", "offline_operation", "energy_per_inference"],
      "performance_status": "unknown_pending_test"
    },
    {
      "benchmark_id": "T02-NBS-OPS",
      "tests": ["sensor_drift", "missing_data", "conflicting_sensor", "false_alert", "manual_override", "rollback_to_fixed_inspection"],
      "performance_status": "unknown_pending_test"
    },
    {
      "benchmark_id": "T03-WILDLIFE-INTERFACE",
      "tests": ["bird_friendly_facade_prototype", "ecology_sensitive_lighting", "public_safety_constraint", "one_click_baseline_restore"],
      "performance_status": "unknown_pending_professional_review"
    },
    {
      "benchmark_id": "T04-CIVIC-AGENT-REDTEAM",
      "tests": ["citation_grounding", "hallucination", "source_mismatch", "minority_opinion_loss", "incorrect_routing", "appeal_and_correction", "human_takeover_time"],
      "performance_status": "unknown_pending_test"
    }
  ],
  "prohibited_uses": [
    "facial_recognition",
    "individual_tracking",
    "voice_identity_inference",
    "predictive_policing",
    "automated_enforcement",
    "medical_diagnosis",
    "automatic_tree_removal_or_pesticide_application",
    "automatic_control_of_drainage_fire_or_traffic_systems",
    "publication_of_sensitive_species_locations",
    "government_procurement_or_implementation_claims"
  ],
  "authoritative_files": [
    "proposal.md",
    "visual/assets/life-letter.schema.json",
    "metrics.json",
    "geometry/public_space.geojson"
  ]
}
