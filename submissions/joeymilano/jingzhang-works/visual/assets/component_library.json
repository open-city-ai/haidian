{
  "schema_version": "1.1.0",
  "components": [
    {
      "id": "C01",
      "name_zh": "先问台",
      "name_en": "Ask First Desk",
      "resource_class": "S",
      "kit": [
        "high_contrast_sign",
        "paper_route_cards",
        "staff_badge",
        "manual_issue_log"
      ],
      "release_gate": "registration_free_and_staffed",
      "rollback": "remove movable kit and preserve issue log"
    },
    {
      "id": "C02",
      "name_zh": "人工接手亭",
      "name_en": "Human Takeover Pavilion",
      "resource_class": "M",
      "kit": [
        "visible_takeover_marker",
        "accessible_counter",
        "physical_stop",
        "offline_contact_sheet"
      ],
      "release_gate": "named_operator_and_accessible_route",
      "rollback": "stop service and keep staffed no-app route"
    },
    {
      "id": "C03",
      "name_zh": "公开改进墙",
      "name_en": "Public Change Log",
      "resource_class": "S",
      "kit": [
        "issue_id",
        "owner",
        "due_date",
        "result",
        "retirement_record"
      ],
      "release_gate": "weekly_update_and_privacy_review",
      "rollback": "archive record and remove display"
    },
    {
      "id": "C04",
      "name_zh": "无障碍测试道",
      "name_en": "Accessible Test Lane",
      "resource_class": "M",
      "kit": [
        "wheelchair_parallel_zone",
        "cane_detection_marker",
        "low_interface",
        "manual_recovery_zone"
      ],
      "release_gate": "controlled_zone_and_safety_lead",
      "rollback": "physical stop and manual removal"
    },
    {
      "id": "C05",
      "name_zh": "任务路线标记",
      "name_en": "Task Journey Marker",
      "resource_class": "S",
      "kit": [
        "node_number",
        "high_contrast_arrow",
        "paper_map_key",
        "takeover_pointer"
      ],
      "release_gate": "end_to_end_walkthrough",
      "rollback": "withdraw route publication"
    },
    {
      "id": "C06",
      "name_zh": "安静休息点",
      "name_en": "Quiet Rest Point",
      "resource_class": "S",
      "kit": [
        "seat",
        "shade_status",
        "quiet_rule",
        "human_help_pointer"
      ],
      "release_gate": "accessible_approach_and_daily_check",
      "rollback": "close and reroute"
    }
  ],
  "honor_display": {
    "name_zh": "好用记录",
    "name_en": "Works Record",
    "allowed_states": [
      "passed_with_evidence",
      "revision_due",
      "retired"
    ],
    "prohibited_claims": [
      "innovation_award_without_evidence",
      "government_endorsement",
      "paid_ranking"
    ],
    "display_fields": [
      "task",
      "evidence_date",
      "responsible_owner",
      "expiry_date",
      "change_log_url_or_offline_id"
    ]
  },
  "dimension_rule": "Component dimensions remain design ranges until access, fire, ownership, and site surveys are complete."
}
