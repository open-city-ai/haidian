  "dimensions": [
    {
      "id": "data_privacy",
      "label": "数据隐私",
      "score": 3,
      "note": "公共服务助手和场景传感存在最少必要数据边界与功能漂移风险。",
      "mitigation": "默认不做人脸识别，限制保留期限和访问角色，并提供人工申诉与停用路径。",
      "human_review": "由运营方数据负责人和法律顾问在试点前复核。"
    },
    {
      "id": "implementation_complexity",
      "label": "实施复杂度",
      "score": 3,
      "note": "三厅跨空间协同，但可以拆成互不依赖的人工、轻改造和验证实施包。",
      "mitigation": "P0 先运行，P1 和 P2 分别采购、验收和暂停，避免一次性系统集成。",
      "human_review": "由项目管理和专业设计团队核实现状条件。"
    },
    {
      "id": "public_acceptance",
      "label": "公众接受度",
      "score": 2,
      "note": "居民可能不信任自动建议或不愿使用智能手机和生物识别。",
      "mitigation": "保留同等人工、纸本、电话和免登录路径，并以六道接受门槛控制扩展。",
      "human_review": "由银龄、残障、照护者和一线人员参与开放前测试。"
    },
    {
      "id": "operations_cost",
      "label": "运维成本",
      "score": 3,
      "note": "值守岗位、设施维护和供应商迁移会产生持续运营成本。",
      "mitigation": "建设与运维预算同步披露，使用小而可替换组件和开放工单格式。",
      "human_review": "由未来运营单位在采购前确认全生命周期成本。"
    },
    {
      "id": "policy_uncertainty",
      "label": "政策不确定性",
      "score": 3,
      "note": "公共 AI、机器人和自主接驳的适用规则可能随场景和时间变化。",
      "mitigation": "只在已发布运行边界内试点，自动到期并在规则变化后重新立项。",
      "human_review": "由主管部门和专业顾问核对届时有效规定。"
    },
    {
      "id": "spatial_dispute",
      "label": "空间争议",
      "score": 4,
      "note": "仓库临时总体边界与公开地图所示遗址公园位置存在未解决冲突。",
      "mitigation": "所有空间成果标记临时，避免地块和文保断言，官方 polygon 到位后整体复算。",
      "human_review": "须由组织方、测绘规划和文保专业团队确认正式边界。"
    },
    {
      "id": "technology_maturity",
      "label": "技术成熟度",
      "score": 2,
      "note": "九个场景使用成熟产品类别，三个机器人或助手场景仍需受控验证。",
      "mitigation": "按 9+3+4 分层，地理围栏、影子模式、人工监管和物理停用共同约束。",
      "human_review": "由安全、网络和具体设备专业团队完成现场验收。"
    },
    {
      "id": "equity_inclusion",
      "label": "公平与包容性",
      "score": 2,
      "note": "数字界面可能排斥老年人、残障人士、儿童照护者和临时访客。",
      "mitigation": "六类画像参与测试，连续无障碍路线和非数字替代作为开门条件。",
      "human_review": "由代表性用户和无障碍专业人员共同复核。"
    }
  ],
