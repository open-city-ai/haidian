        "SRC-JINGZHANG-PHASE1-OPS-2026"
      ],
      "assumption_ids": [
        "A-BOUNDARY-001",
        "A-CONTROLS-001"
      ],
      "self_check_ids": [
        "LAND_USE_TOPOLOGY",
        "BILINGUAL_DELIVERY"
      ],
      "evidence_summary_zh": "V6.1以总体概念图和一脊五缝空间语法呈现遗产—气候公共脊、五类横向城市缝与北中南三种公共试验；临时几何和待补专业资料仍在假设与风险门中披露。",
      "spatial_design_requirements": {
        "problem_zh": "线性遗产绿带若只被理解为纵向景观，会继续放大校城、河站和站城界面的横向断裂。",
        "spatial_action_zh": "在不替换官方结构的前提下，以遗产—气候公共脊串联五类横向城市缝，并在清河、AI原点、大钟寺配置不同的公共服务试验。",
        "drawing_scale_and_section_hint_zh": "总体图为概念范围关系；关键节点须在后续清权底图上补1:500平面、1:200剖面和无障碍连续路径。",
        "provisional_boundary_limit_zh": "所有范围和落位均为征集包临时几何，不是法定红线、项目选址或获批控规指标。",
        "professional_gates_zh": "取得法定边界、现状测绘、产权与保护范围后，由规划、交通、景观、文保和无障碍专业团队复核。"
      }
    },
