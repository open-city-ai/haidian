{
  "version": "1.3",
  "simulation_class": "illustrative_design_scenario_not_local_baseline",
  "status": "transparent_sandbox_before_field_calibration",
  "purpose": "Compare operating logic and expose trade-offs before real counts; never report these values as current Haidian performance.",
  "time_window": "weekday_am_peak_design_window_07:30-09:30",
  "demand_units": 1000,
  "input_basis": {
    "mode_groups": [
      "metro",
      "bus",
      "bicycle",
      "walking",
      "wheelchair",
      "car",
      "enterprise_shuttle"
    ],
    "people_groups": [
      "enterprise_employee",
      "resident",
      "carer",
      "child",
      "wheelchair_user",
      "visitor",
      "logistics",
      "night_worker"
    ],
    "external_commute": "cross_boundary_OD_is_included",
    "assumption_note": "Demand is a normalized 1000-person design unit with no local count claim; replace with dated grouped OD and field observations."
  },
  "score_formula": "efficiency_index is a 0-100 illustrative weighted comparison after hard-gate screening: cost 30%, transfer 20%, people-flow 20%, external-car reduction 15%, worst-group equity 15%.",
  "behavioral_choice_contract": {
    "model_class": "grouped_mode_and_departure_time_choice_with_activity_chain",
    "status": "method_contract_only_before_local_calibration",
    "choice_set": [
      "metro",
      "bus",
      "bicycle",
      "walking_wheelchair",
      "car",
      "enterprise_shuttle",
      "air_candidate"
    ],
    "generalized_cost_components": [
      "door_to_door_time",
      "schedule_delay_and_arrival_flexibility",
      "transfer_wait_and_reliability",
      "crowding_and_station_gate_friction",
      "curb_parking_and_loading_time",
      "fare_and_energy_cost",
      "accessibility_and_worst_group_gap"
    ],
    "decision_order": [
      "apply_fire_emergency_accessibility_public_transport_privacy_and_human_service_gates",
      "compare_grouped_mode_and_departure_time_alternatives_by_generalized_cost",
      "recheck_people_flow_conflicts_external_car_inflow_and_worst_group_gap",
      "publish_aggregate_readout_and_keep_a_ground_fallback"
    ],
    "grouped_replanning": {
      "enterprise_employee": ["arrival_window", "mode", "transfer_chain"],
      "resident": ["service_window", "accessible_route", "mode"],
      "carer_or_child": ["care_stop_chain", "human_assistance", "mode"],
      "visitor": ["wayfinding", "event_window", "mode"],
      "logistics_and_maintenance": ["service_window", "curb_state", "vehicle_route"],
      "night_worker": ["low_frequency_transit", "human_backup", "safe_return"]
    },
    "external_commute_contract": {
      "boundary": "cross_boundary_grouped_OD",
      "required_records": [
        "origin_zone_group",
        "destination_zone_group",
        "boundary_direction",
        "arrival_departure_window",
        "mode_and_transfer_chain",
        "park_and_ride_or_curb_use",
        "door_to_door_time_p50_p90"
      ],
      "privacy": "no_personal_trace; suppress small cells and publish aggregate changes only"
    },
    "air_candidate_rule": "air_candidate_is_not a choice alternative until airspace_airworthiness_operator_insurance_weather_noise_emergency_and_public_review gates pass",
    "coefficient_rule": "do not import coefficients or local effects from papers; estimate grouped parameters from dated local observations"
  },
  "hard_gates": [
    "fire_emergency",
    "accessibility_continuity",
    "public_transport_protection",
    "privacy",
    "human_service"
  ],
  "model_spec": {
    "model_class": "deterministic_multi_agent_queue_network_sandbox",
    "status": "illustrative_configuration_and_synthetic_run_not_local_baseline",
    "time_step_seconds": 60,
    "horizon_minutes": 120,
    "random_seed": 147228,
    "privacy_rule": "grouped_OD_and_aggregate_occupancy_only; no_personal_trajectory",
    "agent_types": [
      {
        "id": "resident",
        "design_unit_count": 380,
        "demand_states": ["daily_service", "care_trip", "night_return"],
        "equity_weight": "high"
      },
      {
        "id": "enterprise_employee",
        "design_unit_count": 450,
        "demand_states": ["peak_arrival", "peak_departure", "shuttle_transfer"],
        "equity_weight": "medium"
      },
      {
        "id": "carer_or_child",
        "design_unit_count": 60,
        "demand_states": ["accompanied_access", "school_or_care_stop"],
        "equity_weight": "high"
      },
      {
        "id": "visitor",
        "design_unit_count": 50,
        "demand_states": ["wayfinding", "event_arrival"],
        "equity_weight": "medium"
      },
      {
        "id": "logistics_and_maintenance",
        "design_unit_count": 40,
        "demand_states": ["loading", "service_window"],
        "equity_weight": "high"
      },
      {
        "id": "night_worker",
        "design_unit_count": 20,
        "demand_states": ["late_return", "low_frequency_transit"],
        "equity_weight": "high"
      }
    ],
    "fleet_and_service_objects": [
      {
        "id": "metro_train",
        "mode": "metro",
        "vehicle_capacity_persons": 180,
        "headway_minutes": 10,
        "dwell_minutes": 2,
        "service_state": "capacity_and_platform_audit_required"
      },
      {
        "id": "bus_vehicle",
        "mode": "bus",
        "vehicle_capacity_persons": 60,
        "headway_minutes": 12,
        "dwell_minutes": 1,
        "service_state": "route_and_stop_capacity_audit_required"
      },
      {
        "id": "bicycle_parking",
        "mode": "bicycle",
        "capacity_spaces": 160,
        "turnover_minutes": 15,
        "service_state": "parking_and_conflict_audit_required"
      },
      {
        "id": "car_vehicle_and_curb",
        "mode": "car",
        "vehicle_capacity_persons": 4,
        "curb_service_capacity_vehicles_per_15min": 20,
        "service_state": "loading_parking_and_emergency_priority"
      },
      {
        "id": "walk_wheelchair_stream",
        "mode": "walking_wheelchair",
        "service_capacity_persons_per_minute": 6,
        "service_state": "continuous_accessibility_audit_required"
      },
      {
        "id": "air_candidate",
        "mode": "air_candidate",
        "service_capacity_persons": null,
        "service_state": "blocked_until_airspace_airworthiness_operator_and_safety_review"
      }
    ],
    "state_variables": [
      "time",
      "agent_group",
      "location_node",
      "mode",
      "queue_length",
      "vehicle_occupancy",
      "transfer_status",
      "curb_state",
      "conflict_flag",
      "accessible_route_flag"
    ],
    "events": [
      "boundary_arrival",
      "station_gate",
      "metro_boarding",
      "bus_boarding",
      "bicycle_parking",
      "curb_loading_or_dropoff",
      "pedestrian_vehicle_crossing",
      "mode_transfer",
      "weather_cancel_and_ground_fallback",
      "emergency_preemption"
    ],
    "trip_leg_templates": [
      {
        "id": "external_enterprise_commute",
        "agent_groups": ["enterprise_employee", "night_worker"],
        "legs": ["boundary_arrival", "walk_or_bus_access", "metro_or_bus", "walk_or_wheelchair_access", "enterprise_gate"],
        "required_modes": ["metro", "bus", "walking_wheelchair"],
        "boundary_rule": "origin_and_destination_cross_provisional_boundary; use grouped_OD"
      },
      {
        "id": "resident_daily_service",
        "agent_groups": ["resident", "carer_or_child"],
        "legs": ["resident_service_origin", "walk_or_bicycle", "bus_or_metro", "accessible_last_500m", "service_destination", "return_or_fallback"],
        "required_modes": ["walking_wheelchair", "bicycle", "bus", "metro"],
        "equity_rule": "preserve_human_and_non_app_equivalent_route"
      },
      {
        "id": "enterprise_shuttle_transfer",
        "agent_groups": ["enterprise_employee", "visitor"],
        "legs": ["external_arrival", "enterprise_shuttle", "rail_or_bus_transfer", "walk_to_destination"],
        "required_modes": ["enterprise_shuttle", "metro", "bus", "walking_wheelchair"],
        "competition_rule": "feeder_must_not_displace_backbone_transit_without_local_evidence"
      },
      {
        "id": "logistics_and_maintenance_window",
        "agent_groups": ["logistics_and_maintenance"],
        "legs": ["boundary_arrival", "car_or_service_vehicle", "time_window_curb", "loading_or_maintenance", "clear_and_return"],
        "required_modes": ["car"],
        "safety_rule": "never_block_fire_or_accessible_route"
      },
      {
        "id": "air_candidate_ground_first",
        "agent_groups": ["visitor", "enterprise_employee"],
        "legs": ["ground_access", "air_candidate_gate", "ground_fallback"],
        "required_modes": ["walking_wheelchair", "metro", "bus"],
        "status": "blocked_until_airspace_airworthiness_operator_insurance_weather_noise_emergency_and_public_review"
      }
    ],
    "outputs": [
      "mean_and_peak_queue_by_mode",
      "metro_and_bus_load_ratio",
      "transfer_reliability",
      "curb_service_compliance",
      "people_vehicle_conflict_rate",
      "external_car_inflow_ratio",
      "worst_group_gap_points",
      "ground_fallback_recovery_time",
      "enterprise_activity_adaptation_sensitivity",
      "network_resilience_under_disruption",
      "worst_group_p90_wait_proxy",
      "ground_fallback_coverage_ratio"
    ],
    "calibration_inputs": [
      "dated_grouped_external_OD",
      "metro_station_and_bus_stop_capacity",
      "train_and_bus_headways",
      "signal_timings_and_crossings",
      "bicycle_parking_inventory",
      "curb_queue_observations",
      "wheelchair_route_audit",
      "weather_and_emergency_protocol",
      "dated_disruption_log",
      "fallback_service_capacity_audit",
      "grouped_p90_door_to_door_sample"
    ],
    "calibration_metrics": [
