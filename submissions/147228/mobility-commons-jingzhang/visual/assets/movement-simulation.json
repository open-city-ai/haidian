      "door_to_door_time_p50_p90",
      "trip_distance_by_mode",
      "station_and_vehicle_load",
      "accessible_route_completion_by_group",
      "people_flow_conflict_rate_by_group",
      "worst_group_accessibility_gap",
      "activity_schedule_change_by_group",
      "recovery_time_by_disruption",
      "worst_group_p90_door_to_door",
      "fallback_coverage_by_group"
    ]
