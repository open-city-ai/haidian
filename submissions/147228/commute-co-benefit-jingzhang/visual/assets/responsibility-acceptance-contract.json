{
  "schema_version": "0.1.0",
  "contract_id": "commute-co-benefit-jingzhang-responsibility-acceptance",
  "status": "design_target_not_implementation",
  "purpose": "Make role boundaries, dated evidence, group-level acceptance and human fallback auditable before any mobility pilot expands.",
  "scope": "Enterprise–resident mobility pilots across metro, bus, bicycle, walking/accessibility, car, shuttle, curb and conditional air-ground transfer interfaces.",
  "unknown_boundary": [
    "specific approving institutions",
    "operator contracts and budgets",
    "local baseline samples and observed service performance",
    "procurement, insurance and permit decisions"
  ],
  "privacy": {
    "published_unit": "role × phase × group × metric × dated evidence status",
    "prohibited": ["personal trajectory", "home address", "employer identity", "vehicle identifier", "small-cell output"]
  },
  "roles": [
    {
      "id": "authority_and_local_management",
      "label_zh": "交通与属地管理",
      "label_en": "transport and local management",
      "owns_zh": ["审批与路权边界", "公共安全", "交通影响与消防接口"],
      "owns_en": ["approvals and right-of-way boundaries", "public safety", "traffic-impact and fire interfaces"]
    },
    {
      "id": "enterprise_and_feeder_operator",
      "label_zh": "企业交通与接驳运营",
      "label_en": "enterprise mobility and feeder operators",
      "owns_zh": ["聚合需求版本", "班次与装卸窗口", "成本与现场引导"],
      "owns_en": ["aggregated demand versions", "schedules and loading windows", "cost and on-site guidance"]
    },
    {
      "id": "community_access_and_human_service",
      "label_zh": "社区、无障碍与人工服务",
      "label_en": "community, accessibility and human service",
      "owns_zh": ["公共路线连续性", "替代路线与申诉", "低数字能力人工入口"],
      "owns_en": ["public-route continuity", "alternatives and redress", "human access for low-digital-capacity users"]
    },
    {
      "id": "maintenance_privacy_independent_review",
      "label_zh": "维护、数据保护与独立复核",
      "label_en": "maintenance, data protection and independent review",
      "owns_zh": ["资产状态与事件", "隐私和证据留存", "复核结论与版本回读"],
      "owns_en": ["asset state and incidents", "privacy and evidence retention", "review conclusions and version readback"]
    }
  ],
  "required_readback_fields": [
    "phase_id",
    "evidence_date",
    "demand_version",
    "asset_or_service_id",
    "responsible_role",
    "group_definition",
    "metric_id",
    "observed_or_unknown_value",
    "source_or_collection_method",
    "stop_decision",
    "next_review_date"
  ],
  "phases": [
    {
      "id": "P0",
      "label_zh": "基线登记",
      "label_en": "baseline register",
      "acceptance": {
        "operator": "equals",
        "value": 1.0,
        "metric_id": "priority_asset_identity_role_fallback_coverage_ratio",
        "interpretation": "Every priority asset must have an ID, accountable role and human fallback before a pilot is accepted."
      },
      "evidence_required": ["dated asset register", "grouped demand and time windows", "accessible-route audit", "complaint entry and response owner"],
      "stop_conditions": ["ownerless asset", "missing human fallback", "unresolved privacy boundary", "unmeasured fire or accessible-route conflict"]
    },
    {
      "id": "P1",
      "label_zh": "小规模可逆试点",
      "label_en": "small reversible pilot",
      "acceptance": {
        "required_group_dimensions": ["enterprise", "resident", "walking_accessibility", "care_load", "night_travel"],
        "metrics": [
          {"metric_id": "accessible_route_completion_ratio", "operator": ">=", "threshold": 0.95, "unit": "ratio", "status": "design_target"},
          {"metric_id": "curb_time_window_compliance_ratio", "operator": ">=", "threshold": 0.90, "unit": "ratio", "status": "design_target"},
          {"metric_id": "complaint_status_update_hours", "operator": "<=", "threshold": 24, "unit": "hours", "status": "design_target"}
        ]
      },
      "evidence_required": ["dated waiting and completion readout", "curb conflict and clearing log", "first-response and closure status", "human-route equivalence check"],
      "stop_conditions": ["any protected-group deterioration", "public-route discontinuity", "hard-gate failure", "complaint without owner or status"]
    },
    {
      "id": "P2",
      "label_zh": "条件扩展评估",
      "label_en": "conditional expansion review",
      "acceptance": {
        "all_evidence_required": ["traffic impact", "fire", "accessibility", "privacy", "ecology", "insurance", "procurement", "operator and maintenance"],
        "model_use": "A composite model score may inform options but cannot replace field evidence or approval."
      },
      "evidence_required": ["signed review packet", "dated operator capacity and headway evidence", "grouped acceptance and refusal record", "rollback rehearsal"],
      "stop_conditions": ["any missing approval evidence", "unresolved group-level harm", "capacity or privacy evidence gap", "rollback not demonstrated"]
    }
  ],
  "human_fallback": {
    "trigger": ["group-level deterioration", "ownerless action", "hard-gate failure", "service outage", "weather cancellation", "data or privacy incident"],
    "service_channels": ["public_transport", "on_site_human", "telephone", "paper", "accessible_alternate_route"],
    "ai_override": "Any AI recommendation can be rejected by an on-site human service role.",
    "review_date_required": true,
    "expansion_blocked_until_reacceptance": true
  },
  "calibration_required": [
    "dated grouped OD and mode share",
    "observed waiting, denied boarding and alternate-mode acceptance",
    "accessible and care-trip route audit",
    "operator headway, fleet and spare capacity",
    "complaint response and closure logs"
  ]
}
