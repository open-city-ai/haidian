{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "open-pulse-relay-receipt-0.1.0",
  "title": "Jing-Zhang Open Pulse bounded scenario receipt",
  "description": "A concept-only, human-gated receipt for one reversible AI or embodied-intelligence test window.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "receipt_id", "scenario_id", "status", "problem", "place", "data", "system", "human_gate", "rights", "operations", "evaluation", "handoff", "disclaimer"],
  "properties": {
    "schema_version": {"const": "0.1.0"},
    "receipt_id": {"type": "string", "pattern": "^RR-[A-Z0-9-]+$"},
    "scenario_id": {"type": "string", "pattern": "^S[0-9]{2}$"},
    "status": {"enum": ["draft", "sandboxed", "paused", "returned", "withdrawn"]},
    "problem": {"type": "object", "additionalProperties": false, "required": ["statement", "public_interest", "evidence_refs"], "properties": {"statement": {"type": "string"}, "public_interest": {"type": "string"}, "evidence_refs": {"type": "array", "items": {"type": "string"}}}},
    "place": {"type": "object", "additionalProperties": false, "required": ["geometry_ref", "geometry_status", "non_ai_path"], "properties": {"geometry_ref": {"type": "string"}, "geometry_status": {"enum": ["provisional", "official", "simulated"]}, "non_ai_path": {"type": "string"}}},
    "data": {"type": "object", "additionalProperties": false, "required": ["purpose", "minimum_fields", "personal_data", "retention"], "properties": {"purpose": {"type": "string"}, "minimum_fields": {"type": "array", "items": {"type": "string"}}, "personal_data": {"type": "string"}, "retention": {"type": "string"}}},
    "system": {"type": "object", "additionalProperties": false, "required": ["deployment_status", "tool_permissions", "forbidden_actions", "abstention_conditions"], "properties": {"deployment_status": {"const": "sandbox_only"}, "tool_permissions": {"type": "array", "items": {"type": "string"}}, "forbidden_actions": {"type": "array", "items": {"type": "string"}}, "abstention_conditions": {"type": "array", "items": {"type": "string"}}}},
    "human_gate": {"type": "object", "additionalProperties": false, "required": ["accountable_role", "reviewer_roles", "decision", "signed_at"], "properties": {"accountable_role": {"type": "string"}, "reviewer_roles": {"type": "array", "items": {"type": "string"}}, "decision": {"enum": ["pending", "allow_sandbox", "pause", "return", "withdraw"]}, "signed_at": {"type": ["string", "null"]}}},
    "rights": {"type": "object", "additionalProperties": false, "required": ["notice", "opt_out", "appeal", "accessibility", "deletion"], "properties": {"notice": {"type": "string"}, "opt_out": {"type": "string"}, "appeal": {"type": "string"}, "accessibility": {"type": "string"}, "deletion": {"type": "string"}}},
    "operations": {"type": "object", "additionalProperties": false, "required": ["service_window", "on_call_role", "fallback", "maintenance_owner", "exit_asset_plan"], "properties": {"service_window": {"type": "string"}, "on_call_role": {"type": "string"}, "fallback": {"type": "string"}, "maintenance_owner": {"type": "string"}, "exit_asset_plan": {"type": "string"}}},
    "evaluation": {"type": "object", "additionalProperties": false, "required": ["baseline_status", "candidate_metrics", "performance_results", "stop_conditions"], "properties": {"baseline_status": {"enum": ["missing", "required", "available"]}, "candidate_metrics": {"type": "array", "items": {"type": "string"}}, "performance_results": {"type": ["object", "null"]}, "stop_conditions": {"type": "array", "items": {"type": "string"}}}},
    "handoff": {"type": "object", "additionalProperties": false, "required": ["from_role", "to_role", "output_object", "next_gate"], "properties": {"from_role": {"type": "string"}, "to_role": {"type": "string"}, "output_object": {"type": "string"}, "next_gate": {"type": "string"}}},
    "disclaimer": {"type": "string"}
  }
}
