{
  "schema_version": "0.1.0",
  "id": "wind-health-point-register",
  "title_zh": "健康气流现场点位预登记",
  "status": "provisional_field_planning",
  "scope": "jingzhang-open-pulse",
  "purpose": "把三处重点区和代表性连接路线预登记为稳定的 point_id，供专业测绘、现场观测和 CFD/扩散模型同点对齐；本文件不是坐标、测量结果、官方边界或健康结论。",
  "geometry_basis": [
    {
      "file": "geometry/key_areas.geojson",
      "status": "provisional_constraint",
      "rule": "正式测量前必须用官方或版本化测绘几何替换并记录版本差异。"
    },
    {
      "file": "geometry/roads.geojson",
      "status": "conceptual_design_layer",
      "rule": "ROAD-001 至 ROAD-004 只用于规划连接关系，不证明公共权属、可进入性或工程中心线。"
    }
  ],
  "coordinate_policy": {
    "coordinates": null,
    "coordinate_status": "pending_survey",
    "why_no_coordinates": "在官方边界、入口、道路红线和现场安全核验缺失时，写入坐标会制造精确感并可能误导测量或公众。",
    "survey_requirement": "专业团队必须在外业前为每个 point_id 登记坐标、测高、障碍物、树冠/廊架状态、访问许可和 geometry_version；任何移动点必须保留旧点与变更原因。"
  },
  "slot_templates": {
    "open_edge": {
      "stratum": "key-area-open-edge",
      "domains": ["WIND-01", "HEAT-03", "SHADE-04"],
      "intent": "重点区开敞边界、节点或树冠/廊架变化处"
    },
    "windward": {
      "stratum": "street-canyon-windward-leeward",
      "domains": ["WIND-01", "AIR-02"],
      "intent": "代表性街谷或围合边界的迎风侧；风向改变时重新标注"
    },
    "leeward": {
      "stratum": "street-canyon-windward-leeward",
      "domains": ["WIND-01", "AIR-02", "HEAT-03"],
      "intent": "与同一 pair_id 的迎风点配对，不得单独解释"
    },
    "accessible_route": {
      "stratum": "accessible-connection",
      "domains": ["HEAT-03", "SHADE-04", "BLUEGREEN-05", "WATER-06"],
      "intent": "实际可走的无障碍主链或最弱段；入口、坡度、遮阴、休息、闭合和回退待现场确认"
    },
    "source_interface": {
      "stratum": "source-interface",
      "domains": ["AIR-02", "WIND-01"],
      "intent": "交通、施工、活动或服务排放源的界面；没有活动时序时不得作源归因"
    },
    "background": {
      "stratum": "background-reference",
      "domains": ["WIND-01", "AIR-02", "HEAT-03"],
      "intent": "由专业团队选择的上游/背景参照关系；不预设站点或代表性"
    }
  },
  "planning_slots": [
    {"point_id":"WHP-001-OPEN","key_area_id":"PROV-KEY-001","route_ref":"KEY_AREA_BOUNDARY","template":"open_edge","pair_id":null,"field_status":"not_measured"},
    {"point_id":"WHP-001-WINDWARD","key_area_id":"PROV-KEY-001","route_ref":"ROAD-001","template":"windward","pair_id":"WHP-001-CANYON","field_status":"not_measured"},
    {"point_id":"WHP-001-LEEWARD","key_area_id":"PROV-KEY-001","route_ref":"ROAD-001","template":"leeward","pair_id":"WHP-001-CANYON","field_status":"not_measured"},
    {"point_id":"WHP-001-ACCESS","key_area_id":"PROV-KEY-001","route_ref":"ROAD-002","template":"accessible_route","pair_id":null,"field_status":"not_measured"},
    {"point_id":"WHP-001-SOURCE","key_area_id":"PROV-KEY-001","route_ref":"ROAD-002","template":"source_interface","pair_id":null,"field_status":"not_measured"},
    {"point_id":"WHP-001-BACKGROUND","key_area_id":"PROV-KEY-001","route_ref":"UPWIND_REFERENCE_TO_BE_SELECTED","template":"background","pair_id":null,"field_status":"not_measured"},
    {"point_id":"WHP-002-OPEN","key_area_id":"PROV-KEY-002","route_ref":"KEY_AREA_BOUNDARY","template":"open_edge","pair_id":null,"field_status":"not_measured"},
    {"point_id":"WHP-002-WINDWARD","key_area_id":"PROV-KEY-002","route_ref":"ROAD-001","template":"windward","pair_id":"WHP-002-CANYON","field_status":"not_measured"},
    {"point_id":"WHP-002-LEEWARD","key_area_id":"PROV-KEY-002","route_ref":"ROAD-001","template":"leeward","pair_id":"WHP-002-CANYON","field_status":"not_measured"},
    {"point_id":"WHP-002-ACCESS","key_area_id":"PROV-KEY-002","route_ref":"ROAD-003","template":"accessible_route","pair_id":null,"field_status":"not_measured"},
    {"point_id":"WHP-002-SOURCE","key_area_id":"PROV-KEY-002","route_ref":"ROAD-003","template":"source_interface","pair_id":null,"field_status":"not_measured"},
    {"point_id":"WHP-002-BACKGROUND","key_area_id":"PROV-KEY-002","route_ref":"UPWIND_REFERENCE_TO_BE_SELECTED","template":"background","pair_id":null,"field_status":"not_measured"},
    {"point_id":"WHP-003-OPEN","key_area_id":"PROV-KEY-003","route_ref":"KEY_AREA_BOUNDARY","template":"open_edge","pair_id":null,"field_status":"not_measured"},
    {"point_id":"WHP-003-WINDWARD","key_area_id":"PROV-KEY-003","route_ref":"ROAD-001","template":"windward","pair_id":"WHP-003-CANYON","field_status":"not_measured"},
    {"point_id":"WHP-003-LEEWARD","key_area_id":"PROV-KEY-003","route_ref":"ROAD-001","template":"leeward","pair_id":"WHP-003-CANYON","field_status":"not_measured"},
    {"point_id":"WHP-003-ACCESS","key_area_id":"PROV-KEY-003","route_ref":"ROAD-004","template":"accessible_route","pair_id":null,"field_status":"not_measured"},
    {"point_id":"WHP-003-SOURCE","key_area_id":"PROV-KEY-003","route_ref":"ROAD-004","template":"source_interface","pair_id":null,"field_status":"not_measured"},
    {"point_id":"WHP-003-BACKGROUND","key_area_id":"PROV-KEY-003","route_ref":"UPWIND_REFERENCE_TO_BE_SELECTED","template":"background","pair_id":null,"field_status":"not_measured"}
  ],
  "pairing_rules": [
    "Every windward/leeward pair must be measured in the same session window and declared wind case.",
    "A background point is a relation selected by the responsible professional, not a claim that Qinghe Station or any nearby station is representative.",
    "A route point is valid only after its entrance, slope, surface, shade, maintenance, closure and safe fallback are verified.",
    "The register may be expanded, merged or rejected after official geometry and safety review; preserve the original point_id and change log."
  ],
  "field_release_gate": {
    "required_before_measurement": [
      "official or versioned surveyed geometry",
      "point coordinates and height register",
      "access permission and safety plan",
      "instrument calibration/collocation record",
      "session matrix and source-activity schedule"
    ],
    "required_before_metric_transition": "All requirements in visual/assets/wind-health-field-protocol.json and the relevant WIND-01/AIR-02/HEAT-03/SHADE-04/BLUEGREEN-05/WATER-06 gate must be satisfied.",
    "current_rule": "All slots are planning slots only; no slot contains a measurement and all six metrics remain unknown."
  },
  "source_refs": [
    "AIJ-CFD-PEDESTRIAN-WIND-2008",
    "AIJ-CFD-GUIDEBOOK",
    "HAIDIAN-CLIMATE-NORMS-DATASET-2025",
    "HAIDIAN-METEOROLOGICAL-NETWORK-2023",
    "QINGHE-STATION-WIND-MONITORING-2021"
  ]
}
