{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "open-pulse-test-window-record-0.2.0",
  "title": "Jing-Zhang Open Pulse bounded test-window record",
  "description": "An independently designed concept-only record for one reversible, human-controlled test window. It is not a deployment approval, certification or performance claim.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "record_version",
    "record_id",
    "purpose",
    "window",
    "place_window",
    "public_interface",
    "human_control",
    "data_contract",
    "observation",
    "release_decision",
    "restoration",
    "disclaimer"
  ],
  "properties": {
    "record_version": {"const": "0.2.0"},
    "record_id": {"type": "string", "pattern": "^OPW-[A-Z0-9-]{6,64}$"},
    "purpose": {
      "type": "object",
      "additionalProperties": false,
      "required": ["scenario_id", "public_question", "ordinary_service"],
      "properties": {
        "scenario_id": {"type": "string", "pattern": "^S[0-9]{2}$"},
        "public_question": {"type": "string", "minLength": 10},
        "ordinary_service": {"type": "string", "minLength": 10}
      }
    },
    "window": {
      "type": "object",
      "additionalProperties": false,
      "required": ["stage", "status", "planned_start", "planned_end"],
      "properties": {
        "stage": {"enum": ["rehearsal", "bounded_test", "review", "closed"]},
        "status": {"enum": ["proposed", "held", "paused", "closed", "withdrawn"]},
        "planned_start": {"type": ["string", "null"]},
        "planned_end": {"type": ["string", "null"]}
      }
    },
    "place_window": {
      "type": "object",
      "additionalProperties": false,
      "required": ["spatial_ref", "boundary_status", "route_rule", "capacity_rule"],
      "properties": {
        "spatial_ref": {"type": "string"},
        "boundary_status": {"enum": ["provisional", "official", "simulated"]},
        "route_rule": {"type": "string", "minLength": 10},
        "capacity_rule": {"type": "string", "minLength": 10}
      }
    },
    "public_interface": {
      "type": "object",
      "additionalProperties": false,
      "required": ["notice", "accessibility", "complaint_route", "non_ai_alternative"],
      "properties": {
        "notice": {"type": "string", "minLength": 10},
        "accessibility": {"type": "string", "minLength": 10},
        "complaint_route": {"type": "string", "minLength": 10},
        "non_ai_alternative": {"type": "string", "minLength": 10}
      }
    },
    "human_control": {
      "type": "object",
      "additionalProperties": false,
      "required": ["accountable_role", "stop_role", "review_roles", "stop_triggers", "decision_rights"],
      "properties": {
        "accountable_role": {"type": "string"},
        "stop_role": {"type": "string"},
        "review_roles": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "stop_triggers": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "decision_rights": {"type": "array", "minItems": 1, "items": {"type": "string"}}
      }
    },
    "data_contract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["purpose", "minimum_fields", "personal_data_scope", "retention_rule", "deletion_check"],
      "properties": {
        "purpose": {"type": "string", "minLength": 10},
        "minimum_fields": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "personal_data_scope": {"enum": ["none", "possible", "required"]},
        "retention_rule": {"type": "string", "minLength": 10},
        "deletion_check": {"type": "string", "minLength": 10}
      }
    },
    "observation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["baseline_status", "observation_set", "result_status", "review_method"],
      "properties": {
        "baseline_status": {"enum": ["missing", "required", "available"]},
        "observation_set": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "result_status": {"enum": ["not_run", "recorded", "inconclusive"]},
        "review_method": {"type": "string", "minLength": 10}
      }
    },
    "release_decision": {
      "type": "object",
      "additionalProperties": false,
      "required": ["decision", "reason", "next_gate", "signed_at"],
      "properties": {
        "decision": {"enum": ["hold", "allow_rehearsal", "allow_bounded_test", "return_to_ordinary_use", "withdraw"]},
        "reason": {"type": "string", "minLength": 10},
        "next_gate": {"type": "string", "minLength": 10},
        "signed_at": {"type": ["string", "null"]}
      }
    },
    "restoration": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ordinary_use_path", "asset_action", "public_record"],
      "properties": {
        "ordinary_use_path": {"type": "string", "minLength": 10},
        "asset_action": {"type": "string", "minLength": 10},
        "public_record": {"type": "string", "minLength": 10}
      }
    },
    "disclaimer": {"type": "string", "minLength": 20}
  }
}
