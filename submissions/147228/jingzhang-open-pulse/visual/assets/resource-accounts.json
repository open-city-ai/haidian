      "custodian": "conceptual: planning and rights team",
      "release_gate": "No spatial commitment without versioned source and owner confirmation.",
      "evidence": ["geometry/site_boundary.geojson", "geometry/key_areas.geojson", "visual/assets/copyright-ledger.json"]
    },
    {
      "account_id": "RA-02",
      "name_zh": "气候水务与生态账",
      "inputs": ["DEM", "drainage/outfalls", "wind/heat/PM2.5 field observations", "soil/water/ecology baseline"],
      "custodian": "conceptual: municipal and environmental professionals",
      "release_gate": "Unknown remains unknown until calibrated inputs, error and stop conditions are published.",
      "evidence": ["visual/assets/wind-health-validation-plan.json", "visual/assets/wind-health-field-protocol.json", "geometry/green_space.geojson"]
    },
    {
      "account_id": "RA-03",
      "name_zh": "算力、模型与数据权利账",
      "inputs": ["model card", "minimum data", "access rights", "retention/deletion record"],
      "custodian": "conceptual: data-governance and test operator",
      "release_gate": "No token without a human alternative, public state, appeal route and deletion rule.",
      "evidence": ["visual/assets/open-pulse-relay-receipt.schema.json", "visual/assets/example-s02-embodied-receipt.json", "visual/assets/scenario-operation-matrix.json"]
    },
    {
      "account_id": "RA-04",
      "name_zh": "人类体验与公共参与账",
      "inputs": ["paired walks", "stratified listening", "complaints", "paper/staffed/multilingual access"],
      "custodian": "conceptual: public-interest audit team",
      "release_gate": "No average score may conceal a group-specific route break or unresolved complaint.",
      "evidence": ["visual/assets/public-interest-audit.json", "visual/assets/key-area-node-plans.json"]
    },
    {
      "account_id": "RA-05",
      "name_zh": "资产、备件与维护账",
      "inputs": ["asset IDs", "owner", "inspection triggers", "spares", "work orders", "exit archive"],
      "custodian": "conceptual: municipal asset owner",
      "release_gate": "Two overdue cycles or missing spares freeze expansion and trigger a passive fallback.",
      "evidence": ["visual/assets/component-library.json", "visual/assets/operations-matrix.json", "visual/assets/qa-readiness.json"]
    }
  ]
