{
  "schema_version": "1.0.0",
  "title_zh": "京张开源脉冲五本资源账",
  "title_en": "Five Open Pulse resource accounts",
  "author": "许丙南",
  "status": "conceptual_suggestion_for_professional_refinement",
  "boundary_note": "Accounts identify what must be secured and audited; they are not budgets, funding commitments or procurement approvals.",
  "accounts": [
