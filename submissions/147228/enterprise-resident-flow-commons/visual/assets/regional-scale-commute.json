      {"id": "W1_weather_bicycle", "runner_scenario_id": "W1", "label_zh": "强天气/骑行受限", "label_en": "severe weather / bicycle constrained", "description": "Bicycle and walking conditions deteriorate; no air candidate is opened to fill the gap."},
      {"id": "D1_capacity_shock", "runner_scenario_id": "D1", "label_zh": "多方式容量冲击", "label_en": "multimodal capacity shock", "description": "Declared service capacity is temporarily reduced across modes to screen spare-capacity fragility."}
    ],
    "hard_gate_constraints": {
      "minimum_accessibility_completion_proxy": 0.85,
      "maximum_worst_group_accessibility_gap_proxy_points": 24,
      "maximum_worst_group_accessibility_p10_gap_proxy_points": 30,
      "maximum_worst_group_satisfaction_gap_proxy_points": 18,
      "maximum_worst_group_satisfaction_p10_gap_proxy_points": 30,
      "maximum_stress_peak_mode_load_ratio": 1.75,
      "require_mass_conservation": true,
      "require_all_agents_processed": true,
      "air_candidate_must_remain_blocked": true
    },
    "selection_order": ["nominal_gate", "stress_gate_count", "worst_case_satisfaction_proxy_max", "worst_group_accessibility_p10_gap_proxy_min", "worst_group_accessibility_gap_proxy_min", "worst_peak_mode_load_ratio_min", "mean_generalized_cost_proxy_min"],
    "outputs": ["candidate_by_scenario_summary", "stress_gate_status", "worst_case_satisfaction_proxy", "worst_group_accessibility_p10_gap_proxy_points", "worst_group_accessibility_gap_proxy_points", "worst_peak_mode_load_ratio", "recovery_calibration_requirements"],
    "interpretation": "This is a transparent robustness screen over declared synthetic perturbations. It does not prove local resilience or select an implementation policy; a failure is a stop-and-calibrate signal, and the selected nominal candidate remains provisional until dated disruption, weather, capacity, accessibility and behavioural evidence are available.",
    "calibration_required": ["dated metro and bus disruption logs", "weather and bicycle service cancellation records", "mode and station capacity by 15-minute slice", "grouped accessibility and care-trip completion", "observed fallback acceptance and recovery time", "resident and employee satisfaction/intercept evidence"]
