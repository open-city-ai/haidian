  "robustness_screen": {
    "method": "full_population_candidate_replay_across_declared_stress_scenarios",
    "status": "synthetic_robustness_screen_not_local_resilience",
    "purpose": "Replay every candidate against nominal, metro disruption, severe-weather bicycle loss and multimodal capacity-shock scenarios so a high nominal satisfaction proxy cannot hide a fragile or inequitable operating pattern.",
    "scenarios": [
      {"id": "N0_nominal", "runner_scenario_id": "O1", "label_zh": "名义地面协同", "label_en": "nominal ground coordination", "description": "O1 service and reliability assumptions used as the comparable nominal screen."},
