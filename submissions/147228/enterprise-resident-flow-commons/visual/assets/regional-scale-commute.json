  "optimization_objective": {
    "order": ["hard_gates", "mass_conservation", "accessibility_continuity", "accessibility_distribution_tail", "satisfaction_proxy_max", "generalized_cost_min", "p90_time_proxy_min", "people_flow_conflict_min", "external_car_inflow_min", "vehicle_km_proxy_min"],
