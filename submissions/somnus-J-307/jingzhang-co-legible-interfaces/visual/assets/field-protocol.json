{
  "schema_version": "0.2.0",
  "project": "jingzhang-co-legible-interfaces",
  "maturity": "protocol-draft-not-field-validated",
  "applies_to": [
    "tst-zhongzhiyuan-co-legible-corner",
    "tst-ai-origin-inclusive-wayfinding",
    "tst-dazhongsi-visual-congestion"
  ],
  "required_records": [
    "test-version-and-site-permission",
    "route-viewpoint-and-environment-condition",
    "participant-group-and-consent-mode",
    "visible-observation",
    "legible-observation",
    "timely-observation",
    "failure-and-near-failure",
    "ai-on-or-ai-off-condition",
    "human-review-and-decision",
    "backout-version"
  ],
  "comparison_design": {
    "baseline": "fixed spatial and staffed path with AI off",
    "candidate": "same spatial task with a reversible AI support function",
    "rule": "Record visible, legible and timely observations separately; do not average them.",
    "repeat_conditions": [
      "day-and-dusk",
      "normal-and-adverse-weather-when-safe",
      "normal-and-peak-load",
      "temporary-change-or-construction-version"
    ]
  },
  "participant_strata": [
    "older-or-low-vision-pedestrians",
    "wheelchair-baby-carriage-or-caregiver-users",
    "first-time-visitors",
    "cycling-couriers-or-service-workers",
    "maintenance-and-operations-staff"
  ],
  "stop_conditions": [
    "professional-reviewer-identifies-safety-risk",
    "accessible-alternative-is-not-available",
    "consent-or-privacy-condition-is-breached",
    "site-condition-departs-from-approved-test-version",
    "ai-output-cannot-be-human-reviewed-or-backed-out"
  ],
  "open_gates": [
    "sample-size",
    "route-and-viewpoints",
    "repeat-count",
    "professional-thresholds",
    "site-permission",
    "ethics-accessibility-and-participant-protection"
  ]
}
