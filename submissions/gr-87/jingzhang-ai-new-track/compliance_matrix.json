  "mechanism_register": {
    "version": "v0.5",
    "mechanism_id": "JZ-SWITCHBACK-001",
    "mechanism_name_zh": "人字回退（Switchback Fallback）",
    "mechanism_name_en": "Switchback Fallback",
    "version_note_zh": "v0.5：switchback_states 四态 normal/degraded/paused/retired 不变；NT-6 服务契约六步不变；可执行制品改只读复演（不改写包内文件）；三处折返试验段以 geometry/key_areas.geojson 的 mechanism_window_id/switchback_window_id 属性空间落位；法条条号核校（生成式AI办法第15条、无障碍环境建设法第39条、国办发〔2020〕45号政策文件）。",
    "heritage_binding_zh": "京张铁路1905-1909年建成、詹天佑任总工程师、中国自主设计修建第一条干线铁路、青龙桥'人'字形线路双机车折返爬坡（公开史料常识，仅作命名与叙事锚点，不等同于已认证历史结论）。AI 服务遇障碍时如人字线机车折返回人工轨道。",
    "service_chain_steps": [
      "choose",
      "use",
      "stop",
      "appeal",
      "human_return",
      "exit_restore"
    ],
    "nt6_service_contract": [
      {
        "step": "declare",
        "name_zh": "定标",
        "name_en": "Declare",
        "jingzhang_naming_zh": "站台登记",
        "requirement_zh": "服务边界、责任角色、回退对象公开登记",
        "timeout_action_zh": "未登记不得运行"
      },
      {
        "step": "time",
        "name_zh": "计时",
        "name_en": "Time",
        "jingzhang_naming_zh": "时刻表",
        "requirement_zh": "每项响应公开时限；超时自动转人工",
        "timeout_action_zh": "超时即折返人工"
      },
      {
        "step": "handoff",
        "name_zh": "接管",
        "name_en": "Handoff",
        "jingzhang_naming_zh": "人字折返",
        "requirement_zh": "保留真人与非 AI 路径，不设数字门槛",
        "timeout_action_zh": "人工不可用即暂停"
      },
      {
        "step": "notify",
        "name_zh": "告知",
        "name_en": "Notify",
        "jingzhang_naming_zh": "站台广播",
        "requirement_zh": "障碍事件 24h 内主动告知受影响人",
        "timeout_action_zh": "未告知即降级"
      },
      {
        "step": "review",
        "name_zh": "复核",
        "name_en": "Review",
        "jingzhang_naming_zh": "折返复测",
        "requirement_zh": "申诉限时回应 + 独立复盘",
        "timeout_action_zh": "逾期即暂停"
      },
      {
        "step": "sunset",
        "name_zh": "退场",
        "name_en": "Sunset",
        "jingzhang_naming_zh": "撤站清场",
        "requirement_zh": "周期续期/缩减/终止 + 数据删除 + 退出公告",
        "timeout_action_zh": "到期不续即退场"
