{
  "schema_version": "0.1.0",
  "concept": "数据对账 (Data Reconciliation) — double-entry bookkeeping",
  "canonical_contract": {
    "zh": "proposal.md",
    "en": "proposal.en.md"
  },
  "methodology_source_zh": "方法论移植自会计学的复式记账与期末对账：数据回执是单式记录（只记使用方），数据对账是双式闭环（使用方获得=借，公共池记录=贷），期末对账核平。不能核平的回执是差异，不是已结记录。",
  "methodology_source_en": "Methodology transplanted from double-entry bookkeeping and period-end reconciliation: the Data Receipt is a single-entry record (the user side only); Data Reconciliation is a double-entry loop (user receives = debit, public pool records = credit) reconciled at period end. A receipt that cannot be reconciled is a discrepancy, not a closed record.",
  "reconciliation_rules": [
    {
      "id": "R1",
      "rule_zh": "每笔数据使用必须成对记账（借=使用方获得，贷=公共池记录），借贷不平即标记差异"
    },
    {
      "id": "R2",
      "rule_zh": "期末对账（季度）：核对全部回执的借贷平衡、保留期与删除记录；差异须在下一对账周期前澄清"
    },
    {
      "id": "R3",
      "rule_zh": "对账结果公开（脱敏）；差异记录进入公共台账，接受公众与监管查阅"
    }
  ],
  "negative_space_baseline_zh": "无数据基线：无任何数据服务时，市民仍能通过人工窗口、纸面表格与社区网络办成基本服务。数据服务是可关闭的叠加层，对账确保其关闭时不留未结记录。",
  "negative_space_baseline_en": "No-data baseline: without any data service, citizens can still complete basic services through staffed windows, paper forms and community networks. Data services are a shuttable overlay; reconciliation ensures no unsettled records remain when they close.",
