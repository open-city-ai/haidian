{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "jingzhang-timekeeping-belt/timetable.schema.json",
  "title": "运行时刻表 Service Timetable v0.2",
  "description": "京张授时带的核心治理接口：每个进入公共空间的 AI 服务持有一张机器可读的运行时刻表。时刻表含版本绑定（进化即失效：服务版本变更→对时资格作废→重新对时）与探针策略（红蓝对时：在人工核准的类别内生成对抗性探针，防止静态基准被背题）。时刻表是概念治理协议草案，不是现行政府系统、法定档案或已上线平台。到期未对时的服务必须自动降级到非 AI 等价路径；误点记录公开。",
  "type": "object",
  "required": [
    "service_id",
    "public_purpose_zh",
    "service_scope",
    "minimum_data",
    "responsible_role",
    "non_ai_path_zh",
    "baseline_ref",
    "time_check_window",
    "degrade_plan",
    "delay_ledger",
    "version_binding",
    "probe_policy"
  ],
  "additionalProperties": false,
  "properties": {
    "service_id": {
      "type": "string",
      "pattern": "^SVC-[A-Z0-9-]+$",
      "description": "服务标识"
    },
    "public_purpose_zh": {
      "type": "string",
      "minLength": 8,
      "description": "公共目的：这项服务替公众解决什么问题"
    },
    "service_scope": {
      "type": "object",
      "required": [
        "users_zh",
        "spatial_node",
        "excluded_uses_zh"
      ],
      "additionalProperties": false,
      "properties": {
        "users_zh": {
          "type": "string",
          "description": "服务对象"
        },
        "spatial_node": {
          "type": "string",
          "description": "空间边界：对应 public_space.geojson 中的节点 id"
        },
        "excluded_uses_zh": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "description": "明确排除的用途"
        }
      }
    },
    "minimum_data": {
      "type": "object",
      "required": [
        "fields_zh",
        "retention_days",
        "personal_data"
      ],
      "additionalProperties": false,
      "properties": {
        "fields_zh": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "最小必要数据字段"
        },
        "retention_days": {
          "type": "integer",
          "minimum": 0,
          "description": "保留天数"
        },
        "personal_data": {
          "type": "boolean",
          "const": false,
          "description": "本概念阶段一律不采集个人数据"
        }
      }
    },
    "responsible_role": {
      "type": "object",
      "required": [
        "role_zh",
        "assigned"
      ],
      "additionalProperties": false,
      "properties": {
        "role_zh": {
          "type": "string",
          "description": "人工责任角色（角色而非具体机构；当前不预设主体）"
        },
        "assigned": {
          "type": "boolean",
          "description": "是否已有经授权主体承担该角色；概念阶段为 false"
        }
      }
    },
    "non_ai_path_zh": {
      "type": "string",
      "minLength": 8,
      "description": "非 AI 等价路径：不使用智能设备的居民获得同等基本服务的方式"
    },
    "baseline_ref": {
      "type": "object",
      "required": [
        "baseline_id",
        "version",
        "maintained_at_zh",
        "established"
      ],
      "additionalProperties": false,
      "properties": {
        "baseline_id": {
          "type": "string",
          "description": "人工基准答案集标识"
        },
        "version": {
          "type": "string"
        },
        "maintained_at_zh": {
          "type": "string",
          "description": "基准维护地点（概念上位于基准站·众智园）"
        },
        "established": {
          "type": "boolean",
          "description": "基准是否已由人工建立；概念阶段为 false"
        }
      }
    },
    "time_check_window": {
      "type": "object",
      "required": [
        "interval_days",
        "last_check_tick",
        "next_check_due_tick",
        "deviation_tolerance_zh"
      ],
      "additionalProperties": false,
      "description": "对时窗。演练使用抽象 tick 而非真实日期，保证脚本确定性可复跑。",
      "properties": {
        "interval_days": {
          "type": "integer",
          "minimum": 1,
          "maximum": 180,
          "description": "对时周期上限；任何服务窗口不超过 180 天"
        },
        "last_check_tick": {
          "type": "integer",
          "minimum": 0
        },
        "next_check_due_tick": {
          "type": "integer",
          "minimum": 1
        },
        "deviation_tolerance_zh": {
          "type": "string",
          "description": "偏差限差的口径描述；具体阈值由基准维护角色与专业团队另行确定"
        }
      }
    },
    "degrade_plan": {
      "type": "object",
      "required": [
        "trigger_zh",
        "steps_zh",
        "recovers_via_zh"
      ],
      "additionalProperties": false,
      "properties": {
        "trigger_zh": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 2,
          "description": "降级触发条件（至少含：到期未对时、对时超差）"
        },
        "steps_zh": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 3,
          "description": "降级步骤：停 AI 入口→切换非 AI 路径→公开误点记录"
        },
        "recovers_via_zh": {
          "type": "string",
          "description": "恢复方式：只能通过重新对时合格续期，不得静默恢复"
        }
      }
    },
    "delay_ledger": {
      "type": "array",
      "description": "误点档案：公开记录每次到期未对时、对时超差与降级事件；只增不删",
      "items": {
        "type": "object",
        "required": [
          "tick",
          "event",
          "note_zh"
        ],
        "additionalProperties": false,
        "properties": {
          "tick": {
            "type": "integer",
            "minimum": 0
          },
          "event": {
            "type": "string",
            "enum": [
              "overdue_degrade",
              "deviation_degrade",
              "on_time_renewal",
              "retired",
              "version_voided",
              "probe_failed"
            ]
          },
          "note_zh": {
            "type": "string"
          }
        }
      }
    },
    "version_binding": {
      "type": "object",
      "required": [
        "service_version_hash",
        "voided_on_version_change",
        "lineage_note_zh"
      ],
      "additionalProperties": false,
      "description": "进化即失效：对时资格绑定服务版本哈希；任何版本变更使资格作废（voided），须经 T3 沙箱与重新对时后以新窗口回归。资格不继承，档案按版本谱系继承。公共空间内不允许热更新。",
      "properties": {
        "service_version_hash": {
          "type": "string",
          "minLength": 8,
          "description": "服务版本标识（模型/提示词/依赖任一变更即变化）"
        },
        "voided_on_version_change": {
          "type": "boolean",
          "const": true,
          "description": "版本变更即作废——协议强制约束"
        },
        "lineage_note_zh": {
          "type": "string",
          "description": "版本谱系说明：误点档案跨版本连续记录"
        }
      }
    },
    "probe_policy": {
      "type": "object",
      "required": [
        "approved_classes_zh",
        "adjudication_role_zh",
        "probe_source_zh"
      ],
      "additionalProperties": false,
      "description": "红蓝对时：对时不只回放静态基准，还包含在人工核准类别内生成的对抗性探针，防止服务对已知基准过拟合（背题）。人类保留基准维护权、类别核准权与争议裁决权。",
      "properties": {
        "approved_classes_zh": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "description": "人工核准的探针类别"
        },
        "adjudication_role_zh": {
          "type": "string",
          "description": "裁决角色（人类）"
        },
        "probe_source_zh": {
          "type": "string",
          "description": "探针生成方式（生产环境为受约束的校时agent；演练为确定性模板）"
        }
      }
    }
  }
}