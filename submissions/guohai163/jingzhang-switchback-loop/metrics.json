    "land_use_total_area_sqm": {
      "status": "known",
      "value": 11412845.509,
      "unit": "sqm",
      "source_files": [
        "geometry/land_use.geojson"
      ],
      "formula": "sum(area(LAND_USE features)) in EPSG:4548",
      "confidence": "medium",
      "assumptions": [
        "A-LANDUSE-PARTITION"
      ],
      "note_zh": "用地图层对总体设计范围实现无缝无叠全覆盖，与 site_area_sqm 的偏差在浮点精度范围内。"
    },
    "land_use_coverage_ratio": {
      "status": "known",
      "value": 1.0,
      "unit": "ratio",
      "source_files": [
        "geometry/land_use.geojson",
        "geometry/site_boundary.geojson"
      ],
      "formula": "min(land_use_total_area_sqm, site_area_sqm) / site_area_sqm",
      "confidence": "medium",
      "assumptions": [
        "A-LANDUSE-PARTITION",
        "A-PROJECTION-CHORD"
      ],
      "note_zh": "等于1表示用地划分无缝无叠覆盖全部提交边界；分带切分带来的投影弦长残差另见 land_use_partition_residual_sqm。"
    },
    "land_use_partition_residual_sqm": {
      "status": "known",
      "value": 20.124,
      "unit": "sqm",
      "source_files": [
        "geometry/land_use.geojson",
        "geometry/site_boundary.geojson"
      ],
      "formula": "abs(land_use_total_area_sqm - site_area_sqm)",
      "confidence": "high",
      "assumptions": [
        "A-PROJECTION-CHORD"
      ],
      "note_zh": "用地分带在纬度方向加密顶点后，投影平面上的折线与原始弦线存在约百万分之二的面积差；远小于 spatial_review 允许的 0.01% 拓扑容差。"
    },
