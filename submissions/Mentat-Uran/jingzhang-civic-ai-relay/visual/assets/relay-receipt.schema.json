{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/jingzhang/relay-receipt.schema.json",
  "title": "Jing-Zhang Civic AI Relay Receipt",
  "description": "Concept governance record for one bounded AI scenario from problem through rollback or retirement; not an official system or deployment approval.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "receipt_id",
    "scenario_id",
    "status",
    "problem",
    "place",
    "data",
    "permissions",
    "human_gate",
    "test",
    "evidence",
    "decision",
    "feedback",
    "rollback_retirement",
    "disclaimer"
  ],
  "properties": {
    "schema_version": {
      "const": "0.3.0"
    },
    "receipt_id": {
      "type": "string",
      "pattern": "^RR-[A-Z0-9-]{6,64}$"
    },
    "scenario_id": {
      "type": "string",
      "pattern": "^SC-[0-9]{2}$"
    },
    "status": {
      "enum": [
        "proposed",
        "screened",
        "sandboxed",
        "limited_trial",
        "paused",
        "rejected",
        "adopted",
        "retired",
        "rolled_back"
      ]
    },
    "problem": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "statement",
        "public_interest",
        "proposer_role",
        "evidence_refs"
      ],
      "properties": {
        "statement": {
          "type": "string"
        },
        "public_interest": {
          "type": "string"
        },
        "proposer_role": {
          "type": "string"
        },
        "evidence_refs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        }
      }
    },
    "place": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "geometry_ref",
        "geometry_status",
        "space_mode",
        "non_ai_path",
        "site_verification_status"
      ],
      "properties": {
        "geometry_ref": {
          "type": "string"
        },
        "geometry_status": {
          "enum": [
            "provisional",
            "official",
            "not_applicable"
          ]
        },
        "space_mode": {
          "type": "string"
        },
        "non_ai_path": {
          "type": "string"
        },
        "site_verification_status": {
          "enum": [
            "pending",
            "verified",
            "not_applicable"
          ]
        }
      }
    },
    "data": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "purpose",
        "minimum_fields",
        "personal_data",
        "retention",
        "deletion_verification",
        "notice",
        "opt_out"
      ],
      "properties": {
        "purpose": {
          "type": "string"
        },
        "minimum_fields": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        },
        "personal_data": {
          "enum": [
            "none",
            "possible",
            "required"
          ]
        },
        "retention": {
          "type": "string"
        },
        "deletion_verification": {
          "type": "string"
        },
        "notice": {
          "type": "string"
        },
        "opt_out": {
          "type": "string"
        }
      }
    },
    "permissions": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "deployment_status",
        "model_or_ruleset",
        "version",
        "artifact_hash",
        "allowed_actions",
        "forbidden_actions",
        "abstention_conditions",
        "external_connection"
      ],
      "properties": {
        "deployment_status": {
          "enum": [
            "concept_only",
            "sandbox_only",
            "limited_trial",
            "operational"
          ]
        },
        "model_or_ruleset": {
          "type": "string"
        },
        "version": {
          "type": "string"
        },
        "artifact_hash": {
          "type": [
            "string",
            "null"
          ]
        },
        "allowed_actions": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        },
        "forbidden_actions": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        },
        "abstention_conditions": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        },
        "external_connection": {
          "enum": [
            "disabled",
            "approved_limited",
            "operational"
          ]
        }
      }
    },
    "human_gate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "accountable_role",
        "accountable_role_status",
        "reviewer_roles",
        "takeover_role",
        "non_ai_fallback_verified",
        "decision",
        "signed_at",
        "decision_diff"
      ],
      "properties": {
        "accountable_role": {
          "type": "string"
        },
        "accountable_role_status": {
          "enum": [
            "unassigned",
            "candidate",
            "confirmed"
          ]
        },
        "reviewer_roles": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        },
        "takeover_role": {
          "type": "string"
        },
        "non_ai_fallback_verified": {
          "enum": [
            "not_run",
            "pass",
            "fail"
          ]
        },
        "decision": {
          "enum": [
            "pending",
            "allow_sandbox",
            "allow_limited_trial",
            "pause",
            "reject",
            "retire",
            "rollback"
          ]
        },
        "signed_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "decision_diff": {
          "type": "string"
        }
      }
    },
    "test": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scope",
        "run_status",
        "fixture_count",
        "test_cases",
        "acceptance_criteria",
        "stop_conditions",
        "baseline_status"
      ],
      "properties": {
        "scope": {
          "type": "string"
        },
        "run_status": {
          "enum": [
            "not_run",
            "running",
            "completed",
            "stopped"
          ]
        },
        "fixture_count": {
          "type": "integer",
          "minimum": 0
        },
        "test_cases": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "topic",
              "risk_level",
              "expected_human_queue"
            ],
            "properties": {
              "id": {
                "type": "string"
              },
              "topic": {
                "type": "string"
              },
              "risk_level": {
                "enum": [
                  "low",
                  "medium",
                  "high"
                ]
              },
              "expected_human_queue": {
                "type": "string"
              }
            }
          }
        },
        "acceptance_criteria": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "criterion",
              "required",
              "result",
              "evidence_ref"
            ],
            "properties": {
              "id": {
                "type": "string"
              },
              "criterion": {
                "type": "string"
              },
              "required": {
                "type": "boolean"
              },
              "result": {
                "enum": [
                  "pass",
                  "fail",
                  null
                ]
              },
              "evidence_ref": {
                "type": [
                  "string",
                  "null"
                ]
              }
            }
          }
        },
        "stop_conditions": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        },
        "baseline_status": {
          "enum": [
            "missing",
            "partial",
            "verified"
          ]
        }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "performance_results",
        "route_log_ref",
        "human_comparison_record",
        "negative_results",
        "deletion_record",
        "evidence_status"
      ],
      "properties": {
        "performance_results": {
          "type": [
            "object",
            "null"
          ]
        },
        "route_log_ref": {
          "type": [
            "string",
            "null"
          ]
        },
        "human_comparison_record": {
          "type": [
            "string",
            "null"
          ]
        },
        "negative_results": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "deletion_record": {
          "type": [
            "object",
            "null"
          ]
        },
        "evidence_status": {
          "enum": [
            "not_generated",
            "partial",
            "complete"
          ]
        }
      }
    },
    "decision": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "outcome",
        "decided_by_role",
        "signed_at",
        "reasons",
        "decision_diff"
      ],
      "properties": {
        "outcome": {
          "enum": [
            "pending",
            "adopt",
            "reject",
            "pause",
            "retest",
            "retire",
            "rollback"
          ]
        },
        "decided_by_role": {
          "type": "string"
        },
        "signed_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "reasons": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "decision_diff": {
          "type": "string"
        }
      }
    },
    "feedback": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "feedback_status",
        "channels",
        "appeal",
        "accessibility",
        "public_report_ref",
        "maintenance_owner",
        "maintenance_owner_status",
        "cost_status",
        "next_gate"
      ],
      "properties": {
        "feedback_status": {
          "enum": [
            "not_collected",
            "partial",
            "complete"
          ]
        },
        "channels": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "appeal": {
          "type": "string"
        },
        "accessibility": {
          "type": "string"
        },
        "public_report_ref": {
          "type": [
            "string",
            "null"
          ]
        },
        "maintenance_owner": {
          "type": "string"
        },
        "maintenance_owner_status": {
          "enum": [
            "unassigned",
            "candidate",
            "confirmed"
          ]
        },
        "cost_status": {
          "enum": [
            "unknown",
            "bounded_concept",
            "verified"
          ]
        },
        "next_gate": {
          "type": "string"
        }
      }
    },
    "rollback_retirement": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "triggers",
        "ordered_actions",
        "data_disposition",
        "retained_assets",
        "exit_owner",
        "exit_owner_status",
        "completion_status",
        "completion_evidence"
      ],
      "properties": {
        "triggers": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        },
        "ordered_actions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "step",
              "action",
              "completed",
              "completion_evidence"
            ],
            "properties": {
              "step": {
                "type": "integer",
                "minimum": 1
              },
              "action": {
                "type": "string"
              },
              "completed": {
                "type": "boolean"
              },
              "completion_evidence": {
                "type": [
                  "string",
                  "null"
                ]
              }
            }
          }
        },
        "data_disposition": {
          "type": "string"
        },
        "retained_assets": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "exit_owner": {
          "type": "string"
        },
        "exit_owner_status": {
          "enum": [
            "unassigned",
            "candidate",
            "confirmed"
          ]
        },
        "completion_status": {
          "enum": [
            "not_required",
            "not_started",
            "partial",
            "complete"
          ]
        },
        "completion_evidence": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "disclaimer": {
      "type": "string"
    }
  }
}
