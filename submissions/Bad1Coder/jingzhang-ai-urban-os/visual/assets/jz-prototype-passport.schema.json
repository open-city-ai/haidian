{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:open-city-ai:jz-prototype-passport:1.0.0",
  "title": "Jing-Zhang physical prototype passport",
  "description": "A strict, concept-stage machine contract for one physical AI urban-design prototype. It records a node-zone role chain, one component lineage, exposure boundaries, human continuity, physical-state receipts, stop rights, and exit to repair or reuse. A valid concept record is not proof of a pilot, permit, capacity, ownership, funding, geometry, or field witness.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "passport_id",
    "prototype_id",
    "scenario_card_id",
    "prototype_name",
    "document_status",
    "spatial_chain",
    "component_lineage",
    "ai_contract",
    "physical_kit",
    "exposure_register",
    "service_continuity",
    "physical_state_receipts",
    "stop_review_and_rights",
    "restoration_and_transfer",
    "unsecured_dependencies",
    "claim_boundary"
  ],
  "properties": {
    "contract_version": {
      "type": "string",
      "const": "1.0.0"
    },
    "passport_id": {
      "type": "string",
      "pattern": "^JZ-[A-Z0-9-]+-PASSPORT$",
      "minLength": 8
    },
    "prototype_id": {
      "type": "string",
      "pattern": "^JZ-[0-9]{3}$"
    },
    "scenario_card_id": {
      "type": "string",
      "pattern": "^SC-[0-9]{2}$"
    },
    "prototype_name": {
      "type": "string",
      "minLength": 3
    },
    "document_status": {
      "$ref": "#/$defs/documentStatus"
    },
    "spatial_chain": {
      "$ref": "#/$defs/spatialChain"
    },
    "component_lineage": {
      "$ref": "#/$defs/componentLineage"
    },
    "ai_contract": {
      "$ref": "#/$defs/aiContract"
    },
    "physical_kit": {
      "$ref": "#/$defs/physicalKit"
    },
    "exposure_register": {
      "$ref": "#/$defs/exposureRegister"
    },
    "service_continuity": {
      "$ref": "#/$defs/serviceContinuity"
    },
    "physical_state_receipts": {
      "type": "array",
      "prefixItems": [
        {
          "$ref": "#/$defs/notDeployedState"
        },
        {
          "$ref": "#/$defs/inUseState"
        },
        {
          "$ref": "#/$defs/safelyStoppedState"
        },
        {
          "$ref": "#/$defs/restoredOrRelocatedState"
        }
      ],
      "items": false,
      "minItems": 4,
      "maxItems": 4
    },
    "stop_review_and_rights": {
      "$ref": "#/$defs/stopReviewAndRights"
    },
    "restoration_and_transfer": {
      "$ref": "#/$defs/restorationAndTransfer"
    },
    "unsecured_dependencies": {
      "$ref": "#/$defs/unsecuredDependencies"
    },
    "claim_boundary": {
      "$ref": "#/$defs/claimBoundary"
    }
  },
  "$defs": {
    "conceptStatus": {
      "type": "string",
      "enum": [
        "concept_only",
        "pending_field_witness",
        "field_witnessed",
        "retired"
      ]
    },
    "role": {
      "type": "string",
      "enum": ["MAKE", "TRANSLATE", "USE"]
    },
    "documentStatus": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "design_stage",
        "field_evidence_status",
        "field_operation_occurred",
        "approval_status"
      ],
      "properties": {
        "design_stage": {
          "type": "string",
          "const": "concept_only"
        },
        "field_evidence_status": {
          "type": "string",
          "const": "pending_field_witness"
        },
        "field_operation_occurred": {
          "type": "boolean",
          "const": false
        },
        "approval_status": {
          "type": "string",
          "const": "not_approved_for_deployment"
        },
        "status_note": {
          "type": "string",
          "minLength": 20
        }
      }
    },
    "spatialRoleRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "role",
        "site_ref",
        "node_id",
        "zone_id",
        "assignment_status",
        "role_action",
        "official_geometry_used"
      ],
      "properties": {
        "role": {
          "$ref": "#/$defs/role"
        },
        "site_ref": {
          "type": "string",
          "pattern": "^PROV-KEY-[0-9]{3}$"
        },
        "node_id": {
          "type": ["string", "null"],
          "pattern": "^NODE-[0-9]{3}$"
        },
        "zone_id": {
          "type": ["string", "null"],
          "pattern": "^ZONE-[0-9]{3}$"
        },
        "assignment_status": {
          "type": "string",
          "enum": [
            "concept_host",
            "candidate_destination_not_assigned",
            "not_authorized"
          ]
        },
        "role_action": {
          "type": "string",
          "minLength": 20
        },
        "official_geometry_used": {
          "type": "boolean",
          "const": false
        },
        "geometry_note": {
          "type": "string",
          "minLength": 20
        }
      }
    },
    "spatialChain": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "current_node_id",
        "current_zone_id",
        "current_role",
        "current_site_ref",
        "geometry_status",
        "role_route"
      ],
      "properties": {
        "current_node_id": {
          "type": "string",
          "pattern": "^NODE-[0-9]{3}$"
        },
        "current_zone_id": {
          "type": "string",
          "pattern": "^ZONE-[0-9]{3}$"
        },
        "current_role": {
          "$ref": "#/$defs/role"
        },
        "current_site_ref": {
          "type": "string",
          "pattern": "^PROV-KEY-[0-9]{3}$"
        },
        "geometry_status": {
          "type": "string",
          "const": "provisional_constraint_not_official"
        },
        "role_route": {
          "type": "array",
          "prefixItems": [
            {
              "allOf": [
                {
                  "$ref": "#/$defs/spatialRoleRecord"
                },
                {
                  "properties": {
                    "role": {
                      "const": "MAKE"
                    }
                  }
                }
              ]
            },
            {
              "allOf": [
                {
                  "$ref": "#/$defs/spatialRoleRecord"
                },
                {
                  "properties": {
                    "role": {
                      "const": "TRANSLATE"
                    }
                  }
                }
              ]
            },
            {
              "allOf": [
                {
                  "$ref": "#/$defs/spatialRoleRecord"
                },
                {
                  "properties": {
                    "role": {
                      "const": "USE"
                    }
                  }
                }
              ]
            }
          ],
          "items": false,
          "minItems": 3,
          "maxItems": 3
        }
      }
    },
    "changeRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "previous_condition",
        "proposed_condition",
        "reason_for_change",
        "evidence_status"
      ],
      "properties": {
        "previous_condition": {
          "type": "string",
          "minLength": 10
        },
        "proposed_condition": {
          "type": "string",
          "minLength": 10
        },
        "reason_for_change": {
          "type": "string",
          "minLength": 20
        },
        "evidence_status": {
          "type": "string",
          "const": "design_intent_pending_field_witness"
        }
      }
    },
    "lineageVersion": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version_id",
        "version_status",
        "urban_role",
        "spatial_change",
        "material_change",
        "human_service_change",
        "field_witness_receipt_id"
      ],
      "properties": {
        "version_id": {
          "type": "string",
          "enum": ["V0", "V1", "V2", "V3", "V4", "V5"]
        },
        "version_status": {
          "type": "string",
          "const": "design_intent_only"
        },
        "urban_role": {
          "$ref": "#/$defs/role"
        },
        "spatial_change": {
          "$ref": "#/$defs/changeRecord"
        },
        "material_change": {
          "$ref": "#/$defs/changeRecord"
        },
        "human_service_change": {
          "$ref": "#/$defs/changeRecord"
        },
        "field_witness_receipt_id": {
          "type": "null"
        }
      }
    },
    "componentLineage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "lineage_id",
        "lineage_subject",
        "same_physical_lineage",
        "version_order",
        "versions"
      ],
      "properties": {
        "lineage_id": {
          "type": "string",
          "pattern": "^LINEAGE-JZ-[0-9]{3}-[A-Z0-9-]+$"
        },
        "lineage_subject": {
          "type": "string",
          "const": "accessible_multilingual_wayfinding_component"
        },
        "same_physical_lineage": {
          "type": "boolean",
          "const": true
        },
        "version_order": {
          "type": "array",
          "prefixItems": [
            { "const": "V0" },
            { "const": "V1" },
            { "const": "V2" },
            { "const": "V3" },
            { "const": "V4" },
            { "const": "V5" }
          ],
          "items": false,
          "minItems": 6,
          "maxItems": 6
        },
        "versions": {
          "type": "array",
          "prefixItems": [
            {
              "allOf": [
                { "$ref": "#/$defs/lineageVersion" },
                { "properties": { "version_id": { "const": "V0" } } }
              ]
            },
            {
              "allOf": [
                { "$ref": "#/$defs/lineageVersion" },
                { "properties": { "version_id": { "const": "V1" } } }
              ]
            },
            {
              "allOf": [
                { "$ref": "#/$defs/lineageVersion" },
                { "properties": { "version_id": { "const": "V2" } } }
              ]
            },
            {
              "allOf": [
                { "$ref": "#/$defs/lineageVersion" },
                { "properties": { "version_id": { "const": "V3" } } }
              ]
            },
            {
              "allOf": [
                { "$ref": "#/$defs/lineageVersion" },
                { "properties": { "version_id": { "const": "V4" } } }
              ]
            },
            {
              "allOf": [
                { "$ref": "#/$defs/lineageVersion" },
                { "properties": { "version_id": { "const": "V5" } } }
              ]
            }
          ],
          "items": false,
          "minItems": 6,
          "maxItems": 6
        }
      }
    },
    "aiInput": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "input_id",
        "description",
        "provenance",
        "personal_data_allowed",
        "rights_clearance",
        "field_status"
      ],
      "properties": {
        "input_id": {
          "type": "string",
          "pattern": "^AI-IN-[0-9]{3}$"
        },
        "description": {
          "type": "string",
          "minLength": 15
        },
        "provenance": {
          "type": "string",
          "enum": ["public_rights_cleared", "synthetic_test_only", "model_card_only"]
        },
        "personal_data_allowed": {
          "type": "boolean",
          "const": false
        },
        "rights_clearance": {
          "type": "string",
          "enum": ["cleared_or_synthetic", "pending_clearance_not_allowed"]
        },
        "field_status": {
          "type": "string",
          "const": "concept_input_specification"
        }
      }
    },
    "aiOutput": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "output_id",
        "description",
        "allowed_use",
        "human_release_required",
        "field_status"
      ],
      "properties": {
        "output_id": {
          "type": "string",
          "pattern": "^AI-OUT-[0-9]{3}$"
        },
        "description": {
          "type": "string",
          "minLength": 15
        },
        "allowed_use": {
          "type": "string",
          "minLength": 20
        },
        "human_release_required": {
          "type": "boolean",
          "const": true
        },
        "field_status": {
          "type": "string",
          "const": "concept_output_specification"
        }
      }
    },
    "humanDecision": {
      "type": "object",
      "additionalProperties": false,
      "required": ["decision_id", "decision", "decision_role", "required_before"],
      "properties": {
        "decision_id": {
          "type": "string",
          "pattern": "^HUMAN-DEC-[0-9]{3}$"
        },
        "decision": {
          "type": "string",
          "minLength": 20
        },
        "decision_role": {
          "type": "string",
          "minLength": 8
        },
        "required_before": {
          "type": "string",
          "minLength": 15
        }
      }
    },
    "aiContract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "allowed_inputs",
        "allowed_outputs",
        "human_decisions",
        "prohibited_actions",
        "automated_deployment_allowed",
        "automated_restart_allowed"
      ],
      "properties": {
        "allowed_inputs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/aiInput"
          },
          "minItems": 3,
          "uniqueItems": true
        },
        "allowed_outputs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/aiOutput"
          },
          "minItems": 2,
          "uniqueItems": true
        },
        "human_decisions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/humanDecision"
          },
          "minItems": 4,
          "uniqueItems": true
        },
        "prohibited_actions": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 15
          },
          "minItems": 6,
          "uniqueItems": true
        },
        "automated_deployment_allowed": {
          "type": "boolean",
          "const": false
        },
        "automated_restart_allowed": {
          "type": "boolean",
          "const": false
        }
      }
    },
    "materialRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "material_id",
        "material_role",
        "candidate_material_family",
        "specification_status",
        "origin_status",
        "reuse_instruction"
      ],
      "properties": {
        "material_id": {
          "type": "string",
          "pattern": "^MAT-[0-9]{3}$"
        },
        "material_role": {
          "type": "string",
          "minLength": 8
        },
        "candidate_material_family": {
          "type": "string",
          "minLength": 10
        },
        "specification_status": {
          "type": "string",
          "const": "not_selected_not_procured"
        },
        "origin_status": {
          "type": "string",
          "const": "not_verified"
        },
        "reuse_instruction": {
          "type": "string",
          "minLength": 15
        }
      }
    },
    "connectionRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "connection_id",
        "connects",
        "connection_principle",
        "permanent_attachment_allowed",
        "detail_status"
      ],
      "properties": {
        "connection_id": {
          "type": "string",
          "pattern": "^CONN-[0-9]{3}$"
        },
        "connects": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^COMP-[0-9]{3}$"
          },
          "minItems": 2,
          "uniqueItems": true
        },
        "connection_principle": {
          "type": "string",
          "minLength": 20
        },
        "permanent_attachment_allowed": {
          "type": "boolean",
          "const": false
        },
        "detail_status": {
          "type": "string",
          "const": "reversible_detail_pending_field_design"
        }
      }
    },
    "toolRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tool_requirement_id",
        "tool_description",
        "selection_status",
        "worker_access_required",
        "availability_verified"
      ],
      "properties": {
        "tool_requirement_id": {
          "type": "string",
          "pattern": "^TOOL-[0-9]{3}$"
        },
        "tool_description": {
          "type": "string",
          "minLength": 15
        },
        "selection_status": {
          "type": "string",
          "const": "exact_tool_pending_fastener_selection"
        },
        "worker_access_required": {
          "type": "boolean",
          "const": true
        },
        "availability_verified": {
          "type": "boolean",
          "const": false
        }
      }
    },
    "componentRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "component_id",
        "component_role",
        "material_refs",
        "connection_refs",
        "disassembly_tool_refs",
        "component_status"
      ],
      "properties": {
        "component_id": {
          "type": "string",
          "pattern": "^COMP-[0-9]{3}$"
        },
        "component_role": {
          "type": "string",
          "minLength": 10
        },
        "material_refs": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^MAT-[0-9]{3}$"
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "connection_refs": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^CONN-[0-9]{3}$"
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "disassembly_tool_refs": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^TOOL-[0-9]{3}$"
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "component_status": {
          "type": "string",
          "const": "concept_component_not_procured"
        }
      }
    },
    "expectedLife": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "lifecycle_layer",
        "review_window_days",
        "expected_service_life_value",
        "expected_service_life_unit",
        "basis_status",
        "expiry_action"
      ],
      "properties": {
        "lifecycle_layer": {
          "type": "string",
          "const": "90_day_removable_kit"
        },
        "review_window_days": {
          "type": "integer",
          "const": 90
        },
        "expected_service_life_value": {
          "type": "null"
        },
        "expected_service_life_unit": {
          "type": "null"
        },
        "basis_status": {
          "type": "string",
          "const": "not_established_by_procurement_or_field_test"
        },
        "expiry_action": {
          "type": "string",
          "minLength": 25
        }
      }
    },
    "nextDestination": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "decision_status",
        "preferred_routes",
        "specific_destination_ref",
        "custodian_role",
        "receipt_required"
      ],
      "properties": {
        "decision_status": {
          "type": "string",
          "const": "unconfirmed_concept_route"
        },
        "preferred_routes": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "repair_at_MAKE",
              "reuse_at_TRANSLATE",
              "reuse_at_USE",
              "material_recovery",
              "quarantine_pending_safety_review"
            ]
          },
          "minItems": 3,
          "uniqueItems": true
        },
        "specific_destination_ref": {
          "type": "null"
        },
        "custodian_role": {
          "type": "null"
        },
        "receipt_required": {
          "type": "boolean",
          "const": true
        }
      }
    },
    "physicalKit": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "procurement_status",
        "components",
        "materials",
        "connections",
        "disassembly_tools",
        "expected_life",
        "next_destination"
      ],
      "properties": {
        "procurement_status": {
          "type": "string",
          "const": "not_procured_concept_only"
        },
        "components": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/componentRecord"
          },
          "minItems": 3,
          "uniqueItems": true
        },
        "materials": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/materialRecord"
          },
          "minItems": 3,
          "uniqueItems": true
        },
        "connections": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/connectionRecord"
          },
          "minItems": 2,
          "uniqueItems": true
        },
        "disassembly_tools": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/toolRecord"
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "expected_life": {
          "$ref": "#/$defs/expectedLife"
        },
        "next_destination": {
          "$ref": "#/$defs/nextDestination"
        }
      }
    },
    "operatingWindow": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "start_local", "end_local", "timezone"],
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "ordinary_service_only",
            "not_authorized_for_this_passport",
            "concept_schedule_only"
          ]
        },
        "start_local": {
          "type": ["string", "null"],
          "pattern": "^[0-9]{2}:[0-9]{2}$"
        },
        "end_local": {
          "type": ["string", "null"],
          "pattern": "^[0-9]{2}:[0-9]{2}$"
        },
        "timezone": {
          "type": "string",
          "const": "Asia/Shanghai"
        }
      }
    },
    "retentionRule": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "record_type",
        "maximum_days",
        "personal_data_allowed",
        "status",
        "deletion_or_end_action"
      ],
      "properties": {
        "record_type": {
          "type": "string",
          "minLength": 5
        },
        "maximum_days": {
          "type": ["integer", "null"],
          "minimum": 0
        },
        "personal_data_allowed": {
          "type": "boolean",
          "const": false
        },
        "status": {
          "type": "string",
          "enum": ["none", "concept_limit_not_operated", "not_authorized"]
        },
        "deletion_or_end_action": {
          "type": "string",
          "minLength": 15
        }
      }
    },
    "noSensingMask": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mask_id",
        "mask_rule",
        "scope_status",
        "outward_sensing_forbidden",
        "geometry_verification_status"
      ],
      "properties": {
        "mask_id": {
          "type": "string",
          "pattern": "^MASK-[A-Z0-9-]+$"
        },
        "mask_rule": {
          "type": "string",
          "minLength": 15
        },
        "scope_status": {
          "type": "string",
          "enum": [
            "entire_zone",
            "entire_zone_until_separate_review",
            "public_boundary_mask"
          ]
        },
        "outward_sensing_forbidden": {
          "type": "boolean",
          "const": true
        },
        "geometry_verification_status": {
          "type": "string",
          "const": "not_field_measured_provisional_geometry_only"
        }
      }
    },
    "exposureLevel": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "level",
        "definition",
        "activation_status",
        "sensing_modes",
        "operating_window",
        "retention",
        "no_sensing_mask"
      ],
      "properties": {
        "level": {
          "type": "string",
          "enum": ["N0", "N1", "N2", "N3"]
        },
        "definition": {
          "type": "string",
          "minLength": 20
        },
        "activation_status": {
          "type": "string",
          "enum": [
            "fallback_required",
            "not_authorized_for_this_passport",
            "concept_only_not_authorized_for_field_use"
          ]
        },
        "sensing_modes": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 3
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "operating_window": {
          "$ref": "#/$defs/operatingWindow"
        },
        "retention": {
          "$ref": "#/$defs/retentionRule"
        },
        "no_sensing_mask": {
          "$ref": "#/$defs/noSensingMask"
        }
      }
    },
    "exposureRegister": {
      "type": "object",
      "additionalProperties": false,
      "required": ["active_concept_level", "active_zone_id", "levels"],
      "properties": {
        "active_concept_level": {
          "type": "string",
          "const": "N3"
        },
        "active_zone_id": {
          "type": "string",
          "pattern": "^ZONE-[0-9]{3}$"
        },
        "levels": {
          "type": "array",
          "prefixItems": [
            {
              "allOf": [
                { "$ref": "#/$defs/exposureLevel" },
                { "properties": { "level": { "const": "N0" } } }
              ]
            },
            {
              "allOf": [
                { "$ref": "#/$defs/exposureLevel" },
                { "properties": { "level": { "const": "N1" } } }
              ]
            },
            {
              "allOf": [
                { "$ref": "#/$defs/exposureLevel" },
                { "properties": { "level": { "const": "N2" } } }
              ]
            },
            {
              "allOf": [
                { "$ref": "#/$defs/exposureLevel" },
                { "properties": { "level": { "const": "N3" } } }
              ]
            }
          ],
          "items": false,
          "minItems": 4,
          "maxItems": 4
        }
      }
    },
    "serviceEquivalent": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "equivalent_id",
        "service_mode",
        "ordinary_service_function",
        "availability_condition",
        "field_status"
      ],
      "properties": {
        "equivalent_id": {
          "type": "string",
          "pattern": "^EQUIV-[0-9]{3}$"
        },
        "service_mode": {
          "type": "string",
          "enum": ["static_signage", "tactile_map", "paper_map", "human_steward"]
        },
        "ordinary_service_function": {
          "type": "string",
          "minLength": 20
        },
        "availability_condition": {
          "type": "string",
          "minLength": 15
        },
        "field_status": {
          "type": "string",
          "const": "required_but_not_field_verified"
        }
      }
    },
    "serviceContinuity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ordinary_service_must_continue",
        "ai_participation_optional",
        "service_baseline_verified",
        "equivalents",
        "failure_rule"
      ],
      "properties": {
        "ordinary_service_must_continue": {
          "type": "boolean",
          "const": true
        },
        "ai_participation_optional": {
          "type": "boolean",
          "const": true
        },
        "service_baseline_verified": {
          "type": "boolean",
          "const": false
        },
        "equivalents": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/serviceEquivalent"
          },
          "minItems": 4,
          "uniqueItems": true
        },
        "failure_rule": {
          "type": "string",
          "const": "if_ai_fails_or_is_refused_keep_human_and_offline_wayfinding_running"
        }
      }
    },
    "receiptTemplate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "receipt_id_template",
        "record_status",
        "required_fields",
        "expected_signatories",
        "occurred_at",
        "witnesses",
        "evidence_refs"
      ],
      "properties": {
        "receipt_id_template": {
          "type": "string",
          "pattern": "^RECEIPT-JZ-[0-9]{3}-S[0-3]-TEMPLATE$"
        },
        "record_status": {
          "type": "string",
          "const": "template_only_pending_field_witness"
        },
        "required_fields": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 5
          },
          "minItems": 5,
          "uniqueItems": true
        },
        "expected_signatories": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 5
          },
          "minItems": 2,
          "uniqueItems": true
        },
        "occurred_at": {
          "type": "null"
        },
        "witnesses": {
          "type": "array",
          "maxItems": 0
        },
        "evidence_refs": {
          "type": "array",
          "maxItems": 0
        }
      }
    },
    "stateBase": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "state_id",
        "state_order",
        "state_name",
        "zone_exposure_level",
        "public_condition",
        "entry_conditions",
        "required_actions",
        "receipt"
      ],
      "properties": {
        "state_id": {
          "type": "string",
          "enum": ["S0", "S1", "S2", "S3"]
        },
        "state_order": {
          "type": "integer",
          "minimum": 0,
          "maximum": 3
        },
        "state_name": {
          "type": "string",
          "minLength": 12
        },
        "zone_exposure_level": {
          "type": "string",
          "enum": ["N0", "N3"]
        },
        "public_condition": {
          "type": "string",
          "minLength": 25
        },
        "entry_conditions": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 12
          },
          "minItems": 2,
          "uniqueItems": true
        },
        "required_actions": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 12
          },
          "minItems": 2,
          "uniqueItems": true
        },
        "receipt": {
          "$ref": "#/$defs/receiptTemplate"
        }
      }
    },
    "notDeployedState": {
      "allOf": [
        { "$ref": "#/$defs/stateBase" },
        {
          "properties": {
            "state_id": { "const": "S0" },
            "state_order": { "const": 0 },
            "state_name": { "const": "not_deployed" },
            "zone_exposure_level": { "const": "N0" }
          }
        }
      ]
    },
    "inUseState": {
      "allOf": [
        { "$ref": "#/$defs/stateBase" },
        {
          "properties": {
            "state_id": { "const": "S1" },
            "state_order": { "const": 1 },
            "state_name": { "const": "one_to_one_in_use" },
            "zone_exposure_level": { "const": "N3" }
          }
        }
      ]
    },
    "safelyStoppedState": {
      "allOf": [
        { "$ref": "#/$defs/stateBase" },
        {
          "properties": {
            "state_id": { "const": "S2" },
            "state_order": { "const": 2 },
            "state_name": { "const": "safely_stopped" },
            "zone_exposure_level": { "const": "N0" }
          }
        }
      ]
    },
    "restoredOrRelocatedState": {
      "allOf": [
        { "$ref": "#/$defs/stateBase" },
        {
          "properties": {
            "state_id": { "const": "S3" },
            "state_order": { "const": 3 },
            "state_name": { "const": "ground_restored_or_component_relocated" },
            "zone_exposure_level": { "const": "N0" }
          }
        }
      ]
    },
    "stopReviewAndRights": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "stop_triggers",
        "immediate_stop_sequence",
        "independent_review",
        "pause_request",
        "appeal_and_complaint",
        "frontline_worker_stop_work",
        "restart_gate",
        "automated_restart_forbidden"
      ],
      "properties": {
        "stop_triggers": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "misdirection",
              "obstruction",
              "audio_conflict",
              "accessible_bypass_missing",
              "red_team_failure",
              "privacy_or_consent_breach",
              "unsafe_component_condition"
            ]
          },
          "minItems": 5,
          "uniqueItems": true
        },
        "immediate_stop_sequence": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 20
          },
          "minItems": 5,
          "uniqueItems": true
        },
        "independent_review": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "reviewer_role",
            "supplier_conflict_allowed",
            "review_status",
            "review_inputs",
            "review_decision_required_before_restart"
          ],
          "properties": {
            "reviewer_role": {
              "type": "string",
              "const": "independent_safety_and_accessibility_reviewer"
            },
            "supplier_conflict_allowed": {
              "type": "boolean",
              "const": false
            },
            "review_status": {
              "type": "string",
              "const": "role_to_be_named_pending_field_witness"
            },
            "review_inputs": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 12
              },
              "minItems": 4,
              "uniqueItems": true
            },
            "review_decision_required_before_restart": {
              "type": "boolean",
              "const": true
            }
          }
        },
        "pause_request": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "eligible_initiators",
            "channels",
            "no_retaliation",
            "immediate_effect"
          ],
          "properties": {
            "eligible_initiators": {
              "type": "array",
              "items": {
                "type": "string",
                "enum": ["any_user", "neighbour", "operator", "maintenance_worker"]
              },
              "minItems": 4,
              "uniqueItems": true
            },
            "channels": {
              "type": "array",
              "items": {
                "type": "string",
                "enum": ["human_counter", "paper_log", "phone", "optional_digital_form"]
              },
              "minItems": 3,
              "uniqueItems": true
            },
            "no_retaliation": {
              "type": "boolean",
              "const": true
            },
            "immediate_effect": {
              "type": "string",
              "const": "set_zone_to_N0_and_keep_ordinary_service_running"
            }
          }
        },
        "appeal_and_complaint": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "receiving_role",
            "non_digital_route",
            "appeal_available",
            "ordinary_service_during_dispute",
            "record_status"
          ],
          "properties": {
            "receiving_role": {
              "type": "string",
              "minLength": 12
            },
            "non_digital_route": {
              "type": "string",
              "minLength": 20
            },
            "appeal_available": {
              "type": "boolean",
              "const": true
            },
            "ordinary_service_during_dispute": {
              "type": "boolean",
              "const": true
            },
            "record_status": {
              "type": "string",
              "const": "protocol_template_pending_field_witness"
            }
          }
        },
        "frontline_worker_stop_work": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "worker_may_stop_immediately",
            "protected_report",
            "no_personal_blame",
            "receiving_role",
            "safe_alternative_work"
          ],
          "properties": {
            "worker_may_stop_immediately": {
              "type": "boolean",
              "const": true
            },
            "protected_report": {
              "type": "boolean",
              "const": true
            },
            "no_personal_blame": {
              "type": "boolean",
              "const": true
            },
            "receiving_role": {
              "type": "string",
              "const": "repair_lead_and_asset_holder_to_be_named"
            },
            "safe_alternative_work": {
              "type": "string",
              "minLength": 20
            }
          }
        },
        "restart_gate": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 20
          },
          "minItems": 5,
          "uniqueItems": true
        },
        "automated_restart_forbidden": {
          "type": "boolean",
          "const": true
        }
      }
    },
    "restorationAndTransfer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ground_restoration",
        "component_transfer",
        "material_transfer",
        "ordinary_service_after_exit"
      ],
      "properties": {
        "ground_restoration": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "baseline_condition_status",
            "restoration_rule",
            "accessible_route_protection",
            "damage_assessment_required",
            "restoration_status",
            "receipt_template_ref"
          ],
          "properties": {
            "baseline_condition_status": {
              "type": "string",
              "const": "not_surveyed_pending_field_witness"
            },
            "restoration_rule": {
              "type": "string",
              "minLength": 30
            },
            "accessible_route_protection": {
              "type": "string",
              "minLength": 25
            },
            "damage_assessment_required": {
              "type": "boolean",
              "const": true
            },
            "restoration_status": {
              "type": "string",
              "const": "concept_method_not_witnessed"
            },
            "receipt_template_ref": {
              "type": "string",
              "const": "RECEIPT-JZ-001-S3-TEMPLATE"
            }
          }
        },
        "component_transfer": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "transfer_rule",
            "next_role_candidates",
            "custody_receipt_required",
            "destination_status"
          ],
          "properties": {
            "transfer_rule": {
              "type": "string",
              "minLength": 30
            },
            "next_role_candidates": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/role"
              },
              "minItems": 2,
              "uniqueItems": true
            },
            "custody_receipt_required": {
              "type": "boolean",
              "const": true
            },
            "destination_status": {
              "type": "string",
              "const": "not_assigned_pending_field_witness"
            }
          }
        },
        "material_transfer": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "allowed_destinations",
            "origin_trace_required",
            "unsafe_material_rule",
            "transfer_status"
          ],
          "properties": {
            "allowed_destinations": {
              "type": "array",
              "items": {
                "type": "string",
                "enum": ["repair", "reuse", "material_recovery", "quarantine"]
              },
              "minItems": 3,
              "uniqueItems": true
            },
            "origin_trace_required": {
              "type": "boolean",
              "const": true
            },
            "unsafe_material_rule": {
              "type": "string",
              "minLength": 25
            },
            "transfer_status": {
              "type": "string",
              "const": "not_operated_pending_field_witness"
            }
          }
        },
        "ordinary_service_after_exit": {
          "type": "boolean",
          "const": true
        }
      }
    },
    "dependencyGap": {
      "type": "object",
      "additionalProperties": false,
      "required": ["obtained", "status", "effect", "required_before"],
      "properties": {
        "obtained": {
          "type": "boolean",
          "const": false
        },
        "status": {
          "type": "string",
          "const": "not_obtained"
        },
        "effect": {
          "type": "string",
          "minLength": 25
        },
        "required_before": {
          "type": "string",
          "minLength": 15
        }
      }
    },
    "unsecuredDependencies": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "official_geometry",
        "title_or_ownership",
        "operating_capacity",
        "funding",
        "permits",
        "field_witness"
      ],
      "properties": {
        "official_geometry": {
          "$ref": "#/$defs/dependencyGap"
        },
        "title_or_ownership": {
          "$ref": "#/$defs/dependencyGap"
        },
        "operating_capacity": {
          "$ref": "#/$defs/dependencyGap"
        },
        "funding": {
          "$ref": "#/$defs/dependencyGap"
        },
        "permits": {
          "$ref": "#/$defs/dependencyGap"
        },
        "field_witness": {
          "$ref": "#/$defs/dependencyGap"
        }
      }
    },
    "claimBoundary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "concept_only",
        "provisional_geometry_only",
        "completed_pilot",
        "field_performance_reported",
        "dimensions_reported",
        "approved_plan_reported",
        "not_claimed",
        "interpretation_note"
      ],
      "properties": {
        "concept_only": {
          "type": "boolean",
          "const": true
        },
        "provisional_geometry_only": {
          "type": "boolean",
          "const": true
        },
        "completed_pilot": {
          "type": "boolean",
          "const": false
        },
        "field_performance_reported": {
          "type": "boolean",
          "const": false
        },
        "dimensions_reported": {
          "type": "boolean",
          "const": false
        },
        "approved_plan_reported": {
          "type": "boolean",
          "const": false
        },
        "not_claimed": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 12
          },
          "minItems": 6,
          "uniqueItems": true
        },
        "interpretation_note": {
          "type": "string",
          "minLength": 50
        }
      }
    }
  }
}
