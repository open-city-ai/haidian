{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "inclusion-ledger.schema.json",
  "title": "8-80 Inclusion Ledger",
  "type": "object",
  "required": ["schema_version", "status", "group_count", "groups", "aggregation_rule", "known_limitations"],
  "additionalProperties": false,
  "properties": {
    "$schema": {"type": "string"},
    "schema_version": {"const": "1.0.0"},
    "status": {"const": "proposal_ledger_no_population_claim"},
    "group_count": {"const": 9},
    "groups": {
      "type": "array",
      "minItems": 9,
      "maxItems": 9,
      "items": {
        "type": "object",
        "required": ["group_id", "label_zh", "label_en", "definition", "benefits", "burdens", "blind_spots", "required_inputs", "procedural_standing"],
        "additionalProperties": false,
        "properties": {
          "group_id": {"type": "string"},
          "label_zh": {"type": "string"},
          "label_en": {"type": "string"},
          "definition": {"type": "string"},
          "benefits": {"type": "array", "minItems": 1, "items": {"type": "string"}},
          "burdens": {"type": "array", "minItems": 1, "items": {"type": "string"}},
          "blind_spots": {"type": "array", "minItems": 1, "items": {"type": "string"}},
          "required_inputs": {"type": "array", "minItems": 1, "items": {"type": "string"}},
          "procedural_standing": {
            "type": "object",
            "required": ["status", "rights"],
            "properties": {
          "status": {"const": "proposed_procedural_rights"},
              "rights": {"type": "array", "minItems": 1, "items": {"type": "string"}}
            }
          }
        }
      }
    },
    "aggregation_rule": {"type": "string"},
    "known_limitations": {"type": "array", "minItems": 1, "items": {"type": "string"}}
  }
}
