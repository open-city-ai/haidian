    "source": "proposal.md",
    "review_owner": "participant; final gate requires business, privacy/compliance and operator review",
    "protocols": [
      {
        "id": "T1",
        "name": "IP valuation assistant",
        "baseline_window": "8 weeks pre-pilot; >=30 de-identified reviewable intervals",
        "pilot_window": "4 weeks; >=10 cases/week",
        "formula": "MAPE=mean(abs(predicted_midpoint-observed_midpoint)/max(abs(observed_midpoint),epsilon))",
        "thresholds": {
          "mape_max": 0.2,
          "false_positive_rate_max": 0.1,
          "min_cases_per_error_stratum": 10
        },
        "owner": "valuation specialist + privacy lead",
        "status": "participant-proposed/to_verify",
        "failure": "two consecutive breaches -> disable and manual valuation"
      },
      {
        "id": "T2",
        "name": "ZC screen / data ledger",
        "baseline_window": "2 weeks manual double-entry; >=100 reconciliation records",
        "pilot_window": "4 weeks; weekly checks with 20 records sampled",
        "formula": "reconciliation_rate=matched_records/checked_records",
        "thresholds": {
          "reconciliation_rate_min": 0.98,
          "alert_closure_rate_min": 0.95
        },
        "owner": "ledger administrator + compliance reviewer",
        "status": "participant-proposed/to_verify",
        "failure": "any weekly breach -> revert to manual registration"
      },
      {
        "id": "T3",
        "name": "Zero-Number validation",
        "baseline_window": "one comparable quarterly baseline; >=20 de-identified projects",
        "pilot_window": "8 weeks",
        "formula": "graduation_rate=graduated/admitted; PSI drift computed against locked baseline",
        "thresholds": {
          "evaluation_sample_min": 20,
          "psi_max": 0.2,
          "graduation_rate_floor": "20% below locked baseline triggers review"
        },
        "owner": "university/station review pair",
        "status": "participant-proposed/to_verify",
        "failure": "two PSI breaches or graduation floor breach -> manual review"
      }
    ]
