{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "source-rights-evidence.schema.json",
  "title": "Jing-Zhang source, asset, and rights evidence contract",
  "description": "Audit schema for evidence lineage. Conformance proves structural disclosure only and never proves legal clearance.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "evidence_id",
    "as_of",
    "clearance_claim",
    "coverage",
    "source_records",
    "osm_element_lineage",
    "font_inventory",
    "external_dependency_requests",
    "release_gates",
    "audit_records"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "evidence_id": {
      "const": "SOURCE-RIGHTS-EVIDENCE-01"
    },
    "as_of": {
      "type": "string",
      "format": "date"
    },
    "clearance_claim": {
      "$ref": "#/$defs/clearanceClaim"
    },
    "coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_record_count",
        "osm_element_count",
        "completed_independent_file_level_clearance_audits",
        "asset_ledger_ref"
      ],
      "properties": {
        "source_record_count": {
          "type": "integer",
          "minimum": 0
        },
        "osm_element_count": {
          "type": "integer",
          "minimum": 0
        },
        "completed_independent_file_level_clearance_audits": {
          "const": 0
        },
        "asset_ledger_ref": {
          "const": "rights-clearance-ledger.json#asset_records"
        }
      }
    },
    "source_records": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/sourceEvidence"
      },
      "minItems": 1
    },
    "osm_element_lineage": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/osmLineage"
      }
    },
    "font_inventory": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/fontRecord"
      }
    },
    "external_dependency_requests": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/dependencyRequest"
      },
      "minItems": 1
    },
    "release_gates": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/releaseGate"
      },
      "minItems": 2
    },
    "audit_records": {
      "type": "array",
      "items": {
        "type": "object"
      },
      "maxItems": 0
    }
  },
  "$defs": {
    "clearanceClaim": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "completed_independent_file_level_clearance_audits",
        "disclosure_effect"
      ],
      "properties": {
        "status": {
          "const": "not_fully_cleared"
        },
        "completed_independent_file_level_clearance_audits": {
          "const": 0
        },
        "disclosure_effect": {
          "const": "audit_ready_not_cleared"
        }
      }
    },
    "locator": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "value"
      ],
      "properties": {
        "kind": {
          "enum": [
            "repository_path",
            "public_url"
          ]
        },
        "value": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "dateEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "value",
        "basis"
      ],
      "properties": {
        "status": {
          "enum": [
            "recorded",
            "unknown"
          ]
        },
        "value": {
          "type": [
            "string",
            "null"
          ],
          "format": "date"
        },
        "basis": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "formatEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "label",
        "media_type",
        "basis"
      ],
      "properties": {
        "status": {
          "enum": [
            "observed_from_repository_object",
            "inferred_from_locator_not_verified",
            "unknown"
          ]
        },
        "label": {
          "type": [
            "string",
            "null"
          ]
        },
        "media_type": {
          "type": [
            "string",
            "null"
          ]
        },
        "basis": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "integrityEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "method",
        "algorithm",
        "digest",
        "digest_scope",
        "artifact_in_submission",
        "limitation"
      ],
      "properties": {
        "method": {
          "enum": [
            "git_object",
            "retrieval_capture_digest",
            "unavailable"
          ]
        },
        "algorithm": {
          "type": [
            "string",
            "null"
          ]
        },
        "digest": {
          "type": [
            "string",
            "null"
          ]
        },
        "digest_scope": {
          "type": "string",
          "minLength": 1
        },
        "artifact_in_submission": {
          "type": "boolean"
        },
        "limitation": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "rightsBasis": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "declared_basis",
        "terms_locator",
        "evidence_state",
        "independent_review_status",
        "package_use_mode"
      ],
      "properties": {
        "declared_basis": {
          "type": "string",
          "minLength": 1
        },
        "terms_locator": {
          "type": [
            "string",
            "null"
          ]
        },
        "evidence_state": {
          "enum": [
            "declared_terms_pointer_only",
            "source_record_statement_only",
            "terms_unavailable"
          ]
        },
        "independent_review_status": {
          "const": "not_started"
        },
        "package_use_mode": {
          "enum": [
            "repository_input",
            "citation_only",
            "directional_context",
            "gap_record"
          ]
        }
      }
    },
    "sourceEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "evidence_id",
        "source_id",
        "source_record_ref",
        "publisher",
        "locator",
        "published_or_obtained",
        "accessed_date",
        "original_format",
        "integrity",
        "rights_basis",
        "downstream_asset_ref",
        "unresolved_item_ids"
      ],
      "properties": {
        "evidence_id": {
          "type": "string",
          "pattern": "^SRC-RIGHTS-[A-Z0-9-]+$"
        },
        "source_id": {
          "type": "string",
          "minLength": 1
        },
        "source_record_ref": {
          "type": "string",
          "pattern": "^\\.\\./\\.\\./sources\\.json#"
        },
        "publisher": {
          "type": "string",
          "minLength": 1
        },
        "locator": {
          "$ref": "#/$defs/locator"
        },
        "published_or_obtained": {
          "$ref": "#/$defs/dateEvidence"
        },
        "accessed_date": {
          "type": "string",
          "format": "date"
        },
        "original_format": {
          "$ref": "#/$defs/formatEvidence"
        },
        "integrity": {
          "$ref": "#/$defs/integrityEvidence"
        },
        "rights_basis": {
          "$ref": "#/$defs/rightsBasis"
        },
        "downstream_asset_ref": {
          "const": "rights-clearance-ledger.json#asset_records"
        },
        "unresolved_item_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^RIGHTS-OPEN-[0-9]{2}$"
          },
          "uniqueItems": true
        }
      }
    },
    "unknownEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "value",
        "reason"
      ],
      "properties": {
        "status": {
          "const": "unknown"
        },
        "value": {
          "type": "null"
        },
        "reason": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "osmLineage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "feature_ref",
        "element_type",
        "element_id",
        "source_id",
        "source_record_ref",
        "attribution",
        "extraction_query",
        "snapshot_digest",
        "lineage_state",
        "unresolved_item_ids"
      ],
      "properties": {
        "feature_ref": {
          "type": "string",
          "pattern": "^\\.\\./\\.\\./geometry/constraints\\.geojson#CTX-[0-9]{3}$"
        },
        "element_type": {
          "const": "way"
        },
        "element_id": {
          "type": "integer",
          "minimum": 1
        },
        "source_id": {
          "const": "OSM-CONTEXT"
        },
        "source_record_ref": {
          "const": "../../sources.json#OSM-CONTEXT"
        },
        "attribution": {
          "type": "string",
          "minLength": 1
        },
        "extraction_query": {
          "$ref": "#/$defs/unknownEvidence"
        },
        "snapshot_digest": {
          "$ref": "#/$defs/unknownEvidence"
        },
        "lineage_state": {
          "const": "element_id_recorded_snapshot_missing"
        },
        "unresolved_item_ids": {
          "type": "array",
          "contains": {
            "const": "RIGHTS-OPEN-03"
          }
        }
      }
    },
    "fontRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "font_id",
        "scope",
        "embedding_state",
        "source_or_resolution",
        "evidence_state",
        "independent_review_status",
        "unresolved_item_ids"
      ],
      "properties": {
        "font_id": {
          "type": "string",
          "minLength": 1
        },
        "scope": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1
        },
        "embedding_state": {
          "enum": [
            "embedded_subset",
            "referenced_not_embedded",
            "renderer_resolution_unknown"
          ]
        },
        "source_or_resolution": {
          "type": "string",
          "minLength": 1
        },
        "evidence_state": {
          "enum": [
            "facts_recorded_compliance_unreviewed",
            "resolution_unrecorded"
          ]
        },
        "independent_review_status": {
          "const": "not_started"
        },
        "unresolved_item_ids": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1
        }
      }
    },
    "dependencyRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "request_id",
        "owner_needed",
        "evidence_needed",
        "blocks",
        "status",
        "related_open_items"
      ],
      "properties": {
        "request_id": {
          "type": "string",
          "pattern": "^RIGHTS-REQ-[0-9]{2}$"
        },
        "owner_needed": {
          "type": "string",
          "minLength": 1
        },
        "evidence_needed": {
          "type": "string",
          "minLength": 1
        },
        "blocks": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1
        },
        "status": {
          "const": "open"
        },
        "related_open_items": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1
        }
      }
    },
    "releaseGate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "gate",
        "status",
        "condition"
      ],
      "properties": {
        "gate": {
          "enum": [
            "repository_review",
            "public_or_professional_reuse"
          ]
        },
        "status": {
          "enum": [
            "disclosure_ready",
            "blocked_pending_terms_and_audit"
          ]
        },
        "condition": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
