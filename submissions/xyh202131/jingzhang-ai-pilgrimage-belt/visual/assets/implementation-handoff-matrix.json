        "step_id": "R04_HANDOFF",
        "question_zh": "哪些内容冻结，哪些必须由真实资料替换？",
        "question_en": "What is frozen, and what must real evidence replace?",
        "answer_refs": [
          "assets/figures/review-professional-handoff.png",
          "visual/assets/implementation-handoff-matrix.json#official_data_replacement_register"
        ]
      }
    ]
