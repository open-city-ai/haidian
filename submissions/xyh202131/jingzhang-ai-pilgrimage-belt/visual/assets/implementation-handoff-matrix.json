  "review_synthesis": {
    "reading_contract_zh": "评审先读一个空间总纲、三处差异化原型和一个后台治理内核，再按六项任务核对证据，最后只把现实缺口交给专业团队；不按轮次数量评价方案。",
    "reading_contract_en": "Review one spatial master grammar, three differentiated prototypes, and one back-stage governance kernel first; then test the six taskbook duties against evidence and hand only real-world gaps to professionals. Do not score the proposal by round count.",
    "one_concept": {
      "label_zh": "双轨京张",
      "label_en": "Twin-track Jing-Zhang",
      "definition_zh": "连续日常轨 + 间歇验证轨 + 三座换轨场 + 失败侧线 + 公共时刻表。",
      "definition_en": "Continuous civic track + intermittent proof track + three switchyards + failure siding + civic timetable.",
      "primary_refs": [
        "proposal.md#双轨京张前台空间总纲--twin-track-jing-zhang",
        "assets/figures/site-overview.png",
        "visual/assets/key-area-evidence-matrix.json#twin_track_frontend_contract"
      ]
    },
    "three_prototypes": [
      {
        "area_ref": "geometry/key_areas.geojson#PROV-KEY-001",
        "label_zh": "众智园：平行验证庭",
        "label_en": "Zhongzhiyuan: parallel proof court",
        "non_copyable_core": "equipment isolation + physical stop + staffed takeover + restoration acceptance"
      },
      {
        "area_ref": "geometry/key_areas.geojson#PROV-KEY-002",
        "label_zh": "原点社区：一街两院四节点",
        "label_en": "Origin Community: one street, two courts, four nodes",
        "non_copyable_core": "resident daily street + screen-free learning + consent withdrawal + quiet gate"
      },
      {
        "area_ref": "geometry/key_areas.geojson#PROV-KEY-003",
        "label_zh": "大钟寺：四象限步行与一厅一台",
        "label_en": "Dazhongsi: four-quadrant walking plus one hall and one desk",
        "non_copyable_core": "commute continuity + source correction + staffed service + quiet rest"
      }
    ],
    "one_kernel": {
      "label": "JZ-AIOS + G0-G3 + evidence gates + rights boundary",
      "state_axes": [
        "runtime_state",
        "maturity_gate",
        "authorization_state",
        "service_state"
      ],
      "invariant": "A document check, synthetic PASS, evidence-gate result, recovery acceptance, PR approval, or merge does not authorize a field trial, procurement, construction, operation, deployment, or maturity upgrade."
    },
    "review_route": [
      {
        "step_id": "R01_SPACE",
        "question_zh": "普通生活是否先于验证成立？",
        "question_en": "Does ordinary life work before proof activity?",
        "answer_refs": [
          "assets/figures/site-overview.png",
          "assets/figures/non-ai-service-blueprint.png"
        ]
      },
      {
        "step_id": "R02_DIFFERENCE",
        "question_zh": "三处是否真正不可互换？",
        "question_en": "Are the three areas genuinely non-interchangeable?",
        "answer_refs": [
          "assets/figures/key-areas.png",
          "assets/figures/key-area-sections.png"
        ]
      },
      {
        "step_id": "R03_GOVERNANCE",
        "question_zh": "失败、权利、资源和运营能否停止、回写和退场？",
        "question_en": "Can failure, rights, resources, and operations stop, write back, and exit?",
        "answer_refs": [
          "assets/figures/innovation-system.png",
          "assets/figures/failure-governance-writeback.png",
          "assets/figures/year-round-civic-operations.png"
        ]
      },
