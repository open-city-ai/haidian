{
  "schema_version": "0.1.0",
  "assumptions": [
    {
      "assumption_id": "A-BOUNDARY-001",
      "description_zh": "总体设计范围和重点区域边界为基于公告文字四至推断的临时粗略多边形，非官方精确红线。精确面积待官方CAD/GIS文件发布后重算。",
      "impact": "所有面积指标置信度为medium，部分为low",
      "affected_metrics": ["site_area_sqm", "key_area_total_sqm", "green_ratio", "public_space_ratio", "residential_area_sqm", "commercial_area_sqm", "public_facility_area_sqm", "industrial_rd_area_sqm"],
      "affected_layers": ["SITE_BOUNDARY", "KEY_AREA", "LAND_USE", "BUILDING_FOOTPRINT", "GREEN_SPACE", "PUBLIC_SPACE"]
    },
    {
      "assumption_id": "A-LANDUSE-002",
      "description_zh": "用地分类与分配基于AI智能体的空间逻辑推演，非基于现状调研或控规数据。用地比例和功能组合为概念建议。",
      "impact": "land_use.geojson中的用地代码和面积仅反映设计意图，不具法定效力",
      "affected_metrics": ["green_ratio", "residential_area_sqm", "commercial_area_sqm", "public_facility_area_sqm", "industrial_rd_area_sqm"],
      "affected_layers": ["LAND_USE"]
    },
    {
      "assumption_id": "A-BUILDING-003",
      "description_zh": "建筑足迹、层数和体量均为基于用地功能和城市肌理的概念推演，未依据实地建筑普查。",
      "impact": "buildings.geojson为示意性图层",
      "affected_metrics": ["total_buildings", "floor_area_ratio", "building_height_max"],
      "affected_layers": ["BUILDING_FOOTPRINT"]
    },
    {
      "assumption_id": "A-ROAD-004",
      "description_zh": "道路中心线为基于公开地图和城市肌理的概念网络，非实测或工程设计线位。",
      "impact": "roads.geojson不代替工程测量和道路设计",
      "affected_metrics": ["total_roads_km"],
      "affected_layers": ["ROAD_CENTERLINE"]
    },
    {
      "assumption_id": "A-CONTROLS-005",
      "description_zh": "控规条件（容积率、建筑高度、用地兼容性等）尚未公开获取。所有涉及开发强度的建议均为设计概念。",
      "impact": "floor_area_ratio和building_height_max为unknown状态",
      "affected_metrics": ["floor_area_ratio", "building_height_max"],
      "affected_layers": ["LAND_USE"]
    },
    {
      "assumption_id": "A-PHASING-006",
      "description_zh": "分期实施计划为基于空间逻辑的概念建议，未考虑土地权属、市场条件和财政约束。",
      "impact": "phasing.geojson仅为概念示意",
      "affected_metrics": [],
      "affected_layers": ["PHASE"]
    },
    {
      "assumption_id": "A-SCENARIO-007",
      "description_zh": "AI场景卡中的技术方案假设相关技术已成熟到可进行城市级测试验证。实际部署需通过技术评审和隐私影响评估。",
      "impact": "场景描为可能性展示",
      "affected_metrics": [],
      "affected_layers": ["SCENARIO_NODE"]
    },
    {
      "assumption_id": "A-STANDARDS-008",
      "description_zh": "建筑专业深度规定（MOHURD-ARCH-DESIGN-DEPTH-2016）的官方文件尚未获取。引用以仓库登记状态为准。",
      "impact": "standard_matrix中该项标注为data_gap",
      "affected_metrics": [],
      "affected_layers": []
    },
    {
      "assumption_id": "A-DEMOLITION-009",
      "description_zh": "拆改留分类仅基于公开卫星图像和建筑肌理分析，未经过实地建筑质量评估、结构检测和权属调查。",
      "impact": "涉及拆改留的建议须经专业评估确认",
      "affected_metrics": [],
      "affected_layers": []
    },
    {
      "assumption_id": "A-GRID-010",
      "description_zh": "用地网格划分使用了200m规则网格单元，合并阈值约400m。该精度适用于概念方案但不满足详细规划要求。",
      "impact": "用地分区边界为粗略示意",
      "affected_metrics": [],
      "affected_layers": ["LAND_USE"]
    }
  ]
}
