{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "presence-contract.schema.json",
  "title": "JINGZHANG, PRESENT — Presence Contract 1.0",
  "description": "A public accountability contract for one bounded urban AI scenario. It does not record natural-person identity.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_id",
    "record_status",
    "scenario_id",
    "version",
    "public_purpose",
    "affected_publics",
    "data_boundary",
    "ai_role",
    "human_authority",
    "equivalent_service",
    "failure_path",
    "accountable_operator",
    "public_review",
    "rights_constraints",
    "notice"
  ],
  "properties": {
    "contract_id": {
      "type": "string",
      "pattern": "^PC-[A-Z0-9-]+$"
    },
    "record_status": {
      "enum": [
        "synthetic_example",
        "pre_pilot",
        "operational",
        "retired"
      ]
    },
    "scenario_id": {
      "type": "string",
      "pattern": "^(TV|CS)-[0-9]{2}$"
    },
    "version": {
      "type": "string"
    },
    "public_purpose": {
      "type": "string",
      "minLength": 10
    },
    "affected_publics": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "data_boundary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "allowed",
        "forbidden",
        "retention",
        "deletion_evidence"
      ],
      "properties": {
        "allowed": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "forbidden": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "retention": {
          "type": "string"
        },
        "deletion_evidence": {
          "type": "string"
        }
      }
    },
    "ai_role": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "allowed",
        "prohibited"
      ],
      "properties": {
        "allowed": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "prohibited": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        }
      }
    },
    "human_authority": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "accountable_role",
        "approve",
        "reject",
        "stop"
      ],
      "properties": {
        "accountable_role": {
          "type": "string"
        },
        "approve": {
          "type": "boolean"
        },
        "reject": {
          "type": "boolean"
        },
        "stop": {
          "type": "boolean"
        }
      }
    },
    "equivalent_service": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "channels",
        "service_level"
      ],
      "properties": {
        "channels": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "service_level": {
          "type": "string"
        }
      }
    },
    "failure_path": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "triggers",
        "fallback",
        "recovery_evidence"
      ],
      "properties": {
        "triggers": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "fallback": {
          "type": "string"
        },
        "recovery_evidence": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        }
      }
    },
    "accountable_operator": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "conceptual_role",
        "appeal_channel",
        "succession_required"
      ],
      "properties": {
        "conceptual_role": {
          "type": "string"
        },
        "appeal_channel": {
          "type": "string"
        },
        "succession_required": {
          "type": "boolean"
        }
      }
    },
    "public_review": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "metrics",
        "decision_due",
        "decision_options",
        "evidence_refs"
      ],
      "properties": {
        "metrics": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "decision_due": {
          "type": "string"
        },
        "decision_options": {
          "type": "array",
          "items": {
            "enum": [
              "Go",
              "Hold",
              "Repair",
              "Stop"
            ]
          }
        },
        "evidence_refs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "rights_constraints": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "accessible",
        "no_account_required",
        "no_worker_scoring",
        "non_discrimination_review"
      ],
      "properties": {
        "accessible": {
          "const": true
        },
        "no_account_required": {
          "const": true
        },
        "no_worker_scoring": {
          "const": true
        },
        "non_discrimination_review": {
          "const": true
        }
      }
    },
    "notice": {
      "type": "string",
      "minLength": 10
    }
  }
}
