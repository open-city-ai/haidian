# PDF streams can be valid ASCII85 text. Keep them out of textual diffs and
# whitespace checks so contributors receive feedback about source files only.
*.pdf binary

# Submission text files must use LF so SHA256 matches CI (Linux)
submissions/**/*.md text eol=lf
submissions/**/*.json text eol=lf
submissions/**/*.geojson text eol=lf
submissions/**/*.html text eol=lf
submissions/**/*.csv text eol=lf
*.geojson text eol=lf
