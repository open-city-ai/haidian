{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/haidian-ai/collection.schema.json",
  "title": "Haidian AI Proposal Collection",
  "type": "object",
  "required": ["version", "title", "summary", "items"],
  "properties": {
    "version": {
      "type": "integer",
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{2,63}$"
    },
    "title": {
      "type": "string",
      "minLength": 2,
      "maxLength": 120
    },
    "summary": {
      "type": "string",
      "minLength": 10,
      "maxLength": 360
    },
    "selection_reason": {
      "type": "string",
      "maxLength": 360
    },
    "badge": {
      "type": "string",
      "maxLength": 40
    },
    "items": {
      "type": "array",
      "minItems": 1,
      "maxItems": 12,
      "items": {
        "type": "object",
        "required": ["proposal", "reason"],
        "properties": {
          "proposal": {
            "type": "string",
            "pattern": "^(submissions/[A-Za-z0-9._-]+/[a-zA-Z0-9._-]+|examples/[a-zA-Z0-9._-]+)$"
          },
          "reason": {
            "type": "string",
            "minLength": 8,
            "maxLength": 280
          },
          "highlight": {
            "type": "string",
            "maxLength": 120
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
