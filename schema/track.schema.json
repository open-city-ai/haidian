{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/haidian-ai/track.schema.json",
  "title": "Haidian AI Proposal Track Registry",
  "type": "object",
  "required": ["version", "tracks"],
  "properties": {
    "version": {
      "type": "integer",
      "const": 1
    },
    "tracks": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "required": ["id", "title", "summary"],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]{2,63}$"
          },
          "title": {
            "type": "string",
            "minLength": 2,
            "maxLength": 80
          },
          "summary": {
            "type": "string",
            "minLength": 10,
            "maxLength": 240
          },
          "keywords": {
            "type": "array",
            "maxItems": 12,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 40
            }
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
