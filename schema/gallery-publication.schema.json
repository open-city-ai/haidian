{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/haidian-ai/gallery-publication.schema.json",
  "title": "Maintainer-controlled gallery publication registry",
  "type": "object",
  "required": ["version", "entries"],
  "properties": {
    "version": {"const": 1},
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["path", "published", "featured", "review_status", "quality_tier", "reviewed_by", "reviewed_at", "rights_reviewed", "reviewed_package_sha256", "selection_reason_zh", "selection_reason_en", "selected_at"],
        "properties": {
          "path": {"type": "string", "pattern": "^submissions/[A-Za-z0-9-]{1,39}/[a-z0-9][a-z0-9-]{2,63}$"},
          "published": {"type": "boolean"},
          "featured": {"type": "boolean"},
          "review_status": {"type": "string", "enum": ["approved_for_publication", "not_approved"]},
          "quality_tier": {"type": "string", "enum": ["qualified", "featured"]},
          "reviewed_by": {"type": "string", "pattern": "^[A-Za-z0-9-]{1,39}$"},
          "reviewed_at": {"type": "string", "format": "date"},
          "rights_reviewed": {"type": "boolean"},
          "reviewed_package_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "selection_reason_zh": {"type": "string", "minLength": 5},
          "selection_reason_en": {"type": "string", "minLength": 5},
          "selected_at": {"type": "string", "format": "date"}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
