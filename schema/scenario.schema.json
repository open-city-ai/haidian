{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/haidian-ai/scenario.schema.json",
  "title": "Haidian AI City Scenario Card",
  "type": "object",
  "required": [
    "version",
    "id",
    "title",
    "tracks",
    "users",
    "context",
    "data_inputs",
    "public_value",
    "risks",
    "human_review"
  ],
  "properties": {
    "version": {
      "type": "integer",
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{2,63}$"
    },
    "title": {
      "type": "string",
      "minLength": 2,
      "maxLength": 120
    },
    "tracks": {
      "type": "array",
      "minItems": 1,
      "maxItems": 3,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9][a-z0-9-]{2,63}$"
      }
    },
    "users": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 40
      }
    },
    "context": {
      "type": "string",
      "minLength": 10,
      "maxLength": 360
    },
    "data_inputs": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 80
      }
    },
    "public_value": {
      "type": "string",
      "minLength": 10,
      "maxLength": 360
    },
    "risks": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 120
      }
    },
    "human_review": {
      "type": "string",
      "minLength": 8,
      "maxLength": 360
    }
  },
  "additionalProperties": false
}
