{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/haidian-ai/exhibit.schema.json",
  "title": "Haidian AI Proposal Exhibit Contract",
  "type": "object",
  "required": ["version", "card"],
  "properties": {
    "version": {
      "type": "integer",
      "const": 1
    },
    "theme": {
      "type": "string",
      "enum": ["civic-lab", "planning-board", "innovation-belt"]
    },
    "card": {
      "type": "object",
      "required": ["title", "subtitle", "summary", "cover", "tags"],
      "properties": {
        "title": {
          "type": "string",
          "minLength": 2,
          "maxLength": 120
        },
        "subtitle": {
          "type": "string",
          "minLength": 4,
          "maxLength": 160
        },
        "summary": {
          "type": "string",
          "minLength": 20,
          "maxLength": 360
        },
        "cover": {
          "type": "string",
          "pattern": "^assets/.+\\.(png|jpg|jpeg|webp|gif)$"
        },
        "tags": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 40
          }
        },
        "tracks": {
          "type": "array",
          "minItems": 1,
          "maxItems": 3,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]{2,63}$"
          }
        },
        "scenarios": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]{2,63}$"
          }
        },
        "highlights": {
          "type": "array",
          "maxItems": 4,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          }
        },
        "status": {
          "type": "string",
          "enum": ["draft", "submitted", "under-review", "featured"]
        }
      },
      "additionalProperties": false
    },
    "hero": {
      "type": "object",
      "required": ["tagline"],
      "properties": {
        "eyebrow": {
          "type": "string",
          "maxLength": 80
        },
        "tagline": {
          "type": "string",
          "minLength": 8,
          "maxLength": 180
        },
        "image": {
          "type": "string",
          "pattern": "^assets/.+\\.(png|jpg|jpeg|webp|gif)$"
        },
        "caption": {
          "type": "string",
          "maxLength": 240
        }
      },
      "additionalProperties": false
    },
    "badges": {
      "type": "array",
      "maxItems": 8,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 40
      }
    },
    "modules": {
      "type": "array",
      "minItems": 0,
      "maxItems": 16,
      "items": {
        "type": "object",
        "required": ["type"],
        "properties": {
          "type": {
            "type": "string",
            "enum": [
              "executive_summary",
              "concept_cards",
              "spatial_strategy",
              "agent_workflow",
              "scenario_gallery",
              "timeline",
              "metrics",
              "risk_notes",
              "references"
            ]
          }
        },
        "additionalProperties": true
      }
    },
    "links": {
      "type": "object",
      "properties": {
        "proposal": {
          "type": "string",
          "const": "proposal.md"
        },
        "detail": {
          "type": "string",
          "maxLength": 120
        },
        "showcase": {
          "type": "string",
          "maxLength": 160
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
