{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/haidian-ai/proposal.schema.json",
  "title": "Haidian AI Proposal Markdown Contract",
  "type": "object",
  "required": [
    "metadata",
    "sections"
  ],
  "properties": {
    "metadata": {
      "type": "object",
      "required": [
        "title",
        "author_github",
        "language",
        "license",
        "summary"
      ],
      "properties": {
        "title": {
          "type": "string",
          "minLength": 2,
          "maxLength": 120
        },
        "author_github": {
          "type": "string",
          "pattern": "^[A-Za-z0-9-]{1,39}$"
        },
        "language": {
          "type": "string",
          "enum": [
            "zh",
            "en"
          ]
        },
        "proposal_format_version": {
          "type": "string",
          "enum": [
            "1",
            "2"
          ],
          "description": "Version 2 separates human-readable narrative citations from the complete machine-audit index. Missing values remain valid legacy version 1 submissions."
        },
        "translation_file": {
          "type": "string",
          "pattern": "^proposal\\.(zh|en)\\.md$",
          "description": "Required for version 2. Points to the complete Chinese or English translation of proposal.md."
        },
        "bilingual_contract_version": {
          "type": "string",
          "const": "1",
          "description": "Explicit opt-in for proposal format v2 to the blocking Chinese-English display contract. New scaffolds set this field; historical packages without it retain compatibility."
        },
        "translation_of": {
          "type": "string",
          "const": "proposal.md",
          "description": "Used by proposal.zh.md or proposal.en.md to identify the primary proposal."
        },
        "title_zh": {
          "type": "string",
          "minLength": 2,
          "maxLength": 120,
          "description": "Legacy compatibility field for older inline bilingual proposals; standalone translation metadata is preferred."
        },
        "summary_zh": {
          "type": "string",
          "minLength": 10,
          "maxLength": 500,
          "description": "Legacy compatibility field for older inline bilingual proposals; standalone translation metadata is preferred."
        },
        "license": {
          "type": "string",
          "enum": [
            "COMMUNITY-DISPLAY-ONLY",
            "CC-BY-4.0",
            "CC-BY-SA-4.0"
          ]
        },
        "summary": {
          "type": "string",
          "minLength": 10,
          "maxLength": 500
        },
        "tracks": {
          "type": "array",
          "minItems": 1,
          "maxItems": 3,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]{2,63}$"
          }
        },
        "scenarios": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]{2,63}$"
          }
        },
        "iteration": {
          "type": "string",
          "pattern": "^v?\\d+(\\.\\d+){0,2}([-+][A-Za-z0-9.-]+)?$"
        },
        "version": {
          "type": "string",
          "pattern": "^v?\\d+(\\.\\d+){0,2}([-+][A-Za-z0-9.-]+)?$"
        }
      },
      "additionalProperties": true
    },
    "sections": {
      "type": "array",
      "minItems": 13
    },
    "assets": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^assets/.+\\.(svg|png|jpg|jpeg|webp|gif)$"
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "metadata": {
            "properties": {
              "proposal_format_version": {"const": "2"},
              "bilingual_contract_version": {"const": "1"}
            },
            "required": ["proposal_format_version", "bilingual_contract_version"]
          }
        }
      },
      "then": {
        "properties": {
          "metadata": {"required": ["translation_file"]}
        }
      }
    },
    {
      "if": {
        "properties": {
          "metadata": {
            "properties": {"language": {"const": "zh"}},
            "required": ["language"]
          }
        }
      },
      "then": {
        "properties": {
          "sections": {"contains": {"const": "设计依据与资料清单"}}
        }
      }
    },
    {
      "if": {
        "properties": {
          "metadata": {
            "properties": {"language": {"const": "en"}},
            "required": ["language"]
          }
        }
      },
      "then": {
        "properties": {
          "sections": {"contains": {"const": "Design Basis and Source List"}}
        }
      }
    }
  ]
}
