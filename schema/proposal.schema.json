{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/haidian-ai/proposal.schema.json",
  "title": "Haidian AI Proposal Markdown Contract",
  "type": "object",
  "required": [
    "metadata",
    "sections"
  ],
  "properties": {
    "metadata": {
      "type": "object",
      "required": [
        "title",
        "author_github",
        "language",
        "license",
        "summary"
      ],
      "properties": {
        "title": {
          "type": "string",
          "minLength": 2,
          "maxLength": 120
        },
        "author_github": {
          "type": "string",
          "pattern": "^[A-Za-z0-9-]{1,39}$"
        },
        "language": {
          "type": "string",
          "enum": [
            "zh",
            "en",
            "bilingual"
          ]
        },
        "license": {
          "type": "string",
          "enum": [
            "CC-BY-4.0",
            "CC-BY-SA-4.0"
          ]
        },
        "summary": {
          "type": "string",
          "minLength": 10,
          "maxLength": 500
        },
        "iteration": {
          "type": "string",
          "pattern": "^v?\\d+(\\.\\d+){0,2}([-+][A-Za-z0-9.-]+)?$"
        },
        "version": {
          "type": "string",
          "pattern": "^v?\\d+(\\.\\d+){0,2}([-+][A-Za-z0-9.-]+)?$"
        }
      },
      "additionalProperties": true
    },
    "sections": {
      "type": "array",
      "contains": {
        "const": "摘要"
      },
      "minItems": 8
    },
    "assets": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^assets/.+\\.(png|jpg|jpeg|webp|gif)$"
      }
    }
  }
}
