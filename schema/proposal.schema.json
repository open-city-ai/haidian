{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/haidian-ai/proposal.schema.json",
  "title": "Haidian AI Proposal Markdown Contract",
  "type": "object",
  "required": [
    "metadata",
    "sections"
  ],
  "properties": {
    "metadata": {
      "type": "object",
      "required": [
        "title",
        "author_github",
        "language",
        "license",
        "summary"
      ],
      "properties": {
        "title": {
          "type": "string",
          "minLength": 2,
          "maxLength": 120
        },
        "author_github": {
          "type": "string",
          "pattern": "^[A-Za-z0-9-]{1,39}$"
        },
        "language": {
          "type": "string",
          "enum": [
            "zh",
            "en"
          ]
        },
        "chinese_translation": {
          "type": "string",
          "enum": [
            "included"
          ],
          "description": "Required when language=en; full English content must be followed by the complete Chinese translation under a top-level # 中文正式译文 heading in proposal.md."
        },
        "title_zh": {
          "type": "string",
          "minLength": 2,
          "maxLength": 120,
          "description": "Required when language=en."
        },
        "summary_zh": {
          "type": "string",
          "minLength": 10,
          "maxLength": 500,
          "description": "Required when language=en."
        },
        "license": {
          "type": "string",
          "enum": [
            "COMMUNITY-DISPLAY-ONLY",
            "CC-BY-4.0",
            "CC-BY-SA-4.0"
          ]
        },
        "summary": {
          "type": "string",
          "minLength": 10,
          "maxLength": 500
        },
        "tracks": {
          "type": "array",
          "minItems": 1,
          "maxItems": 3,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]{2,63}$"
          }
        },
        "scenarios": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]{2,63}$"
          }
        },
        "iteration": {
          "type": "string",
          "pattern": "^v?\\d+(\\.\\d+){0,2}([-+][A-Za-z0-9.-]+)?$"
        },
        "version": {
          "type": "string",
          "pattern": "^v?\\d+(\\.\\d+){0,2}([-+][A-Za-z0-9.-]+)?$"
        }
      },
      "additionalProperties": true
    },
    "sections": {
      "type": "array",
      "contains": {
        "const": "设计依据与资料清单"
      },
      "minItems": 13
    },
    "assets": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^assets/.+\\.(svg|png|jpg|jpeg|webp|gif)$"
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "metadata": {
            "properties": {"language": {"const": "en"}},
            "required": ["language"]
          }
        }
      },
      "then": {
        "properties": {
          "metadata": {
            "required": ["chinese_translation", "title_zh", "summary_zh"]
          }
        }
      }
    }
  ]
}
