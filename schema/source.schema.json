{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/haidian-ai/source.schema.json",
  "title": "Haidian AI Public Source Index",
  "type": "object",
  "required": ["version", "sources"],
  "properties": {
    "version": {
      "type": "integer",
      "const": 1
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "title",
          "type",
          "publisher",
          "published_at",
          "public_status",
          "citation",
          "usage_note",
          "risk_note"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]{2,63}$"
          },
          "title": {
            "type": "string",
            "minLength": 2,
            "maxLength": 160
          },
          "type": {
            "type": "string",
            "enum": [
              "brief",
              "boundary",
              "policy",
              "map",
              "culture",
              "industry",
              "news",
              "other"
            ]
          },
          "path": {
            "type": "string",
            "pattern": "^[^/].+"
          },
          "url": {
            "type": "string",
            "pattern": "^https://.+"
          },
          "publisher": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "published_at": {
            "type": "string",
            "minLength": 3,
            "maxLength": 40
          },
          "public_status": {
            "type": "string",
            "enum": ["confirmed-public", "public-draft", "external-public"]
          },
          "citation": {
            "type": "string",
            "minLength": 1,
            "maxLength": 220
          },
          "usage_note": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          },
          "risk_note": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          }
        },
        "anyOf": [
          {
            "required": ["path"]
          },
          {
            "required": ["url"]
          }
        ],
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
