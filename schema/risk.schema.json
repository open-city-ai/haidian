{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/haidian-ai/risk.schema.json",
  "title": "Haidian AI Proposal Risk Matrix",
  "type": "object",
  "required": ["version", "dimensions"],
  "properties": {
    "version": {
      "type": "integer",
      "const": 1
    },
    "summary": {
      "type": "string",
      "maxLength": 360
    },
    "dimensions": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": {
        "type": "object",
        "required": ["id", "label", "score", "note", "mitigation"],
        "properties": {
          "id": {
            "type": "string",
            "enum": [
              "data_privacy",
              "implementation_complexity",
              "public_acceptance",
              "operations_cost",
              "policy_uncertainty",
              "spatial_dispute",
              "technology_maturity",
              "equity_inclusion"
            ]
          },
          "label": {
            "type": "string",
            "minLength": 2,
            "maxLength": 40
          },
          "score": {
            "type": "integer",
            "minimum": 1,
            "maximum": 5
          },
          "note": {
            "type": "string",
            "minLength": 8,
            "maxLength": 240
          },
          "mitigation": {
            "type": "string",
            "minLength": 8,
            "maxLength": 240
          },
          "human_review": {
            "type": "string",
            "maxLength": 240
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
