{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/haidian-ai/spatial.schema.json",
  "title": "Haidian AI Concept Spatial Notes",
  "type": "object",
  "required": ["version", "disclaimer", "items"],
  "properties": {
    "version": {
      "type": "integer",
      "const": 1
    },
    "disclaimer": {
      "type": "string",
      "const": "concept-only"
    },
    "summary": {
      "type": "string",
      "maxLength": 360
    },
    "items": {
      "type": "array",
      "minItems": 1,
      "maxItems": 24,
      "items": {
        "type": "object",
        "required": ["id", "type", "title", "summary", "source", "public_level", "geometry"],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]{2,63}$"
          },
          "type": {
            "type": "string",
            "enum": ["node", "corridor", "area"]
          },
          "title": {
            "type": "string",
            "minLength": 2,
            "maxLength": 80
          },
          "summary": {
            "type": "string",
            "minLength": 8,
            "maxLength": 240
          },
          "source": {
            "type": "string",
            "minLength": 2,
            "maxLength": 160
          },
          "public_level": {
            "type": "string",
            "enum": ["public", "cleared", "provisional"]
          },
          "linked_scenarios": {
            "type": "array",
            "maxItems": 8,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^[a-z0-9][a-z0-9-]{2,63}$"
            }
          },
          "order": {
            "type": "integer",
            "minimum": 1,
            "maximum": 99
          },
          "geometry": {
            "type": "object",
            "required": ["mode", "label"],
            "properties": {
              "mode": {
                "type": "string",
                "const": "concept"
              },
              "label": {
                "type": "string",
                "minLength": 2,
                "maxLength": 120
              }
            },
            "additionalProperties": false
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
